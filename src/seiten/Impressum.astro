---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Luecke from "../components/Luecke.astro";
import { type Lang } from "../i18n";
import { t } from "../texte";
import { NAME, TELEFON, MAIL } from "../daten";
// Struktur nach § 5 DDG. Betreiberangaben von Kerim über Jamil (Talk xidc8qvq #7195, 24.11.2026): Anschrift, Berufsbezeichnung,
// verleihendes Gericht + Rechtsgrundlagen, Kleinunternehmer § 19 UStG, Streitbeilegung. Rechtstexte bleiben Deutsch (bindend), auch auf /tr/.
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
---
<Basis lang={lang} seite="impressum" titel={T.meta.impressum.titel} beschreibung={T.meta.impressum.beschreibung} aufruf={false}>
  <SeitenKopf titel={lang === "tr" ? "Künye (Impressum)" : "Impressum"}>{lang === "tr" && <p class="lead">{T.seiten.recht.hinweisTr}</p>}</SeitenKopf>
  <section class="abschnitt recht" lang="de">
    <div class="huelle">
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>{NAME}<br />Beethovenstraße 51a<br />22083 Hamburg</p>

      <h2>Kontakt</h2>
      <p>Telefon: {TELEFON}<br />E-Mail: <a href={`mailto:${MAIL}`}>{MAIL}</a></p>

      <h2>Berufsrechtliche Angaben</h2>
      <p>Berufsbezeichnung: Allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für die türkische und deutsche Sprache<br />
      Verliehen durch: Schleswig-Holsteinisches Oberlandesgericht, Gottorfstraße 2, 24837 Schleswig<br />
      Verliehen in: Bundesrepublik Deutschland<br />
      Rechtsgrundlage: Ermächtigung gemäß § 74 Absatz 1 des Landesjustizgesetzes; Beeidigung und Verpflichtung gemäß § 78 des Landesjustizgesetzes, § 1 des Verpflichtungsgesetzes und § 189 des Gerichtsverfassungsgesetzes in Verbindung mit § 91 Absatz 2 des Ausführungsgesetzes zum Gerichtsverfassungsgesetz.<br />
      Beeidigung und Ermächtigung am 04.05.2021.</p>

      <h2>Umsatzsteuer</h2>
      <p>Als Kleinunternehmer im Sinne von § 19 UStG wird keine Umsatzsteuer berechnet.</p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>Zur Teilnahme an einem Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle bin ich nicht verpflichtet und nicht bereit.</p>

      <p class="leise">Stand: <Luecke>Datum beim Livegang</Luecke></p>
    </div>
  </section>
</Basis>
