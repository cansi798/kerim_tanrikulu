---
// Themen (neu in v4, Can 31.10.2026): typische Dokumente in beide Richtungen (TR→DE, DE→TR).
// Allgemeine Übersicht, KEIN Versprechen, dass Herr Tanrikulu jede Art übernimmt. Seine eigenen Beispiele von der bisherigen
// Website stehen wörtlich im Kasten „Laut Herrn Tanrikulu“ (goldener Rahmen) und sind in den Listen mit Häkchen und fett markiert (v5, Jamil 3957: keine Unterstreichungen).
// Themenliste von Kerim bestätigen/kürzen lassen (OFFENE-INFOS).
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Richtung from "../components/Richtung.astro";
import Icon from "../components/Icon.astro";
import { mailLink, TELEFON_LINK, WHATSAPP_LINK } from "../daten";
import { p, type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const anderer = lang === "de" ? "tr" : "de";
const richtungen = [
  { id: "tr-de", ...T.themen.trde },
  { id: "de-tr", ...T.themen.detr },
];
---
<Basis lang={lang} seite="themen" titel={T.meta.themen.titel} beschreibung={T.meta.themen.beschreibung}>
  <SeitenKopf titel={T.themen.titel} zeile={T.themen.eyebrow}>
    <p class="lead">{T.themen.text}</p>
    <div slot="bild" class="kopf-bild" data-szene aria-hidden="true">
      <span class="ufer-k">TR</span>
      <svg class="kopf-pfeil" viewBox="0 0 170 34" focusable="false"><path d="M8 17H160 M149 9.5 160 17l-11 7.5" /></svg>
      <span class="ufer-k">DE</span>
    </div>
  </SeitenKopf>

  <section class="abschnitt" aria-labelledby="laut-titel">
    <div class="huelle">
      <figure class="laut" data-szene>
        <h2 id="laut-titel" class="laut-kopf">{T.themen.laut}</h2>
        <blockquote><p>„{T.fakten.dokumenteSatz}“</p></blockquote>
        <ul class="laut-liste">
          {T.fakten.dokumente.map((d) => <li><Icon name={d.icon as any} />{d.text}</li>)}
        </ul>
      </figure>
      <nav class="sprung" aria-label={T.themen.titel}>
        {richtungen.map((r) => <a href={`#${r.id}`}><Richtung text={r.kopf} /></a>)}
      </nav>
    </div>
  </section>

  {richtungen.map((r, ri) => (
    <section class:list={["abschnitt", ri === 0 ? "weiss" : "sand"]} id={r.id} aria-labelledby={`${r.id}-titel`}>
      <div class="huelle">
        <div class="section-head reveal">
          <span class="eyebrow"><Richtung text={r.kopf} /></span>
          <h2 id={`${r.id}-titel`} class="regel">{r.titel}</h2>
        </div>
        <div class="gruppen">
          {r.gruppen.map((g, gi) => (
            <article class="gruppe reveal">
              <h3>{g.titel}</h3>
              <ul data-szene>
                {g.eintraege.map((e, i) => (
                  <li>
                    {e.kerim ? <span class="kerim"><Icon name="haken" />{e.text}</span> : <span>{e.text}</span>}
                    <span class="zweit" lang={anderer}>{e.tr}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="abschnitt" aria-label={T.ui.rechtHinweis}>
    <div class="huelle schmal">
      <p class="legende"><span class="legende-zeichen" aria-hidden="true"><Icon name="haken" /></span>{T.themen.legende}</p>
      <p class="hinweis"><Icon name="frage" />{T.ui.rechtHinweis}</p>
      <p class="lead">{T.themen.hinweisAnfrage}</p>
      <div class="knoepfe">
        <a class="knopf" href={mailLink(T.ui.anfrageBetreffUe)}>{T.ui.anfrage}</a>
        <a class="knopf rahmen" href={TELEFON_LINK}><Icon name="telefon" />{T.ui.anrufen}</a>
        <a class="knopf rahmen" href={WHATSAPP_LINK} rel="noopener"><Icon name="whatsapp" />{T.ui.whatsapp}</a>
        <a class="weiter" href={p(lang, "ratgeber")}>{T.ratgeber.teaserLink}</a>
      </div>
    </div>
  </section>
</Basis>
<style>
  .kopf-bild { display: flex; align-items: center; justify-content: center; gap: 1rem; padding-block: 1rem; }
  .ufer-k { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 50%; border: 1px solid var(--deko); background: var(--creme); font: 600 1.35rem/1 var(--serif); color: var(--tinte); }
  .kopf-pfeil { position: relative; width: 10rem; height: 34px; }
  .kopf-pfeil { fill: none; stroke: var(--deko); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; overflow: visible; }

  .laut { position: relative; margin: 0 auto; max-width: 56rem; padding: clamp(1.75rem, 4vw, 2.75rem); background: var(--weiss); border-radius: 6px; }
  .laut { border: 1px solid var(--deko); border-radius: 16px; }
  .laut-kopf { font-size: clamp(1.4rem, 2.4vw, 1.75rem); margin-bottom: 0.75rem; }
  .laut blockquote { margin: 0 0 1.5rem; }
  .laut blockquote p { margin: 0; font: italic 500 clamp(1.15rem, 2vw, 1.35rem)/1.55 var(--serif); color: var(--tinte); }
  .laut-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .laut-liste li { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.9rem; border: 1px solid var(--linie); border-radius: 999px; background: var(--buetten); font-size: 0.98rem; }
  .laut-liste :global(svg) { width: 1.15rem; height: 1.15rem; color: var(--primaer-leise); }
  .sprung { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 2.5rem; }
  .sprung a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0.5rem 1.25rem; border: 1px solid var(--deko); border-radius: 999px; color: var(--tinte); text-decoration: none; font-weight: 600; }
  .sprung a:hover { background: var(--tinte); color: var(--weiss); }

  .sand { background: var(--sand); }
  .gruppen { display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .gruppen { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .gruppe { background: var(--weiss); border: 1px solid var(--linie); border-radius: 16px; padding: clamp(1.4rem, 3vw, 1.9rem); }
  .sand .gruppe { border-color: var(--tinte-3); }
  .gruppe h3 { font-size: 1.25rem; margin-bottom: 0.5rem; } /* ohne Unterstrich (v5, Jamil 3957) */
  .gruppe ul { list-style: none; margin: 0; padding: 0; }
  .gruppe li { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--linie); font-weight: 500; }
  .gruppe li:last-child { border-bottom: 0; }
  .kerim { display: inline-flex; align-items: flex-start; gap: 0.45rem; font-weight: 600; }
  .kerim :global(svg) { width: 1.1rem; height: 1.1rem; flex: none; margin-top: 0.3em; color: var(--primaer-leise); }
  .zweit { font-size: 0.9rem; color: var(--text-leise); font-weight: 400; }
  .gruppen > :global(.reveal:nth-child(2)) { transition-delay: 120ms; }
  .gruppen > :global(.reveal:nth-child(3)) { transition-delay: 220ms; }
  .gruppen > :global(.reveal:nth-child(4)) { transition-delay: 320ms; }

  .legende { display: flex; align-items: center; gap: 0.75rem; color: var(--text-leise); font-size: 0.95rem; }
  .legende-zeichen { display: grid; place-items: center; flex: none; color: var(--primaer-leise); }
  .legende-zeichen :global(svg) { width: 1.2rem; height: 1.2rem; }
  .hinweis { display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.95rem; color: var(--text-leise); }
  .hinweis :global(svg) { width: 1.2rem; height: 1.2rem; flex: none; margin-top: 0.2rem; color: var(--primaer-leise); }
  .knoepfe { align-items: center; gap: 0.85rem 1.25rem; }
</style>
