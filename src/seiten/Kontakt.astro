---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Platzhalter from "../components/Platzhalter.astro";
import Luecke from "../components/Luecke.astro";
import Icon from "../components/Icon.astro";
import Anfrage from "../components/Anfrage.astro";
import { TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, MAIL, WHATSAPP_LINK, mailLink } from "../daten";
import type { Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const S = T.seiten.kontakt;
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
// Anfrageformular nur auf der deutschen Seite (Jamil Talk xidc8qvq #5217, 09.11.2026). /tr/iletisim/ bleibt vorerst unverändert,
// bis Kerim die Dokumentnamen und die türkischen Texte geprüft hat.
const mitFormular = lang === "de";
---
<Basis lang={lang} seite="kontakt" titel={T.meta.kontakt.titel} beschreibung={T.meta.kontakt.beschreibung} aufruf={false}>
  <SeitenKopf titel={T.nav.kontakt}>
    <p class="lead">{S.lead}</p>
  </SeitenKopf>

  {mitFormular && (
    <section class="abschnitt anfrage-abschnitt" aria-labelledby="anfrage-titel">
      <div class="huelle">
        <div class="anfrage-kopf">
          <h2 id="anfrage-titel">Anfrage stellen</h2>
          <p>In wenigen Schritten zu Ihrer Anfrage. Ihre Angaben gehen erst an Herrn Tanrikulu, wenn Sie sie am Ende selbst absenden.</p>
          <p><a class="weiter" href="#direkt">Lieber direkt: Telefon, WhatsApp oder E-Mail</a></p>
        </div>
        <Anfrage />
      </div>
    </section>
  )}

  <section class:list={["abschnitt", { "auf-creme": mitFormular }]} id="direkt" aria-label={mitFormular ? undefined : S.wegeLabel} aria-labelledby={mitFormular ? "direkt-titel" : undefined}>
    <div class="huelle">
      {mitFormular && <h2 id="direkt-titel" class="direkt-titel">Lieber direkt sprechen oder schreiben?</h2>}
      <ul class="wege" data-szene>
        <li class="w0">
          <a href={TELEFON_LINK}>
            <span class="symbol"><Icon name="telefon" /></span>
            <span class="art">{T.ui.anrufen}</span>
            <span class:list={["wert", { unbestaetigt: markieren }]}>{TELEFON}</span>
            {markieren && <span class="hinweis"><Luecke>{T.ui.telefonLuecke}</Luecke></span>}
          </a>
        </li>
        <li class="w1">
          <a href={WHATSAPP_LINK} rel="noopener">
            <span class="symbol"><Icon name="whatsapp" /></span>
            <span class="art">{T.ui.whatsappLang}</span>
            <span class="wert">{T.ui.whatsapp}</span>
          </a>
        </li>
        <li class="w2">
          <a href={mailLink(T.ui.mailBetreff)}>
            <span class="symbol"><Icon name="mail" /></span>
            <span class="art">{T.ui.mailSchreiben}</span>
            <span class="wert">{MAIL}</span>
          </a>
        </li>
        <li class="w3">
          <div>
            <span class="symbol"><Icon name="ort" /></span>
            <span class="art">{T.ui.standort}</span>
            <span class="wert">{T.fakten.ort}</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="abschnitt weiss" aria-label={S.hinweisLabel}>
    <div class="huelle">
      <p class="lead schluss">{S.schluss}</p>
      {!mitFormular && <Platzhalter lang={lang}>{S.platzhalter}</Platzhalter>}
    </div>
  </section>
</Basis>
<style>
  .wege { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 40rem) { .wege { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .wege { grid-template-columns: 1fr 0.85fr 1.4fr 0.8fr; gap: 1.25rem; } .wert { font-size: clamp(1.2rem, 1.6vw, 1.4rem) !important; } }
  .wege a, .wege div {
    display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 4px; text-decoration: none; color: var(--text); background: var(--sand); border: 1px solid var(--tinte-3);
  }
  .wege a { transition: transform 0.35s var(--sanft), box-shadow 0.35s var(--sanft); }
  .wege a:hover { transform: translateY(-3px); box-shadow: 0 22px 36px -26px rgba(29, 49, 90, 0.4); border-color: var(--akzent); }
  .wege .w3 div { background: var(--weiss); color: var(--tinte); border: 1px solid var(--linie); }
  .symbol { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; border: 1px solid var(--akzent); background: var(--akzent); color: var(--primaer); margin-bottom: 1rem; }
  /* Gold nur an den Kontaktwegen (Conversion, Jamil 06.11.2026); Standort ist kein Kontaktweg → ohne Gold */
  .w3 .symbol { background: transparent; color: var(--primaer-leise); border-color: var(--deko); }
  .symbol :global(svg) { width: 1.5rem; height: 1.5rem; }
  .art { font-size: 0.95rem; color: var(--hell-leise); }
  .w3 .art { color: var(--text-leise); }
  .wert { font: 500 clamp(1.3rem, 2.2vw, 1.6rem)/1.3 var(--sans); overflow-wrap: anywhere; }
  .hinweis { margin-top: 0.5rem; font-size: 0.85rem; }
  .wege li { animation: auftauchen 0.45s var(--sanft) both; }
  .wege .w1 { animation-delay: 0.12s; }
  .wege .w2 { animation-delay: 0.24s; }
  .wege .w3 { animation-delay: 0.36s; }
  .schluss { margin: 0; max-width: 46rem; }
  .anfrage-kopf { max-width: 52rem; margin: 0 auto clamp(1.5rem, 4vw, 2.25rem); }
  .anfrage-kopf p { color: var(--text-leise); margin-bottom: 0.6rem; }
  .direkt-titel { margin-bottom: clamp(1.5rem, 4vw, 2.25rem); }
  /* Mit Formular liegen die Kontaktwege auf Creme: Karten weiß, damit sie sich abheben */
  .auf-creme .wege a { background: var(--weiss); }
</style>
