---
// Startseite v4 (Can 31.10.2026): durchgehend animierte Landingpage im Bauwelt-Aufbau (Jamil Talk 3910),
// Hero-Inhalte aus Talk 3907, Fakten nur von der bisherigen Website (Talk 3904), dazu allgemeines Ratgeber-Wissen.
// Erzählung: Anliegen (Hero) → Qualifikation (Band) → zwei Richtungen (Scroll-Story) → Leistungen → was ihn auszeichnet
// → typische Dokumente → Ratgeber → Fragen → Kontakt.
// Bewegung: Bauwelt-Kurve, gestaffelt, einmal; Scroll-Story und Parallaxe nur breit und ohne „Bewegung reduzieren“;
// Tinten-Notizen (rough.js beim Bauen) an genau vier Stellen.
// Signature (Can 31.10.2026 „Wow“): Sprachbrücke aus Licht im Hero (public/licht.js, Canvas 2D) – Sinnbild Übersetzen.
// Can 31.10. 08:45: Brücke, Karten und Scroll-Hinweis starten erst, wenn sie im Bild sind (data-szene; am Handy liegen sie unter dem ersten Bildschirm).
import Basis from "../layouts/Basis.astro";
import Icon from "../components/Icon.astro";
import Vertrauensband from "../components/Vertrauensband.astro";
import BildUebersetzung from "../components/BildUebersetzung.astro";
import BildDolmetschen from "../components/BildDolmetschen.astro";
import Tinte from "../components/Tinte.astro";
import Markiert from "../components/Markiert.astro";
import Richtung from "../components/Richtung.astro";
import { mailLink, TELEFON_LINK } from "../daten";
import { p, type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const KIEL = "M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z";
const fragenStart = T.fragen.liste.slice(0, 3);
const flach = (g: typeof T.themen.trde.gruppen) => g.flatMap((x) => x.eintraege);
const themenSpalten = [
  { ...T.themen.trde, eintraege: flach(T.themen.trde.gruppen).slice(0, 6) },
  { ...T.themen.detr, eintraege: flach(T.themen.detr.gruppen).slice(0, 6) },
];
const ratgeberAuswahl = [0, 1, 3].map((i) => T.ratgeber.kapitel[i]);
// Sprachbrücke: Bogen (Kubik-Kurve), feiner Innenbogen, Hänger senkrecht vom Bogen zur Fahrbahn, gedämpfte Spiegelung im Wasser
const BOGEN = "M20 150 C 110 18, 330 18, 420 150";
const BOGEN_INNEN = "M44 150 C 126 40, 314 40, 396 150";
const SPIEGEL = "M20 150 C 110 205, 330 205, 420 150";
const bez = (a: number, b: number, c: number, d: number, t: number) => (1 - t) ** 3 * a + 3 * t * (1 - t) ** 2 * b + 3 * t * t * (1 - t) * c + t ** 3 * d;
const HAENGER = Array.from({ length: 13 }, (_, i) => {
  const x = 70 + i * 25;
  let lo = 0, hi = 1;
  for (let k = 0; k < 40; k++) { const m = (lo + hi) / 2; if (bez(20, 110, 330, 420, m) < x) lo = m; else hi = m; }
  return { x, y: Math.round(bez(150, 18, 18, 150, lo) * 10) / 10 };
});
---
<Basis lang={lang} seite="start">
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero-bg" aria-hidden="true" data-parallax="0.06">
      <svg class="kiel-gross" viewBox="0 0 58 66" focusable="false"><path d={KIEL} /></svg>
    </div>
    <div class="huelle hero-inhalt">
      <div class="text">
        <p class="badge auf" data-d="0"><Icon name="schild" /><span>{T.hero.badge}</span></p>
        <h1 id="hero-titel" class="auf" data-d="1">{T.hero.h1}</h1>
        <p class="sub auf" data-d="2">{T.hero.sub}</p>
        <div class="knoepfe auf" data-d="3">
          <a class="knopf haupt" href={mailLink(T.ui.anfrageBetreff)}>{T.ui.anfrage}</a>
          <a class="knopf rahmen" href={TELEFON_LINK}><Icon name="telefon" />{T.ui.anrufen}</a>
        </div>
        <ul class="vertrauen auf" data-d="4" aria-label={T.ui.aufEinenBlick}>
          {T.hero.vertrauen.map((v) => <li><Icon name="haken" />{v}</li>)}
        </ul>
      </div>

      <!-- Sprachbrücke = Signature-Animation (Can 31.10.2026 „viel krasser, Wow“): Sinnbild Übersetzen.
           licht.js (Canvas 2D, nur mit JS und ohne „Bewegung reduzieren“): Ufer leuchten auf, der Bogen wächst aus Licht von beiden
           Seiten bis zur Mitte, Hänger und Spiegelung erscheinen, dann lösen sich Lichtteilchen aus dem Wort links, wandern über die Brücke
           und setzen sich rechts zum Wort der anderen Sprache zusammen (ca. 3,5 s). Danach alle 14 s die ganze Intro erneut und jedes Mal beim Wiederkommen ins Bild.
           Ohne JS bzw. ruhig: genau dieses SVG als fertiges Endbild; die Wörter sind echter Text. -->
      <div class="bruecke-ebene" data-parallax="-0.035" data-szene>
        <figure class="bruecke auf" data-d="2" data-bruecke>
          <svg viewBox="0 0 440 200" aria-hidden="true" focusable="false">
            <g class="b-teil">
              <path class="spiegel" d={SPIEGEL} />
              <path class="deck" d="M20 150 H420" />
              <g class="haenger">{HAENGER.map((h) => <line x1={h.x} y1={h.y} x2={h.x} y2="150" />)}</g>
              <path class="bogen-innen" d={BOGEN_INNEN} />
              <path class="bogen" d={BOGEN} />
              <circle class="ende" cx="20" cy="150" r="4.5" /><circle class="ende" cx="420" cy="150" r="4.5" />
            </g>
          </svg>
          <div class="ufer"><span class="b-quelle">{T.ui.deutsch}</span><span class="b-ziel">{T.ui.tuerkisch}</span></div>
          <figcaption class="claim"><Markiert art="strich" seed={11} v={0} dauer="mittel" szene={false}>{T.fakten.claim}.</Markiert></figcaption>
        </figure>
      </div>
    </div>

    <div class="huelle">
      <ul class="karten" data-szene>
        <li class="k0"><a href={p(lang, "uebersetzungen")}><span class="symbol"><Icon name="dokument" /></span><span class="titel">{T.hero.karten[0]}</span><Icon name="pfeil" /></a></li>
        <li class="k1"><a href={p(lang, "dolmetschen")}><span class="symbol"><Icon name="mikrofon" /></span><span class="titel">{T.hero.karten[1]}</span><Icon name="pfeil" /></a></li>
        <li class="k2"><a href={p(lang, "themen")}>
          <span class="symbol sprachen" aria-hidden="true"><svg viewBox="0 0 44 24" focusable="false"><text x="0" y="16.5">DE</text><path d="M18.5 9.5h7m-2-2.5 2.5 2.5-2.5 2.5M25.5 14.5h-7m2-2.5-2.5 2.5 2.5 2.5" /><text x="28.5" y="16.5">TR</text></svg></span>
          <span class="titel">{T.hero.karten[2]}</span><Icon name="pfeil" /></a></li>
      </ul>
      <a class="mehr" href="#weiter" data-szene><span>{T.ui.mehrErfahren}</span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg></a>
    </div>
  </section>

  <div id="weiter"></div>
  <Vertrauensband lang={lang} />

  <!-- Zwei Richtungen: Scroll-Story. Breit: Bühne bleibt stehen, die zwei Blätter gleiten beim Scrollen zur Mitte,
       dann zieht sich der goldene Doppelpfeil (rough.js). Schmal, ohne JS oder ruhig: fertiges Bild. -->
  <section class="richtungen" data-verlauf aria-labelledby="ri-titel">
    <div class="buehne">
      <div class="huelle">
        <div class="section-head reveal">
          <span class="eyebrow">{T.richtungen.eyebrow}</span>
          <h2 id="ri-titel" class="regel">{T.richtungen.titel}</h2>
          <p>{T.richtungen.text}</p>
        </div>
        <div class="ri-raster">
          <article class="ri-blatt ri-links">
            <p class="ri-kopf"><Richtung text={T.richtungen.links.kopf} /></p>
            <h3>{T.richtungen.links.titel}</h3>
            <ul class="strichliste">{T.richtungen.links.beispiele.map((b) => <li>{b}</li>)}</ul>
          </article>
          <div class="ri-mitte" data-szene data-ab="0.42" role="img" aria-label={T.richtungen.pfeil}>
            <span class="ri-kreis">TR</span>
            <span class="ri-pfeil"><Tinte art="pfeil" farbe="gold" b={150} h={30} seed={21} staerke={1.8} dauer="lang" /></span>
            <span class="ri-kreis">DE</span>
          </div>
          <article class="ri-blatt ri-rechts">
            <p class="ri-kopf"><Richtung text={T.richtungen.rechts.kopf} /></p>
            <h3>{T.richtungen.rechts.titel}</h3>
            <ul class="strichliste">{T.richtungen.rechts.beispiele.map((b) => <li>{b}</li>)}</ul>
          </article>
        </div>
        <p class="ri-link reveal"><a class="weiter" href={p(lang, "themen")}>{T.richtungen.link}</a></p>
      </div>
    </div>
  </section>

  <section class="abschnitt weiss" id="leistungen" aria-labelledby="leistungen-titel">
    <div class="huelle">
      <div class="section-head reveal">
        <span class="eyebrow">{T.leistungen.eyebrow}</span>
        <h2 id="leistungen-titel" class="regel">{T.leistungen.titel}</h2>
        <p>{T.leistungen.text}</p>
      </div>
      <div class="leistungen staffel">
        <article class="karte leistung reveal">
          <BildUebersetzung lang={lang} />
          <h3>{T.leistungen.ueTitel}</h3>
          <p>{T.leistungen.ueText}</p>
          <a class="weiter" href={p(lang, "uebersetzungen")}>{T.leistungen.ueLink}</a>
        </article>
        <article class="karte leistung reveal">
          <BildDolmetschen lang={lang} />
          <h3>{T.leistungen.doTitel}</h3>
          <p>{T.fakten.freude}</p>
          <a class="weiter" href={p(lang, "dolmetschen")}>{T.leistungen.doLink}</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Was ihn auszeichnet: nur belegte Fakten. Zahlen zählen einmal hoch, die zwei Nachweise bekommen einen Tintenrahmen. -->
  <section class="abschnitt sand" id="auszeichnet" aria-labelledby="ausz-titel">
    <div class="huelle">
      <div class="section-head reveal">
        <span class="eyebrow">{T.auszeichnet.eyebrow}</span>
        <h2 id="ausz-titel" class="regel">{T.auszeichnet.titel}</h2>
        <p>{T.auszeichnet.text}</p>
      </div>
      <ul class="zahlen staffel">
        {T.auszeichnet.zahlen.map((z) => (
          <li class="reveal"><span class="zahl" data-zahl>{z.zahl}</span><span class="wort">{z.wort}</span><span class="zeile">{z.zeile}</span></li>
        ))}
      </ul>
      <div class="ausz-raster">
        <div class="nachweis-paar">
          {T.auszeichnet.nachweise.map((n, i) => (
            <article class="nachweis" data-szene>
              <Tinte art="rahmen" b={420} h={170} seed={31 + i} v={i * 2} dauer="lang" staerke={1.4} class="nachweis-rahmen" />
              <span class="art">{n.art}</span>
              <h3>{n.titel}</h3>
              <p>{n.text}</p>
            </article>
          ))}
        </div>
        <div class="fakten staffel">
          <div class="fakt reveal">
            <h3><Icon name="urteil" />{T.auszeichnet.erfahrungTitel}</h3>
            <ul class="strichliste">{T.fakten.erfahrungen.map((e) => <li>{e}</li>)}</ul>
          </div>
          <div class="fakt reveal">
            <h3><Icon name="dokument" />{T.auszeichnet.jvegTitel}</h3>
            <p>{T.auszeichnet.jvegText}</p>
          </div>
          <div class="fakt reveal">
            <h3><Icon name="gespraech" />{T.auszeichnet.tuerkeiTitel}</h3>
            <p>{T.auszeichnet.tuerkeiText}</p>
            <blockquote><p>„{T.fakten.kulturen}“</p></blockquote>
          </div>
          <div class="fakt reveal">
            <h3><Icon name="ort" />{T.auszeichnet.ortTitel}</h3>
            <p>{T.auszeichnet.ortText}</p>
          </div>
        </div>
      </div>
      <p class="mittig reveal"><a class="weiter" href={p(lang, "ueber")}>{T.auszeichnet.link}</a></p>
    </div>
  </section>

  <!-- Typische Dokumente in beide Richtungen: Kerims eigene Beispiele bekommen einen Tintenstrich -->
  <section class="abschnitt weiss" id="themen" aria-labelledby="themen-titel">
    <div class="huelle">
      <div class="section-head reveal">
        <span class="eyebrow">{T.themen.eyebrow}</span>
        <h2 id="themen-titel" class="regel">{T.themen.titel}</h2>
        <p>{T.themen.text}</p>
      </div>
      <div class="themen-zwei">
        {themenSpalten.map((s) => (
          <div class="themen-spalte reveal">
            <p class="ri-kopf"><Richtung text={s.kopf} /></p>
            <h3>{s.titel}</h3>
            <ul class="themen-liste" data-szene>
              {s.eintraege.map((e, i) => (
                <li>
                  {e.kerim ? <Markiert szene={false} seed={40 + i} v={Math.min(i, 5)} dauer="kurz">{e.text}</Markiert> : <span>{e.text}</span>}
                  <span class="zweit" lang={lang === "de" ? "tr" : "de"}>{e.tr}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="legende reveal"><span class="legende-strich" aria-hidden="true"></span>{T.themen.legende}</p>
      <p class="mittig reveal"><a class="knopf rahmen" href={p(lang, "themen")}>{T.themen.teaserLink}</a></p>
    </div>
  </section>

  <!-- Ratgeber: allgemeines Wissen, sichtbar als „keine Rechtsberatung“ markiert -->
  <section class="abschnitt sand" id="ratgeber" aria-labelledby="rat-titel">
    <div class="huelle">
      <div class="section-head reveal">
        <span class="eyebrow">{T.ratgeber.eyebrow}</span>
        <h2 id="rat-titel" class="regel">{T.ratgeber.titel}</h2>
        <p>{T.ratgeber.text}</p>
      </div>
      <ul class="rat-karten staffel">
        {ratgeberAuswahl.map((k) => (
          <li class="reveal"><a class="karte" href={p(lang, "ratgeber", `#${k.id}`)}>
            <h3>{k.frage}</h3>
            <p>{k.kurz}</p>
            <span class="weiter-text">{T.ratgeber.weiter}<Icon name="pfeil" /></span>
          </a></li>
        ))}
      </ul>
      <p class="recht-hinweis reveal"><Icon name="frage" />{T.ui.rechtHinweis}</p>
      <p class="mittig reveal"><a class="knopf rahmen" href={p(lang, "ratgeber")}>{T.ratgeber.teaserLink}</a></p>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="fragen-titel">
    <div class="huelle schmal-mittig">
      <div class="section-head reveal">
        <span class="eyebrow">{T.fragen.eyebrow}</span>
        <h2 id="fragen-titel" class="regel">{T.fragen.titelStart}</h2>
      </div>
      <div class="fragen reveal">
        {fragenStart.map((f) => (
          <details>
            <summary><span>{f.frage}</span><span class="zeichen" aria-hidden="true"></span></summary>
            <div class="antwort">{f.antwort.map((a) => <p>{a}</p>)}</div>
          </details>
        ))}
      </div>
      <p class="mittig"><a class="knopf rahmen" href={p(lang, "fragen")}>{T.fragen.alle}</a></p>
    </div>
  </section>
</Basis>

<style>
  /* ---------- Hero (Bauwelt-Aufbau, Beige statt Foto) ---------- */
  .hero {
    position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center;
    min-height: calc(100svh - var(--kopf-h)); padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(168deg, #e6d9c5 0%, #eee4d5 50%, #f5eee3 100%);
  }
  .hero-bg { position: absolute; inset: -4% 0; pointer-events: none; }
  .hero-bg::before {
    content: ""; position: absolute; inset: -10%;
    background: radial-gradient(40rem 26rem at 78% 22%, rgba(255, 253, 249, 0.85), transparent 70%), radial-gradient(30rem 22rem at 10% 90%, rgba(168, 128, 60, 0.12), transparent 70%);
  }
  .kiel-gross { position: absolute; right: -4rem; bottom: -6rem; width: clamp(18rem, 34vw, 30rem); fill: var(--logo); opacity: 0.045; animation: kenburns 22s ease-in-out 1 forwards; will-change: transform; }
  @keyframes kenburns { from { transform: scale(1) translateX(0); } to { transform: scale(1.08) translateX(-1.5%); } }

  .hero-inhalt { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 62rem) { .hero-inhalt { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4rem; } }
  .auf { animation: rise var(--dur-reveal) var(--ease) both; }
  .auf[data-d="1"] { animation-delay: 120ms; }
  .auf[data-d="2"] { animation-delay: 220ms; }
  .auf[data-d="3"] { animation-delay: 360ms; }
  .auf[data-d="4"] { animation-delay: 440ms; }
  .badge.auf { animation-duration: 0.8s; }

  .badge {
    display: inline-flex; align-items: center; gap: 0.6rem; margin: 0 0 1.5rem; padding: 0.5rem 1rem 0.5rem 0.75rem;
    border: 1px solid var(--gold); border-radius: 999px; color: var(--text); font-size: 0.95rem; line-height: 1.35;
  }
  .badge :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--gold-dunkel); flex: none; }
  .hero h1 { font-size: clamp(2.05rem, 3.9vw, 3.25rem); line-height: 1.15; max-width: 16em; margin-bottom: 1rem; }
  .sub { font-size: clamp(1.15rem, 1.7vw, 1.3rem); color: var(--text-leise); max-width: 34em; margin-bottom: 1.9rem; }
  .haupt { transition: background-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease); }
  .haupt:hover { background: var(--rot-hover); transform: scale(1.02); }
  .vertrauen { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin: 1.5rem 0 0; padding: 0; color: var(--text); font-weight: 600; font-size: 1rem; }
  .vertrauen li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .vertrauen :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--gold-dunkel); }

  .bruecke-ebene { justify-self: center; width: 100%; max-width: 34rem; }
  .bruecke { position: relative; margin: 0; width: 100%; }
  .bruecke svg { width: 100%; height: auto; overflow: visible; }
  .bogen { fill: none; stroke: var(--gold); stroke-width: 2.2; stroke-linecap: round; }
  .bogen-innen { fill: none; stroke: var(--gold); stroke-width: 1; opacity: 0.45; }
  .haenger line { stroke: var(--gold); stroke-width: 1; opacity: 0.5; }
  .deck { fill: none; stroke: var(--gold); stroke-width: 1.2; opacity: 0.7; }
  .spiegel { fill: none; stroke: var(--gold); stroke-width: 1.3; stroke-linecap: round; stroke-dasharray: 5 7; opacity: 0.32; }
  .ende { fill: var(--gold); }
  .ufer { display: flex; justify-content: space-between; margin-top: -0.6rem; font: 600 clamp(1.4rem, 2.6vw, 1.9rem)/1 var(--serif); color: var(--text); }
  .claim { margin: 1.4rem 0 0; text-align: center; font: italic 500 clamp(1.15rem, 2vw, 1.45rem)/1.35 var(--serif); color: var(--gold-dunkel); }
  /* Canvas kommt aus bruecke.js (aria-hidden, absolut, kein Layout-Einfluss) */
  .bruecke :global(canvas) { position: absolute; pointer-events: none; }
  .ufer span { transition: text-shadow 0.6s ease; }
  .ufer :global(.b-glanz) { text-shadow: 0 0 14px rgba(255, 244, 214, 0.95), 0 0 2px rgba(255, 244, 214, 0.9); }
  /* Mit JS und Bewegung: Endbild erst nach der Intro-Choreografie. Notfall: lädt bruecke.js nicht, erscheint alles nach 3,5 s. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bruecke .b-teil, :global(.js) .bruecke .b-ziel, :global(.js) .bruecke .claim { opacity: 0; }
    :global(.js) .bruecke:not(.b-bereit) :is(.b-teil, .b-ziel, .claim) { animation: b-notfall 0.6s ease 3.5s both; }
    :global(.js) .bruecke.b-fertig :is(.b-teil, .b-ziel, .claim) { opacity: 1; transition: opacity 0.5s linear; }
    /* vor jeder Wiederholung (alle 14 s) sanft ausblenden, dann baut licht.js die Brücke neu auf */
    :global(.js) .bruecke.b-aus :is(.b-teil, .b-ziel, .claim) { opacity: 0 !important; transition: opacity 0.6s ease !important; }
    :global(.js) .bruecke.b-bereit:not(.b-fertig) .claim :global(.tinte path) { animation-play-state: paused; }
    :global(.js) .bruecke.b-bereit:not(.b-fertig) :is(.b-ziel, .claim) { will-change: opacity, transform; } /* eigene Ebene: Einblenden ohne Neuzeichnen */
  }
  @keyframes b-notfall { from { opacity: 0; } to { opacity: 1; } }

  .karten { list-style: none; margin: clamp(2.5rem, 5vw, 3.25rem) 0 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .karten { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .karten a {
    display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1.1rem 1.25rem; border-radius: 16px;
    background: rgba(255, 253, 249, 0.75); border: 1px solid var(--tinte-3); color: var(--text); text-decoration: none;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) ease;
  }
  .karten a:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -20px rgba(43, 36, 31, 0.45); border-color: var(--gold); }
  .karten .symbol { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold-dunkel); }
  .karten .symbol :global(svg) { width: 1.45rem; height: 1.45rem; }
  .sprachen svg { width: 2.35rem !important; height: auto !important; overflow: visible; }
  .sprachen text { font: 700 11px var(--sans); fill: var(--text); }
  .sprachen path { fill: none; stroke: var(--gold-dunkel); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
