---
// Startseite v5 (Can 31.10.2026 10:41–10:46): weniger scrollen, Details auf Abruf, USP direkt nach dem Hero, Ablauf als Licht-Grafik,
// Einsatzgebiet, mobil Kurzfassungen. Aufbau nach Customer Journey (Bin ich hier richtig? → Kann er das, warum er? → Wie läuft es? →
// Kurze Antworten → Kontakt). Vorher (v4) 9 Blöcke, jetzt 5: Hero · Warum Herr Tanrikulu (6 Vorteile + Einsatzgebiet) · Ablauf · Gut zu wissen · Kontakt.
// Was von der Startseite ging (Zwei Richtungen, Leistungen mit Bildern, Zahlen/Nachweise, Themen, Ratgeber), steht auf den Unterseiten;
// jede Kurzinfo verlinkt dorthin. Fakten nur von der bisherigen Website (Talk 3904); Einsatzgebiet und Ablauf-Wortlaut zur Bestätigung (OFFENE-INFOS).
// Hero: Bauwelt-Aufbau (Jamil Talk 3910), Karten = Wege zu den Leistungen. Signature-Animation seit 31.10.2026 12:39 (Can „Ja“, Jamil 11:58/3967/3968):
// „Gespräch über den Dolmetscher“ mit zwei männlichen Büsten und dem Federkiel aus dem Logo (HeroGespraech.astro + public/gespraech.js).
// Die vorherige Licht-Brücke ist mit den Tags design-v5-bruecke / design-v5-bruecke-main gesichert.
import Basis from "../layouts/Basis.astro";
import Icon from "../components/Icon.astro";
import Ablauf from "../components/Ablauf.astro";
import RoughKarte from "../components/RoughKarte.astro";
import Platzhalter from "../components/Platzhalter.astro";
import Portrait from "../components/Portrait.astro";
import HeroGespraech from "../components/HeroGespraech.astro";
import Anfrage from "../components/Anfrage.astro";
import { TELEFON_LINK, WHATSAPP_LINK, PORTRAIT } from "../daten";
import { p, anfrageLink, mitFormular, type Lang, type Seite } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const KIEL = "M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z";
const W = T.warum;
const ziel = (seite: string, anker: string) => p(lang, seite as Seite, anker);
const formular = mitFormular(lang, "start");
---
<Basis lang={lang} seite="start">
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero-bg" aria-hidden="true" data-parallax="0.06">
      <svg class="kiel-gross" viewBox="0 0 58 66" focusable="false"><path d={KIEL} /></svg>
    </div>
    <div class="huelle hero-inhalt">
      <!-- Jamil Talk 3980–3982: Badge und Häkchen-Leiste entfernt; Animation im ersten Bildschirm (Handy: zwischen Unterzeile und Knöpfen, breit: rechts daneben) -->
      <h1 id="hero-titel" class="h-titel auf" data-d="1">{T.hero.h1}</h1>
      <!-- „↔“ in Systemschrift: sonst lädt der Browser für dieses eine Zeichen zwei weitere Open-Sans-Dateien (ca. 80 KB, Lighthouse 09.11.) -->
      <p class="sub auf" data-d="2">{T.hero.sub.split("↔").map((teil, i) => <>{i > 0 && <span class="zeichen-sys">↔</span>}{teil}</>)}</p>
      <!-- Signature-Animation „Gespräch über den Dolmetscher“ (ersetzt seit 31.10.2026 die Licht-Brücke, Can 12:39): links spricht jemand,
           das Licht fließt zum Federkiel, wird verwandelt und erreicht das Ohr rechts; ca. 4 s ab dem Laden, alle 14 s und beim Wiederkommen. -->
      <div class="szene-ebene" data-parallax="-0.035" data-szene>
        <div class="auf" data-d="2"><HeroGespraech lang={lang} /></div>
      </div>
      <div class="knoepfe auf" data-d="3">
        <a class="knopf haupt" href={anfrageLink(lang, T.ui.anfrageBetreff, "start")}>{T.ui.anfrage}</a>
        <a class="knopf rahmen ruf-k" href={TELEFON_LINK}><Icon name="telefon" /><span class="k-text">{T.ui.anrufen}</span></a>
        <!-- WhatsApp (Kerim Talk 3993, Jamil 3994): runder Symbol-Knopf, damit die Knöpfe am Handy in einer Zeile im ersten Bildschirm bleiben -->
        <a class="knopf rahmen rund" href={WHATSAPP_LINK} rel="noopener" aria-label={T.ui.whatsappLabel} title={T.ui.whatsappLang}><Icon name="whatsapp" /></a>
      </div>
    </div>

    <div class="huelle">
      <ul class="karten" data-szene>
        <li class="k0"><a href={p(lang, "uebersetzungen")}><span class="symbol"><Icon name="dokument" /></span><span class="text"><span class="titel">{T.hero.karten[0]}</span><span class="k-kurz">{T.hero.kartenKurz[0]}</span></span><Icon name="pfeil" /></a></li>
        <li class="k1"><a href={p(lang, "dolmetschen")}><span class="symbol"><Icon name="mikrofon" /></span><span class="text"><span class="titel">{T.hero.karten[1]}</span><span class="k-kurz">{T.hero.kartenKurz[1]}</span></span><Icon name="pfeil" /></a></li>
        <li class="k2"><a href={p(lang, "uebersetzungen", "#dok-titel")}>
          <span class="symbol sprachen" aria-hidden="true"><svg viewBox="0 0 44 24" focusable="false"><text x="0" y="16.5">DE</text><path d="M18.5 9.5h7m-2-2.5 2.5 2.5-2.5 2.5M25.5 14.5h-7m2-2.5-2.5 2.5 2.5 2.5" /><text x="28.5" y="16.5">TR</text></svg></span>
          <span class="text"><span class="titel">{T.hero.karten[2]}</span><span class="k-kurz">{T.hero.kartenKurz[2]}</span></span><Icon name="pfeil" /></a></li>
      </ul>
      <a class="mehr" href="#weiter" data-szene><span>{T.ui.mehrErfahren}</span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg></a>
    </div>
  </section>

  <div id="weiter"></div>

  <!-- Warum Herr Tanrikulu (Can 10:41/10:43): USP direkt nach dem Hero, als Kundennutzen, nur belegte Fakten.
       Dunkles Band wie die frühere Vertrauensleiste (Bauwelt-Muster, Jamil 3910). Je Punkt: Titel + Kurzzeile (immer),
       Langfassung nur breit (steht aber im HTML), die ganze Zeile führt zu den Details. Dazu das Einsatzgebiet (Can 10:46). -->
  <section class="warum" aria-labelledby="warum-titel">
    <div class="huelle">
      <div class="section-head reveal warum-kopf">
        <!-- Portrait (Kerim Talk 3991/3992), dezent über der Frage „Warum Herr Tanrikulu?“; lazy, feste Maße (kein Springen) -->
        {PORTRAIT && <Portrait lang={lang} groesse={112} name={false} klasse="warum-portrait" />}
        <span class="eyebrow">{W.eyebrow}</span>
        <h2 id="warum-titel" class="regel">{W.titel}</h2>
      </div>
      <ul class="usp staffel">
        {W.punkte.map((u) => (
          <li class="usp-punkt reveal">
            <span class="ring"><Icon name={u.icon as any} /></span>
            <div class="usp-text">
              <h3><a href={ziel(u.seite, u.anker)}>{u.titel}</a></h3>
              <p class="kurz">{u.kurz}</p>
              <p class="lang">{u.lang}</p>
              <span class="details" aria-hidden="true"><span class="wort">{W.details}</span><Icon name="pfeil" /></span>
            </div>
          </li>
        ))}
      </ul>
      <div class="gebiet reveal">
        <RoughKarte lang={lang} />
        <div class="gebiet-text">
          <h3>{T.gebiet.titel}</h3>
          <p class="gebiet-satz">{T.gebiet.satz}</p>
          <p class="lang-zeile">{T.gebiet.zusatz}</p>
          <a class="gebiet-link" href={p(lang, "dolmetschen", "#gebiet-titel")}>{W.details}<Icon name="pfeil" /></a>
        </div>
      </div>
      <div class="warum-hinweis"><Platzhalter lang={lang}>{W.platzhalter}</Platzhalter></div>
    </div>
  </section>

  <!-- Anfrageformular direkt nach „Warum Herr Tanrikulu?“ (Jamil Talk xidc8qvq #5312, 09.11.2026, „ohne ok“): dieselbe Komponente wie
       auf /kontakt/, eigener Abschnitt (Creme/Weiß-Wechsel). Der Hauptknopf oben, der Kopf-Knopf und der Abschluss-Aufruf springen hierher.
       Die Formular-Logik lädt erst, wenn der Abschnitt näher kommt (Lader in Anfrage.astro) – der erste Bildschirm bleibt schnell.
       Seit Jamil #5314 auch auf der türkischen Startseite (gleich gestaltet, Texte in src/lib/anfrage-texte.ts). -->
  {formular && (
    <section class="abschnitt anfrage-start" aria-labelledby="anfrage-titel">
      <div class="huelle">
        <div class="section-head anfrage-kopf">
          <span class="eyebrow">{T.anfrage.eyebrow}</span>
          <h2 id="anfrage-titel" class="regel" tabindex="-1">{T.anfrage.startTitel}</h2>
          <p>{T.anfrage.startZeile}</p>
          <p class="direkt-link"><a class="weiter" href="#aufruf-titel">{T.anfrage.direktLink}</a></p>
        </div>
        <Anfrage lang={lang} direkt="#aufruf-titel" wege="ende" />
      </div>
    </section>
  )}

  <Ablauf lang={lang} />

  <!-- Gut zu wissen: die Fragen, die vor der Anfrage auftauchen. Zum Aufklappen (ohne JS bedienbar), Antworten stehen im HTML;
       jede Antwort verlinkt auf die ausführliche Stelle (Ratgeber, Themen, Dolmetschen). Ersetzt Themen-, Ratgeber- und Fragen-Block. -->
  <section class="abschnitt gut" aria-labelledby="gut-titel">
    <div class="huelle schmal-mittig">
      <div class="section-head reveal">
        <span class="eyebrow">{T.gut.eyebrow}</span>
        <h2 id="gut-titel" class="regel">{T.gut.titel}</h2>
      </div>
      <div class="fragen">
        {T.gut.fragen.map((f) => (
          <details>
            <summary><span>{f.frage}</span><span class="zeichen" aria-hidden="true"></span></summary>
            <div class="antwort"><p>{f.antwort}</p><a class="weiter" href={ziel(f.seite, f.anker)}>{T.gut.mehr}</a></div>
          </details>
        ))}
      </div>
      <!-- Ratgeber und Häufige Fragen sind seit Jamil #5318 eine Seite „Gut zu wissen“; Themen entfällt (#5317) -->
      <ul class="weitere">
        <li><a class="weiter" href={p(lang, "wissen")}>{T.wissen.alle}</a></li>
      </ul>
    </div>
  </section>
</Basis>

<style>
  /* ---------- Hero (Bauwelt-Aufbau, Beige statt Foto) ---------- */
  .hero {
    position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center;
    min-height: calc(100svh - var(--kopf-h)); padding-block: clamp(1.25rem, 5vw, 4.5rem) clamp(1.25rem, 3vw, 2rem);
  }
  .hero-bg { position: absolute; inset: -4% 0; pointer-events: none; }
  .hero-bg::before {
    content: ""; position: absolute; inset: -10%;
    background: none; /* Jamil #4801: Hero ist reines Creme #EFE6D6 (Wechsel in global.css), keine Lichtflecken mehr */
  }
  .kiel-gross { position: absolute; right: -4rem; bottom: -6rem; width: clamp(18rem, 34vw, 30rem); fill: var(--logo); opacity: 0.045; animation: kenburns 22s ease-in-out 1 forwards; will-change: transform; }
  @keyframes kenburns { from { transform: scale(1) translateX(0); } to { transform: scale(1.08) translateX(-1.5%); } }

  /* Raster mit Bereichen (Jamil 3982): Handy Titel → Unterzeile → Animation → Knöpfe, alles im ersten Bildschirm; breit Text links, Animation rechts */
  .hero-inhalt { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "titel" "sub" "szene" "knoepfe"; align-items: center; }
  .h-titel { grid-area: titel; }
  .sub { grid-area: sub; }
  .szene-ebene { grid-area: szene; justify-self: center; width: 100%; max-width: 21rem; margin: 0 0 0.8rem; }
  .knoepfe { grid-area: knoepfe; }
  @media (min-width: 40rem) { .szene-ebene { max-width: 28rem; } }
  @media (min-width: 62rem) {
    .hero-inhalt { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); grid-template-rows: 1fr auto auto auto 1fr; grid-template-areas: ". szene" "titel szene" "sub szene" "knoepfe szene" ". szene"; column-gap: 4rem; }
    .szene-ebene { max-width: 34rem; margin: 0; align-self: center; }
  }
  .auf { animation: rise var(--dur-reveal) var(--ease) both; }
  .auf[data-d="1"] { animation-delay: 120ms; }
  .auf[data-d="2"] { animation-delay: 220ms; }
  .auf[data-d="3"] { animation-delay: 360ms; }

  /* H1: am Handy kleiner und ohne automatische Silbentrennung (Jamil 3982: „Überset-zungen … Tür-kisch“), seit Jamil #5332 kurze Frage als H1 */
  .hero h1 { font-size: clamp(1.6rem, 0.9rem + 2.6vw, 3.1rem); line-height: 1.15; max-width: 16em; margin-bottom: 0.7rem; hyphens: manual; -webkit-hyphens: manual; overflow-wrap: normal; }
  .sub { font-size: clamp(1.05rem, 1.7vw, 1.3rem); line-height: 1.55; color: var(--text-leise); max-width: 34em; margin-bottom: 0.8rem; }
  @media (min-width: 62rem) { .hero h1 { margin-bottom: 1rem; } .sub { margin-bottom: 1.9rem; } }
  .zeichen-sys { font-family: Arial, Helvetica, "Liberation Sans", sans-serif; }
  .knoepfe { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 26rem) { .knoepfe { gap: 0.5rem; } .knoepfe .knopf { padding-inline: 0.9rem; } }
  .knoepfe .rund { width: 3.25rem; padding: 0 !important; flex: none; }
  .knoepfe .rund :global(svg) { width: 1.35rem; height: 1.35rem; }
  /* sehr schmal (360 px): „Anrufen“ nur als Symbol (Name bleibt für Screenreader), damit drei Knöpfe in eine Zeile passen */
  @media (max-width: 23.5rem) { .ruf-k { width: 3.25rem; padding: 0 !important; } .ruf-k .k-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  /* Handy (unter 48rem): die drei Hero-Knöpfe entfallen (Jamil Talk xidc8qvq #5376, 10.11.2026) – die feste Leiste unten bietet
     Anrufen · WhatsApp · Preisanfrage. Tablet und Desktop unverändert. */
  @media (max-width: 47.99rem) { .knoepfe { display: none; } }
  .haupt { transition: background-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease); }
  .haupt:hover { background: var(--akzent-hover); transform: scale(1.02); }

  .karten { list-style: none; margin: clamp(2.5rem, 5vw, 3.25rem) 0 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .karten { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .karten a {
    display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1.1rem 1.25rem; border-radius: 16px;
    background: rgba(255, 253, 249, 0.75); border: 1px solid var(--tinte-3); color: var(--text); text-decoration: none;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) ease;
  }
  .karten a:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -20px rgba(29, 49, 90, 0.35); border-color: var(--deko); }
  .karten .symbol { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--deko); color: var(--primaer-leise); }
  .karten .symbol :global(svg) { width: 1.45rem; height: 1.45rem; }
  .sprachen svg { width: 2.35rem !important; height: auto !important; overflow: visible; }
  .sprachen text { font: 700 11px var(--sans); fill: var(--text); }
  .sprachen path { fill: none; stroke: var(--primaer-leise); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .karten .titel { flex: 1; font: 600 1.15rem/1.3 var(--serif); }
  .karten a > :global(svg:last-child) { width: 1.1rem; height: 1.1rem; color: var(--primaer-leise); flex: none; }
  .karten li { animation: rise var(--dur-reveal) var(--ease) both; }
  .karten .k0 { animation-delay: 500ms; }
  .karten .k1 { animation-delay: 650ms; }
  .karten .k2 { animation-delay: 800ms; }

  .mehr { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; width: max-content; margin: clamp(1.75rem, 3vw, 2.5rem) auto 0; color: var(--text-leise); text-decoration: none; font-size: 0.95rem; padding: 0.3rem 0.75rem; animation: nudge 2.2s ease-in-out 1s 1 both; }
  .mehr svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: var(--primaer-leise); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .mehr:hover { color: var(--primaer); }

  /* Karten-Kurzzeile nur breit (mobil reicht der Titel) */
  .karten .text { flex: 1; display: flex; flex-direction: column; gap: 0.15rem; }
  .k-kurz { display: none; font-size: 0.95rem; line-height: 1.4; color: var(--text-leise); }
  @media (min-width: 48rem) { .k-kurz { display: block; } }

  /* ---------- Warum Herr Tanrikulu (seit Jamil #4801: helles Band im Creme/Weiß-Wechsel, dunkle Schrift) ---------- */
  .warum { color: var(--text); padding-block: clamp(3rem, 7vw, 5.5rem); }
  .warum .section-head { margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem); }
  .usp { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  @media (min-width: 48rem) { .usp { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2.5rem; } }
  @media (min-width: 66rem) { .usp { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 2.5rem; } }
  /* Linienfarbe als Vollton – halbtransparente Ränder flimmerten beim Einblenden. Karten in Creme mit feinem Rand auf weißem Band. */
  .usp-punkt { position: relative; display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 0; border-bottom: 1px solid var(--tinte-3); }
  .usp-punkt:last-child { border-bottom: 0; }
  @media (min-width: 48rem) { .usp-punkt { gap: 1.1rem; padding: 1.4rem 1.4rem 1.25rem; border: 1px solid var(--tinte-3); border-radius: 16px; background: var(--sekundaer); transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease); }
    .usp-punkt:last-child { border-bottom: 1px solid var(--tinte-3); }
    .usp-punkt:hover { border-color: var(--deko); background: #e9dfcc; box-shadow: 0 16px 30px -22px rgba(29, 49, 90, 0.35); transform: translateY(-3px); } }
  .ring { display: grid; place-items: center; flex: none; width: 2.9rem; height: 2.9rem; border-radius: 50%; border: 1.5px solid var(--deko); background: var(--weiss); color: var(--primaer); }
  /* einziger Vertrauensanker in Gold (Jamil 06.11.2026): Siegel „Beeidigt und ermächtigt vom OLG Schleswig“ (2. Vorteil, DE und TR) */
  .usp-punkt:nth-child(2) .ring { border-color: var(--akzent); background: var(--akzent); color: var(--primaer); }
  .ring :global(svg) { width: 1.35rem; height: 1.35rem; }
  @media (min-width: 48rem) { .ring { width: 3.25rem; height: 3.25rem; } .ring :global(svg) { width: 1.5rem; height: 1.5rem; } }
  .usp-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .usp h3 { font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.3; margin: 0 0 0.25rem; color: var(--primaer); padding-right: 1.75rem; }
  @media (min-width: 48rem) { .usp h3 { padding-right: 0; } }
  .usp h3 a { color: inherit; text-decoration: none; }
  .usp h3 a::after { content: ""; position: absolute; inset: 0; border-radius: 16px; } /* ganze Zeile klickbar */
  .kurz { margin: 0; color: var(--text); font-size: 1rem; line-height: 1.5; }
  .lang { display: none; margin: 0.6rem 0 0; color: var(--text-leise); font-size: 0.95rem; line-height: 1.55; }
  @media (min-width: 66rem) { .lang { display: block; } }
  .details { position: absolute; right: 0; top: 1.15rem; color: var(--primaer); display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: 0.92rem; }
  .details .wort { display: none; }
  .details :global(svg) { width: 1.1rem; height: 1.1rem; }
  @media (min-width: 48rem) { .details { position: static; margin-top: auto; padding-top: 0.9rem; } .details .wort { display: inline; } }
  .usp-punkt:hover .details :global(svg) { transform: translateX(3px); transition: transform var(--dur-fast) var(--ease); }

  /* Einsatzgebiet: Skizzen-Karte (Can 11:29) – schmal über dem Text, breit daneben */
  .gebiet { display: grid; justify-items: center; text-align: center; gap: 1rem; margin-top: clamp(1.5rem, 3vw, 2.5rem); padding-top: clamp(1.25rem, 3vw, 2rem); border-top: 1px solid var(--tinte-3); }
  .gebiet :global(.rkarte) { width: min(100%, 24rem); }
  @media (min-width: 48rem) { .gebiet { grid-template-columns: auto minmax(0, 28rem); justify-content: center; justify-items: start; text-align: left; gap: 3rem; align-items: center; }
    .gebiet :global(.rkarte) { width: 24rem; } }
  @media (min-width: 66rem) { .gebiet :global(.rkarte) { width: 28rem; } }
  .gebiet-text h3 { font: 600 0.82rem/1.5 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--primaer-leise); margin: 0 0 0.3rem; }
  .gebiet-satz { font: 600 clamp(1.1rem, 1.9vw, 1.4rem)/1.35 var(--serif); color: var(--primaer); margin: 0 0 0.35rem; }
  .lang-zeile { display: none; margin: 0 0 0.5rem; color: var(--text-leise); font-size: 1rem; }
  @media (min-width: 48rem) { .lang-zeile { display: block; } }
  .gebiet-link { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; color: var(--primaer); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
  .gebiet-link :global(svg) { width: 1.05rem; height: 1.05rem; }
  .gebiet-link:hover { text-decoration: underline; text-underline-offset: 0.22em; }
  .staffel > :global(.reveal:nth-child(2)) { transition-delay: 80ms; }
  .staffel > :global(.reveal:nth-child(3)) { transition-delay: 160ms; }
  .staffel > :global(.reveal:nth-child(4)) { transition-delay: 240ms; }
  .staffel > :global(.reveal:nth-child(5)) { transition-delay: 320ms; }
  .staffel > :global(.reveal:nth-child(6)) { transition-delay: 400ms; }

