---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Nachweise from "../components/Nachweise.astro";
import Portrait from "../components/Portrait.astro";
import { PORTRAIT, VORSCHAU, NAME } from "../daten";
import { type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const S = T.seiten.ueber;
const zitat = T.fakten.kulturen.split(T.fakten.kulturenMarke);
---
<Basis lang={lang} seite="ueber" titel={T.meta.ueber.titel} beschreibung={T.meta.ueber.beschreibung}>
  <SeitenKopf titel={T.nav.ueber} zeile={S.zeile}>
    <p class="lead">{T.fakten.vorstellung}</p>
    {(PORTRAIT || VORSCHAU) && <div slot="bild" class="bildplatz"><Portrait lang={lang} groesse={272} laden="eager" /></div>}
  </SeitenKopf>

  <section class="abschnitt" aria-label={S.beganLabel}>
    <div class="huelle raster-2">
      <h2>{S.beganTitel}</h2>
      <div><p class="lead">{T.fakten.studium}</p></div>
    </div>
  </section>

  <!-- Kerims Satz; die Brücke zwischen den Kulturen fett (v5: keine Unterstreichung, Jamil Talk 3957) -->
  <section class="zitat-band dunkel" aria-label={S.zitatLabel} data-szene>
    <div class="huelle">
      <figure class="zitat">
        <svg class="bogen" viewBox="0 0 600 90" aria-hidden="true" focusable="false">
          <path d="M8 84 Q 300 -50 592 84" />
          <circle cx="8" cy="84" r="4" /><circle cx="592" cy="84" r="4" />
        </svg>
        <blockquote><p>{zitat[0]}<strong class="betont">{T.fakten.kulturenMarke}</strong>{zitat[1]}</p></blockquote>
        <figcaption>{NAME}</figcaption>
      </figure>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="vertrauen-titel">
    <div class="huelle">
      <Nachweise lang={lang}>
        <h2 id="vertrauen-titel">{S.qualiTitel}</h2>
        <p class="studium">{S.studiumSatz}</p>
      </Nachweise>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="erfahrung-titel">
    <div class="huelle raster-2">
      <h2 id="erfahrung-titel">{T.seiten.dolmetschen.erfahrungTitel}</h2>
      <div>
        <p>{T.fakten.erfahrungEinleitung}</p>
        <ul class="strichliste">{T.fakten.erfahrungen.map((e) => <li>{e}</li>)}</ul>
      </div>
    </div>
  </section>
</Basis>
<style>
  .bildplatz { display: flex; justify-content: center; }
  .studium { color: var(--text-leise); max-width: 26em; }
  .zitat-band { padding-block: clamp(4rem, 9vw, 6.5rem); background: var(--tinte-2); }
  .zitat { margin: 0 auto; max-width: 50rem; text-align: center; }
  .bogen { width: min(100%, 30rem); margin: 0 auto 1.75rem; overflow: visible; animation: einblenden 0.8s ease both; }
  .bogen path { fill: none; stroke: var(--gold); stroke-width: 1.5; }
  .bogen circle { fill: var(--gold); }
  blockquote { margin: 0; }
  blockquote p { margin: 0 auto; max-width: 22em; font: italic 500 clamp(1.5rem, 3.2vw, 2.25rem)/1.45 var(--serif); color: var(--hell); animation: rise var(--dur-reveal) var(--ease) 0.2s both; }
  figcaption { margin-top: 1.75rem; color: var(--gold-dunkel); letter-spacing: 0.04em; font-size: 0.98rem; }
</style>
