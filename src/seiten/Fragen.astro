---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Platzhalter from "../components/Platzhalter.astro";
import { p, type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const schema = [{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: T.fragen.liste.map((f) => ({ "@type": "Question", name: f.frage, acceptedAnswer: { "@type": "Answer", text: f.antwort.join(" ") } })),
}];
---
<Basis lang={lang} seite="fragen" titel={T.meta.fragen.titel} beschreibung={T.meta.fragen.beschreibung} schema={schema}>
  <SeitenKopf titel={T.fragen.eyebrow}>
    <p class="lead">{T.fragen.seitenText}</p>
  </SeitenKopf>
  <section class="abschnitt" aria-label={T.fragen.eyebrow}>
    <div class="huelle">
      <div class="fragen">
        {T.fragen.liste.map((f) => (
          <details>
            <summary><span>{f.frage}</span><span class="zeichen" aria-hidden="true"></span></summary>
            <div class="antwort">{f.antwort.map((a) => <p>{a}</p>)}</div>
          </details>
        ))}
      </div>
      <p class="mehr-wissen"><a class="weiter" href={p(lang, "ratgeber")}>{T.ratgeber.teaserLink}</a></p>
      <Platzhalter lang={lang}>{T.fragen.platzhalter}</Platzhalter>
    </div>
  </section>
</Basis>
<style>
  .fragen { max-width: 52rem; margin-bottom: 2rem; border-top: 1px solid var(--linie); }
  details { border-bottom: 1px solid var(--linie); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.4rem 0; cursor: pointer; list-style: none;
    font: 500 clamp(1.2rem, 2vw, 1.45rem)/1.35 var(--serif); color: var(--tinte);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--gold-dunkel); }
  .zeichen { position: relative; flex: none; width: 2.25rem; height: 2.25rem; border: 1px solid var(--gold); border-radius: 50%; }
  .zeichen::before, .zeichen::after { content: ""; position: absolute; left: 50%; top: 50%; width: 0.85rem; height: 1px; background: var(--tinte); transform: translate(-50%, -50%); transition: transform 0.3s var(--sanft); }
  .zeichen::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .zeichen::after { transform: translate(-50%, -50%) rotate(0deg); }
  details[open] .zeichen { background: var(--tinte); }
  details[open] .zeichen::before, details[open] .zeichen::after { background: var(--gold); }
  .antwort { padding: 0 3.5rem 1.5rem 0; color: var(--text); }
  .antwort p { max-width: 42em; }
  .mehr-wissen { margin: 0 0 1rem; }
  @media (prefers-reduced-motion: no-preference) { details[open] .antwort { animation: auftauchen 0.35s var(--sanft) both; } }
</style>
