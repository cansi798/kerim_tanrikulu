---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import BildDolmetschen from "../components/BildDolmetschen.astro";
import RoughKarte from "../components/RoughKarte.astro";
import { TELEFON_LINK, WHATSAPP_LINK } from "../daten";
import Icon from "../components/Icon.astro";
import { p, anfrageLink, type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const S = T.seiten.dolmetschen;
---
<Basis lang={lang} seite="dolmetschen" titel={T.meta.dolmetschen.titel} beschreibung={T.meta.dolmetschen.beschreibung}>
  <SeitenKopf titel={T.leistungen.doTitel} zeile={S.zeile}>
    <p class="lead">{T.fakten.freude}</p>
    <BildDolmetschen slot="bild" lang={lang} />
  </SeitenKopf>

  <section class="abschnitt" aria-labelledby="beeidigt-titel">
    <div class="huelle raster-2">
      <h2 id="beeidigt-titel">{S.beeidigtTitel}</h2>
      <div><p class="lead">{T.fakten.beeidigtSatz}</p></div>
    </div>
  </section>

  <!-- Einsatzgebiet (Can 31.10.2026 10:46; von Kerim bestätigt und um Mecklenburg-Vorpommern ergänzt, Talk 3990) -->
  <section class="abschnitt sand gebiet" aria-labelledby="gebiet-titel">
    <div class="huelle raster-2">
      <h2 id="gebiet-titel">{T.gebiet.titel}</h2>
      <div class="gebiet-inhalt">
        <RoughKarte lang={lang} />
        <div>
          <p class="lead">{T.gebiet.satz}.</p>
          <p class="leise">{T.gebiet.zusatz}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video- und Telefondolmetschen (Kerim Talk 3990) -->
  <section class="abschnitt" aria-labelledby="fern-titel">
    <div class="huelle raster-2">
      <h2 id="fern-titel">{S.fernTitel}</h2>
      <div>
        <ul class="arten">
          <li><span class="symbol"><Icon name="ort" /></span>{lang === "tr" ? "Yerinde" : "Vor Ort"}</li>
          <li><span class="symbol"><Icon name="video" /></span>{lang === "tr" ? "Görüntülü" : "Per Video"}</li>
          <li><span class="symbol"><Icon name="telefon" /></span>{lang === "tr" ? "Telefonla" : "Am Telefon"}</li>
        </ul>
        <p class="lead">{S.fernText}</p>
      </div>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="unterschied-titel">
    <div class="huelle raster-2">
      <h2 id="unterschied-titel">{S.unterschiedTitel}</h2>
      <div>
        <p class="lead">{S.unterschiedText}</p>
        <a class="weiter" href={p(lang, "wissen", "#dolmetscher-uebersetzer")}>{T.ratgeber.teaserLink}</a>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anfrage-titel">
    <div class="huelle raster-2">
      <h2 id="anfrage-titel">{T.seiten.uebersetzungen.anfrageTitel}</h2>
      <div>
        <p class="lead">{T.seiten.uebersetzungen.anfrageText}</p>
        <div class="knoepfe">
          <a class="knopf" href={anfrageLink(lang, T.ui.anfrageBetreffDo)}>{T.ui.anfrage}</a>
          <a class="knopf rahmen" href={TELEFON_LINK}><Icon name="telefon" />{T.ui.anrufen}</a>
          <a class="knopf rahmen" href={WHATSAPP_LINK} rel="noopener"><Icon name="whatsapp" />{T.ui.whatsapp}</a>
        </div>
        <p class="honorar leise"><strong>{T.fakten.honorarTitel}.</strong> {T.fakten.honorar} {T.fakten.honorarBeispiel}</p>
      </div>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="erfahrung-titel">
    <div class="huelle raster-2">
      <h2 id="erfahrung-titel">{S.erfahrungTitel}</h2>
      <div>
        <p>{T.fakten.erfahrungEinleitung}</p>
        <ul class="strichliste">{T.fakten.erfahrungen.map((e) => <li>{e}</li>)}</ul>
        <p class="mt"><a class="weiter" href={p(lang, "ueber")}>{S.ueberLink}</a></p>
      </div>
    </div>
  </section>
</Basis>
<style>
  .honorar { margin: 2rem 0 0; max-width: 46rem; }
  .mt { margin-top: 1.5rem; }
  .arten { list-style: none; margin: 0 0 1.25rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  .arten li { display: flex; align-items: center; gap: 0.7rem; font: 600 1.1rem/1.3 var(--serif); color: var(--tinte); }
  .arten .symbol { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--deko); color: var(--primaer-leise); }
  .arten .symbol :global(svg) { width: 1.3rem; height: 1.3rem; }
  .sand { background: var(--sand); }
  .gebiet-inhalt { display: grid; gap: 1.25rem; align-items: center; }
  /* Karte über dem Text (seit MV breiter, 800 × 640) – nebeneinander wurden die Beschriftungen zu klein */
  .gebiet-inhalt :global(.rkarte) { width: min(100%, 32rem); }
  .gebiet-inhalt .lead { margin-bottom: 0.5rem; }
  .gebiet-inhalt .leise { margin: 0; }
</style>
