---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Nachweise from "../components/Nachweise.astro";
import Portrait from "../components/Portrait.astro";
import { ERFAHRUNGEN, PORTRAIT, VORSCHAU } from "../daten";
---
<Basis titel="Über mich" beschreibung="Kerim Mikael Tanrikulu, allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für die türkische und deutsche Sprache durch das Oberlandesgericht Schleswig seit Mai 2021.">
  <SeitenKopf titel="Über mich" zeile="Kerim Mikael Tanrikulu">
    <!-- Text wörtlich von der bisherigen Jimdo-Seite -->
    <p class="lead">Ich bin Kerim Mikael Tanrikulu, allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für die türkische und deutsche Sprache durch das Oberlandesgericht Schleswig seit Mai 2021.</p>
    {(PORTRAIT || VORSCHAU) && <div slot="bild" class="bildplatz"><Portrait klein /></div>}
  </SeitenKopf>

  <section class="abschnitt" aria-label="Wie ich zum Übersetzen kam">
    <div class="huelle raster-2">
      <h2>Wie alles begann</h2>
      <div>
        <p class="lead">Meine Begeisterung für das Übersetzen habe ich bei einem Studienaufenthalt in der Türkei entdeckt. Seither bereitet es mir immer große Freude, wenn ich zu einem gelungenen Gespräch und zu gegenseitiger Verständigung beitragen kann.</p>
      </div>
    </div>
  </section>

  <section class="zitat-band dunkel" aria-label="Mein Verständnis meiner Arbeit" data-szene>
    <div class="huelle">
      <figure class="zitat">
        <svg class="bogen" viewBox="0 0 600 90" aria-hidden="true" focusable="false">
          <path class="strich" pathLength="1" d="M8 84 Q 300 -50 592 84" />
          <circle class="ufer-l" cx="8" cy="84" r="4" /><circle class="ufer-r" cx="592" cy="84" r="4" />
        </svg>
        <blockquote><p>Ich verstehe meine Arbeit als eine Form von Brückenbildung zwischen den Kulturen.</p></blockquote>
        <figcaption>Kerim Mikael Tanrikulu</figcaption>
      </figure>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="vertrauen-titel">
    <div class="huelle">
      <Nachweise>
        <h2 id="vertrauen-titel">Qualifikation</h2>
      </Nachweise>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="erfahrung-titel">
    <div class="huelle raster-2">
      <h2 id="erfahrung-titel">Bisherige Erfahrungen</h2>
      <div>
        <p>Zu meinen bisherigen Erfahrungen gehört unter anderem die Arbeit mit:</p>
        <ul class="strichliste">
          {ERFAHRUNGEN.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Basis>
<style>
  .bildplatz { display: flex; justify-content: center; }
  .zitat-band { padding-block: clamp(4rem, 9vw, 6.5rem); background: var(--tinte-2); }
  .zitat { margin: 0 auto; max-width: 50rem; text-align: center; }
  .bogen { width: min(100%, 30rem); margin: 0 auto 1.75rem; overflow: visible; }
  .bogen path { fill: none; stroke: var(--gold); stroke-width: 1.5; animation: zeichnen 1.2s var(--sanft) both; }
  .bogen circle { fill: var(--gold); }
  .ufer-r { animation: einblenden 0.2s ease 1.1s both; }
  blockquote { margin: 0; }
  blockquote p { margin: 0 auto; max-width: 20em; font: italic 400 clamp(1.7rem, 3.8vw, 2.7rem)/1.3 var(--serif); color: var(--hell); animation: auftauchen 0.8s var(--sanft) 0.3s both; }
  figcaption { margin-top: 1.5rem; color: var(--gold-dunkel); letter-spacing: 0.04em; font-size: 0.98rem; }
</style>
