---
import Basis from "../layouts/Basis.astro";
import Nachweise from "../components/Nachweise.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Platzhalter from "../components/Platzhalter.astro";
import { ERFAHRUNGEN, VORSCHAU } from "../daten";
---
<Basis titel="Über mich" beschreibung="Kerim Mikael Tanrikulu, allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für die türkische und deutsche Sprache durch das Oberlandesgericht Schleswig seit Mai 2021.">
  <SeitenKopf titel="Über mich" />

  <section class="abschnitt" aria-label="Vorstellung">
    <div class="huelle vorstellung">
      {VORSCHAU && (
        <figure class="portrait" aria-label="Platzhalter für ein Portraitfoto">
          <span>Portraitfoto folgt</span>
        </figure>
      )}
      <div>
        <!-- Text wörtlich von der bisherigen Jimdo-Seite -->
        <p class="lead">Ich bin Kerim Mikael Tanrikulu, allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für die türkische und deutsche Sprache durch das Oberlandesgericht Schleswig seit Mai 2021.</p>
        <p>Meine Begeisterung für das Übersetzen habe ich bei einem Studienaufenthalt in der Türkei entdeckt. Seither bereitet es mir immer große Freude, wenn ich zu einem gelungenen Gespräch und zu gegenseitiger Verständigung beitragen kann.</p>
      </div>
    </div>
  </section>

  <section class="zitat-band pergament" aria-label="Mein Verständnis meiner Arbeit">
    <div class="huelle">
      <figure class="zitat einblenden">
        <svg class="bogen" viewBox="0 0 600 70" aria-hidden="true" focusable="false"><path pathLength="1" d="M10 62 Q 300 -38 590 62" /></svg>
        <blockquote><p>Ich verstehe meine Arbeit als eine Form von Brückenbildung zwischen den Kulturen.</p></blockquote>
      </figure>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="vertrauen-titel">
    <div class="huelle rand-raster">
      <h2 id="vertrauen-titel">Warum Sie mir Ihre Unterlagen anvertrauen können</h2>
      <div>
        <Nachweise />
        <Platzhalter>Ein Satz zum Umgang mit Unterlagen (Vertraulichkeit, Aufbewahrung, Rückgabe) bitte vom Kunden formulieren lassen.</Platzhalter>
      </div>
    </div>
  </section>

  <section class="abschnitt pergament" aria-labelledby="erfahrung-titel">
    <div class="huelle rand-raster">
      <h2 id="erfahrung-titel">Bisherige Erfahrungen</h2>
      <div>
        <p>Zu meinen bisherigen Erfahrungen gehört unter anderem die Arbeit mit:</p>
        <ul class="strichliste">
          {ERFAHRUNGEN.map((e) => <li>{e}</li>)}
        </ul>
      </div>
    </div>
  </section>
</Basis>
<style>
  .vorstellung { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 52rem) { .vorstellung { grid-template-columns: 17rem 1fr; gap: 4rem; } }
  .portrait {
    margin: 0; aspect-ratio: 4 / 5; max-width: 17rem; display: grid; place-items: center;
    border: 2px dashed #9b2335; background: #fbf0f0; color: #5b1520; font-weight: 500;
  }
  .zitat-band { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .zitat { margin: 0 auto; max-width: 46rem; text-align: center; }
  .bogen { width: min(100%, 26rem); margin: 0 auto 1.25rem; }
  .bogen path { fill: none; stroke: var(--messing); stroke-width: 1.5; }
  blockquote { margin: 0; }
  blockquote p { margin: 0 auto; max-width: 21em; font: italic 400 clamp(1.6rem, 3.6vw, 2.4rem)/1.35 var(--caslon-kursiv); color: var(--tinte); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bogen path { stroke-dasharray: 1; animation: bogen linear both; animation-timeline: view(); animation-range: entry 10% cover 40%; }
    }
  }
  @keyframes bogen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
</style>
