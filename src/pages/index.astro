---
import Basis from "../layouts/Basis.astro";
import Feder from "../components/Feder.astro";
import Icon from "../components/Icon.astro";
import Nachweise from "../components/Nachweise.astro";
import SzeneBeglaubigung from "../components/SzeneBeglaubigung.astro";
import SzeneDolmetschen from "../components/SzeneDolmetschen.astro";
import { u, mailLink, NAME, ERFAHRUNGEN, TELEFON_LINK } from "../daten";

// Fragen in Kundensprache (Jamils Konzept, Talk 3877): Besucher erkennen ihr Anliegen und kommen mit einem Klick weiter.
const anliegen = [
  { icon: "dokument", frage: "Ihr Dokument muss bei einer Behörde oder einem Gericht eingereicht werden?", link: "/uebersetzungen/", weiter: "Beglaubigte Übersetzungen" },
  { icon: "gespraech", frage: "Sie suchen einen Dolmetscher für Türkisch, zum Beispiel für einen Termin?", link: "/dolmetschen/", weiter: "Dolmetschen" },
  { icon: "frage", frage: "Sie wissen nicht, welche Form Ihre Behörde verlangt?", link: "/fragen/", weiter: "Häufige Fragen" },
] as const;
---
<Basis>
  <!-- Hero (Jamil Talk 3894): Logo und Name mit Vision. Die Feder schreibt, der Faden verbindet beide Ufer (1,4 s). -->
  <section class="hero dunkel" aria-labelledby="hero-titel" data-szene>
    <div class="huelle hero-innen">
      <div class="zeichen"><Feder schreiben /></div>
      <h1 id="hero-titel">
        <span class="name">{NAME}</span>
        <span class="titel">Allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für Deutsch und Türkisch</span>
      </h1>
      <div class="horizont" aria-hidden="true">
        <span class="ufer">Deutsch</span>
        <span class="linie"><span class="links"></span><span class="rechts"></span></span>
        <span class="ufer" lang="tr">Türkçe</span>
      </div>
      <p class="vision">Brücken bauen zwischen den Kulturen.</p>
      <div class="knoepfe">
        <a class="knopf" href={mailLink("Anfrage: Übersetzung oder Dolmetschen")}>Anfrage senden</a>
        <a class="knopf rahmen" href={TELEFON_LINK}><Icon name="telefon" />Anrufen</a>
      </div>
    </div>
  </section>

  <!-- Problem zuerst (Jamils Konzept): drei Anliegen als Fragen -->
  <section class="abschnitt" aria-labelledby="anliegen-titel">
    <div class="huelle">
      <div class="kopfzeile">
        <h2 id="anliegen-titel">Wobei kann ich Ihnen helfen?</h2>
      </div>
      <ul class="anliegen" data-szene>
        {anliegen.map((a, i) => (
          <li class={`k${i}`}>
            <a href={u(a.link)}>
              <span class="symbol"><Icon name={a.icon} zeichnen /></span>
              <span class="frage">{a.frage}</span>
              <span class="weiter">{a.weiter}<Icon name="pfeil" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Leistungen als Szenen statt Text (Jamil Talk 3892/3898) -->
  <section class="abschnitt dunkel" aria-labelledby="leistungen-titel">
    <div class="huelle">
      <div class="kopfzeile">
        <h2 id="leistungen-titel">Schriftlich und mündlich</h2>
        <p>Für die türkische und die deutsche Sprache.</p>
      </div>
      <div class="leistungen">
        <article class="leistung">
          <SzeneBeglaubigung />
          <h3>Beglaubigte Übersetzungen</h3>
          <p>Urkunden, Zeugnisse, Gerichtsurteile und andere Dokumente. Mit schriftlicher Bestätigung, dass die Übersetzung richtig und vollständig ist.</p>
          <a class="weiter" href={u("/uebersetzungen/")}>Mehr zu Übersetzungen</a>
        </article>
        <article class="leistung">
          <SzeneDolmetschen />
          <h3>Dolmetschen</h3>
          <p>Bei Terminen und Gesprächen übertrage ich mündlich zwischen Deutsch und Türkisch, damit sich beide Seiten verstehen.</p>
          <a class="weiter" href={u("/dolmetschen/")}>Mehr zum Dolmetschen</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Vertrauen: nur nachweisbare Angaben -->
  <section class="abschnitt" aria-labelledby="vertrauen-titel">
    <div class="huelle">
      <Nachweise>
        <h2 id="vertrauen-titel">Offiziell beeidigt und ermächtigt</h2>
        <p class="leise schmal">Diese Angaben sind öffentlich nachweisbar.</p>
        <a class="weiter" href={u("/ueber-mich/")}>Mehr über mich</a>
      </Nachweise>
    </div>
  </section>

  <section class="erfahrung weiss" aria-labelledby="erfahrung-titel">
    <div class="huelle">
      <h2 id="erfahrung-titel" class="klein">Bisherige Erfahrungen, unter anderem in der Arbeit mit</h2>
      <ul>
        {ERFAHRUNGEN.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>
</Basis>

<style>
  /* Hero */
  .hero {
    position: relative; overflow: hidden; text-align: center;
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(4rem, 9vw, 6.5rem);
    background: radial-gradient(60rem 30rem at 50% 18%, rgba(201, 163, 91, 0.13), transparent 70%), var(--tinte);
  }
  .hero-innen { display: flex; flex-direction: column; align-items: center; }
  .zeichen { width: clamp(4.5rem, 9vw, 6.5rem); color: var(--hell); margin-bottom: clamp(1.75rem, 4vw, 2.5rem); }
  .hero h1 { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 1rem; }
  .name { font-size: clamp(2.7rem, 7.4vw, 5.6rem); line-height: 1.02; font-weight: 500; letter-spacing: -0.01em; max-width: 11em; }
  .titel { font: 400 clamp(1.02rem, 1.6vw, 1.2rem)/1.5 var(--sans); color: var(--hell-leise); letter-spacing: 0.01em; max-width: 34em; }
  .horizont { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; width: min(100%, 44rem); margin: clamp(2rem, 4vw, 2.75rem) 0 1.5rem; }
  .ufer { font-size: 0.9rem; letter-spacing: 0.08em; color: var(--gold); animation: einblenden 0.4s ease 1s both; }
  .linie { display: grid; grid-template-columns: 1fr 1fr; height: 1px; }
  .linie span { background: var(--gold); animation: breiten 0.6s var(--sanft) 0.8s both; }
  .linie .links { transform-origin: right; }
  .linie .rechts { transform-origin: left; }
  .vision { font: italic 400 clamp(1.5rem, 3.4vw, 2.35rem)/1.3 var(--serif); color: var(--gold-hell); margin: 0 0 clamp(2rem, 4vw, 2.75rem); animation: auftauchen 0.6s var(--sanft) 0.85s both; }
  .hero .knoepfe { justify-content: center; }

  /* Anliegen */
  .anliegen { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .anliegen { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }
  .anliegen a {
    position: relative; display: flex; flex-direction: column; gap: 1.25rem; height: 100%;
    padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--weiss); border: 1px solid var(--linie); border-radius: 4px;
    color: var(--text); text-decoration: none; transition: transform 0.35s var(--sanft), box-shadow 0.35s var(--sanft), border-color 0.35s ease;
  }
  .anliegen a::after { content: ""; position: absolute; left: -1px; right: -1px; bottom: -1px; height: 2px; background: var(--gold); transform: scaleX(0); transform-origin: left; transition: transform 0.45s var(--sanft); }
  .anliegen a:hover { transform: translateY(-3px); box-shadow: 0 22px 40px -28px rgba(30, 26, 35, 0.45); border-color: #d9cdbd; }
  .anliegen a:hover::after { transform: scaleX(1); }
  .symbol { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--tinte); color: var(--gold); }
  .symbol :global(svg) { width: 1.6rem; height: 1.6rem; }
  .frage { font: 500 clamp(1.3rem, 2vw, 1.5rem)/1.3 var(--serif); color: var(--tinte); }
  .anliegen .weiter { margin-top: auto; align-self: flex-start; }
  .weiter :global(svg) { width: 1.1rem; height: 1.1rem; }
  .anliegen li { animation: auftauchen 0.5s var(--sanft) both; }
  .anliegen .k1 { animation-delay: 0.12s; }
  .anliegen .k2 { animation-delay: 0.24s; }
  .anliegen :global(.strich) { animation: zeichnen 0.8s ease-out 0.25s both; }

  /* Leistungen */
  .leistungen { display: grid; gap: 3.5rem; }
  @media (min-width: 60rem) { .leistungen { grid-template-columns: 1fr 1fr; gap: 4.5rem; } }
  .leistung :global(figure) { padding: clamp(1.25rem, 3vw, 2rem); background: var(--tinte-2); border: 1px solid var(--tinte-3); border-radius: 4px; margin-bottom: 2rem; }
  .leistung p { color: var(--hell-leise); max-width: 34em; }

  /* Erfahrung */
  .erfahrung { padding-block: clamp(3rem, 6vw, 4.5rem); border-top: 1px solid var(--linie); }
  .klein { font: 500 1rem/1.5 var(--sans); color: var(--text-leise); letter-spacing: 0.01em; margin-bottom: 1.25rem; }
  .erfahrung ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem 2rem; }
  @media (min-width: 40rem) { .erfahrung ul { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .erfahrung ul { grid-template-columns: repeat(5, 1fr); } }
  .erfahrung li { padding-top: 0.9rem; border-top: 1px solid var(--gold); font: 500 1.12rem/1.35 var(--serif); color: var(--tinte); }
</style>
