---
import Basis from "../layouts/Basis.astro";
import Icon from "../components/Icon.astro";
import Portrait from "../components/Portrait.astro";
import Nachweise from "../components/Nachweise.astro";
import SzeneUebersetzung from "../components/SzeneUebersetzung.astro";
import SzeneDolmetschen from "../components/SzeneDolmetschen.astro";
import { u, mailLink, ERFAHRUNGEN, TELEFON_LINK, CLAIM } from "../daten";
// Startseite nach Jamils Hero-Konzept (Talk 3904). Nur Angaben der bestehenden Website.
---
<Basis>
  <section class="hero dunkel" aria-labelledby="hero-titel">
    <div class="huelle">
      <div class="oben" data-szene>
        <div class="text">
          <p class="badge"><Icon name="schild" /><span>Allgemein beeidigter Dolmetscher und ermächtigter Übersetzer</span></p>
          <h1 id="hero-titel">Beglaubigte Übersetzungen und Dolmetscher&shy;dienstleistungen für Deutsch und Türkisch</h1>
          <p class="sub">Allgemein beeidigter Dolmetscher und ermächtigter Übersetzer für die deutsche und türkische Sprache.</p>
          <div class="knoepfe">
            <a class="knopf haupt" href={mailLink("Anfrage: Übersetzung oder Dolmetschen")}>Anfrage senden</a>
            <a class="knopf rahmen" href={TELEFON_LINK}><Icon name="telefon" />Anrufen</a>
          </div>
          <ul class="vertrauen" aria-label="Auf einen Blick">
            <li><Icon name="haken" />Dolmetscher</li>
            <li><Icon name="haken" />Übersetzer</li>
            <li><Icon name="haken" />Deutsch und Türkisch</li>
          </ul>
        </div>
        <div class="bild"><Portrait /></div>
      </div>

      <!-- Sprachbrücke (Jamil Talk 3904): Goldlinie zeichnet sich beim Laden von links nach rechts, ca. 2 s -->
      <div class="bruecke" data-szene>
        <span class="sprache">Deutsch</span>
        <svg class="bogen" viewBox="0 0 600 60" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="strich" pathLength="1" d="M4 52 C 160 4, 440 4, 596 52" />
          <circle class="ende l" cx="4" cy="52" r="3.5" /><circle class="ende r" cx="596" cy="52" r="3.5" />
        </svg>
        <span class="sprache">Türkisch</span>
        <p class="claim">{CLAIM}</p>
      </div>

      <ul class="karten" data-szene>
        <li class="k0"><a href={u("/uebersetzungen/")}><span class="symbol"><Icon name="dokument" /></span><span class="titel">Beglaubigte Übersetzungen</span><Icon name="pfeil" /></a></li>
        <li class="k1"><a href={u("/dolmetschen/")}><span class="symbol"><Icon name="mikrofon" /></span><span class="titel">Dolmetschen</span><Icon name="pfeil" /></a></li>
        <li class="k2"><a href={u("/ueber-mich/")}>
          <span class="symbol sprachen" aria-hidden="true"><svg viewBox="0 0 44 24" focusable="false"><text x="0" y="16.5">DE</text><path d="M18.5 9.5h7m-2-2.5 2.5 2.5-2.5 2.5M25.5 14.5h-7m2-2.5-2.5 2.5 2.5 2.5" /><text x="28.5" y="16.5">TR</text></svg></span>
          <span class="titel">Deutsch und Türkisch</span><Icon name="pfeil" /></a></li>
      </ul>

      <a class="mehr" href="#leistungen"><span class="linie" aria-hidden="true"></span><span>↓ Mehr erfahren</span></a>
    </div>
  </section>

  <!-- Leistungen: Kerims eigene Sätze, je eine kleine Szene -->
  <section class="abschnitt" id="leistungen" aria-labelledby="leistungen-titel">
    <div class="huelle">
      <div class="kopfzeile">
        <h2 id="leistungen-titel">Übersetzen und Dolmetschen</h2>
        <p>Für die türkische und deutsche Sprache. Für Behörden, Gerichte und andere offizielle Stellen.</p>
      </div>
      <div class="leistungen">
        <article class="leistung">
          <SzeneUebersetzung />
          <h3>Beglaubigte Übersetzungen</h3>
          <p>Gerne übersetze ich für Sie Dokumente aller Art, wie zum Beispiel Gerichtsurteile, Zeugnisse, Personalausweise, medizinische Unterlagen und Urkunden.</p>
          <a class="weiter" href={u("/uebersetzungen/")}>Mehr zu Übersetzungen</a>
        </article>
        <article class="leistung">
          <SzeneDolmetschen />
          <h3>Dolmetschen</h3>
          <p>Es bereitet mir immer große Freude, wenn ich zu einem gelungenen Gespräch und zu gegenseitiger Verständigung beitragen kann.</p>
          <a class="weiter" href={u("/dolmetschen/")}>Mehr zum Dolmetschen</a>
        </article>
      </div>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="vertrauen-titel">
    <div class="huelle">
      <Nachweise>
        <h2 id="vertrauen-titel">Allgemein beeidigt und ermächtigt</h2>
        <a class="weiter" href={u("/ueber-mich/")}>Mehr über mich</a>
      </Nachweise>
    </div>
  </section>

  <section class="erfahrung" aria-labelledby="erfahrung-titel">
    <div class="huelle">
      <h2 id="erfahrung-titel" class="klein">Zu meinen bisherigen Erfahrungen gehört unter anderem die Arbeit mit</h2>
      <ul>
        {ERFAHRUNGEN.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>
</Basis>

<style>
  /* Hero: dunkler Verlauf Dunkelviolett → Anthrazit mit cremefarbenem Licht (Jamil Talk 3904) */
  .hero {
    position: relative; overflow: hidden; padding-block: clamp(2.75rem, 7vw, 5rem) clamp(1.5rem, 3vw, 2.25rem);
    background:
      radial-gradient(48rem 26rem at 78% 8%, rgba(243, 237, 228, 0.08), transparent 70%),
      linear-gradient(165deg, #241c2b 0%, #1e1a23 45%, #262428 100%);
  }
  .oben { display: grid; gap: 2.75rem; align-items: center; }
  @media (min-width: 62rem) { .oben { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 4.5rem; } }
  .badge {
    display: inline-flex; align-items: center; gap: 0.6rem; margin: 0 0 1.75rem; padding: 0.5rem 1rem 0.5rem 0.75rem;
    border: 1px solid var(--gold); border-radius: 999px; background: transparent; color: var(--hell);
    font-size: 0.92rem; line-height: 1.35; animation: auftauchen 0.8s var(--sanft) both;
  }
  .badge :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--gold); flex: none; }
  .hero h1 { font-size: clamp(2.05rem, 4vw, 3.35rem); line-height: 1.1; max-width: 15em; margin-bottom: 1.25rem; }
  .sub { font-size: clamp(1.08rem, 1.6vw, 1.25rem); color: var(--hell-leise); max-width: 34em; margin-bottom: 2rem; }
  .haupt { transition: background-color 0.25s ease, transform 0.25s var(--sanft); }
  .haupt:hover { background: var(--rot-hover); transform: scale(1.02); }
  .hero .knopf.rahmen { border-color: rgba(243, 237, 228, 0.55); }
  .vertrauen { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin: 1.75rem 0 0; padding: 0; color: var(--hell); font-size: 0.98rem; }
  .vertrauen li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .vertrauen :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--gold); }
  .bild { display: flex; justify-content: center; }

  /* Sprachbrücke */
  .bruecke {
    display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 0.5rem 1.25rem;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0; max-width: 56rem;
  }
  .sprache { font: 500 clamp(1.25rem, 2.4vw, 1.75rem)/1 var(--serif); color: var(--hell); padding-bottom: 0.15rem; }
  .bogen { width: 100%; height: clamp(2.5rem, 5vw, 3.75rem); overflow: visible; }
  .bogen path { fill: none; stroke: var(--gold); stroke-width: 1.6; vector-effect: non-scaling-stroke; animation: zeichnen 2s cubic-bezier(0.4, 0, 0.25, 1) both; }
  .ende { fill: var(--gold); }
  .ende.r { animation: einblenden 0.2s ease 1.85s both; }
  .claim {
    grid-column: 1 / -1; justify-self: center; margin: 0.9rem 0 0;
    font: italic 400 clamp(1.2rem, 2.2vw, 1.6rem)/1.3 var(--serif); color: var(--gold-hell); animation: einblenden 0.6s ease 1.5s both;
  }

  /* Drei Karten, nacheinander im Abstand von 0,2 s */
  .karten { list-style: none; margin: clamp(2.25rem, 4vw, 3rem) 0 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .karten { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .karten a {
    display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1.15rem 1.25rem; border-radius: 4px;
    background: rgba(243, 237, 228, 0.05); border: 1px solid rgba(243, 237, 228, 0.16); color: var(--hell); text-decoration: none;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  .karten a:hover { border-color: var(--gold); background: rgba(243, 237, 228, 0.08); }
  .karten .symbol { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid rgba(201, 163, 91, 0.7); color: var(--gold); }
  .karten .symbol :global(svg) { width: 1.45rem; height: 1.45rem; }
  .sprachen svg { width: 2.35rem !important; height: auto !important; overflow: visible; }
  .sprachen text { font: 600 11px var(--sans); fill: var(--hell); letter-spacing: 0.02em; }
  .sprachen path { fill: none; stroke: var(--gold); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .karten .titel { flex: 1; font: 500 1.2rem/1.25 var(--serif); }
  .karten a > :global(svg:last-child) { width: 1.1rem; height: 1.1rem; color: var(--gold); flex: none; }
  .karten li { animation: auftauchen 0.5s var(--sanft) both; }
  .karten .k0 { animation-delay: 0.3s; }
  .karten .k1 { animation-delay: 0.5s; }
  .karten .k2 { animation-delay: 0.7s; }

  /* Scroll-Indikator: goldene Linie, langsames Pulsieren (Jamils Wunsch; bei reduzierter Bewegung statisch) */
  .mehr { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; width: max-content; margin: clamp(2.25rem, 4vw, 3rem) auto 0; color: var(--hell-leise); text-decoration: none; font-size: 0.95rem; padding: 0.4rem 0.75rem; }
  .mehr .linie { width: 1px; height: 2.5rem; background: linear-gradient(var(--gold), rgba(201, 163, 91, 0)); }
  .mehr:hover { color: var(--gold-hell); }
  @media (prefers-reduced-motion: no-preference) {
    .mehr .linie { animation: pulsieren 2.8s ease-in-out 2.2s infinite; }
  }
  @keyframes pulsieren { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }

  /* Leistungen */
  .leistungen { display: grid; gap: 3.5rem; }
  @media (min-width: 60rem) { .leistungen { grid-template-columns: 1fr 1fr; gap: 4.5rem; } }
  .leistung :global(figure) { padding: clamp(1.25rem, 3vw, 2rem); background: var(--tinte); border-radius: 4px; margin-bottom: 2rem; }
  .leistung p { color: var(--text-leise); max-width: 34em; }

  /* Erfahrung */
  .erfahrung { padding-block: clamp(3rem, 6vw, 4.5rem); border-top: 1px solid var(--linie); }
  .klein { font: 500 1rem/1.5 var(--sans); color: var(--text-leise); letter-spacing: 0.01em; margin-bottom: 1.25rem; }
  .erfahrung ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem 2rem; }
  @media (min-width: 40rem) { .erfahrung ul { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .erfahrung ul { grid-template-columns: repeat(5, 1fr); } }
  .erfahrung li { padding-top: 0.9rem; border-top: 1px solid var(--gold); font: 500 1.12rem/1.35 var(--serif); color: var(--tinte); }
</style>
