---
import Basis from "../layouts/Basis.astro";
import Icon from "../components/Icon.astro";
import Nachweise from "../components/Nachweise.astro";
import Vertrauensband from "../components/Vertrauensband.astro";
import BildUebersetzung from "../components/BildUebersetzung.astro";
import BildDolmetschen from "../components/BildDolmetschen.astro";
import { u, mailLink, ERFAHRUNGEN, TELEFON_LINK, CLAIM, FRAGEN } from "../daten";
// Startseite v3d: Aufbau und Hero-Bewegung nach Bauwelt (Jamil Talk 3910), Hero-Inhalte aus Talk 3907,
// nur Angaben der bestehenden Website (Talk 3904).
// Bauwelt-Hero: Hintergrund zoomt einmal langsam (Ken Burns, 22 s), Inhalte steigen gestaffelt auf
// (rise 500 ms, Kurve 0.22/1/0.36/1, Verzögerung 0/120/220/360 ms), Scroll-Pfeil wippt einmal (2,2 s).
// Der Hero ist beim Laden immer sichtbar: reines CSS ohne Warte-Mechanismus (wie bei Bauwelt), spart Rechenzeit.
// Langsamer Zoom nur auf der Federkiel-Ebene (der große Verlauf als Zoom kostete am Handy über 1 s Blockierzeit).
const KIEL = "M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z";
const fragenStart = FRAGEN.slice(0, 3);
---
<Basis>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero-bg" aria-hidden="true">
      <svg class="kiel-gross" viewBox="0 0 58 66" focusable="false"><path d={KIEL} /></svg>
    </div>
    <div class="huelle hero-inhalt">
      <div class="text">
        <p class="badge auf" data-d="0"><Icon name="schild" /><span>Allgemein beeidigter Dolmetscher und ermächtigter Übersetzer</span></p>
        <h1 id="hero-titel" class="auf" data-d="1">Beglaubigte Übersetzungen und Dolmetscher&shy;dienstleistungen für Deutsch und Türkisch</h1>
        <p class="sub auf" data-d="2">Für Behörden, Gerichte und andere offizielle Stellen.</p>
        <div class="knoepfe auf" data-d="3">
          <a class="knopf haupt" href={mailLink("Anfrage: Übersetzung oder Dolmetschen")}>Anfrage senden</a>
          <a class="knopf rahmen" href={TELEFON_LINK}><Icon name="telefon" />Anrufen</a>
        </div>
        <ul class="vertrauen auf" data-d="4" aria-label="Auf einen Blick">
          <li><Icon name="haken" />Dolmetscher</li>
          <li><Icon name="haken" />Übersetzer</li>
          <li><Icon name="haken" />Deutsch und Türkisch</li>
        </ul>
      </div>

      <!-- Sprachbrücke: blendet ruhig ein (kein Zeichnen); alle 10 s gleitet ein Lichtpunkt von Deutsch nach Türkisch -->
      <figure class="bruecke auf" data-d="2">
        <svg viewBox="0 0 440 190" aria-hidden="true" focusable="false">
          <path class="deck" d="M20 150 H420" />
          <path class="bogen" d="M20 150 C 110 18, 330 18, 420 150" />
          <path class="licht" pathLength="1" d="M20 150 C 110 18, 330 18, 420 150" />
          <circle class="ende" cx="20" cy="150" r="4.5" /><circle class="ende" cx="420" cy="150" r="4.5" />
        </svg>
        <div class="ufer"><span>Deutsch</span><span>Türkisch</span></div>
        <figcaption class="claim">{CLAIM}.</figcaption>
      </figure>
    </div>

    <div class="huelle">
      <ul class="karten">
        <li class="k0"><a href={u("/uebersetzungen/")}><span class="symbol"><Icon name="dokument" /></span><span class="titel">Beglaubigte Übersetzungen</span><Icon name="pfeil" /></a></li>
        <li class="k1"><a href={u("/dolmetschen/")}><span class="symbol"><Icon name="mikrofon" /></span><span class="titel">Dolmetschen</span><Icon name="pfeil" /></a></li>
        <li class="k2"><a href={u("/ueber-mich/")}>
          <span class="symbol sprachen" aria-hidden="true"><svg viewBox="0 0 44 24" focusable="false"><text x="0" y="16.5">DE</text><path d="M18.5 9.5h7m-2-2.5 2.5 2.5-2.5 2.5M25.5 14.5h-7m2-2.5-2.5 2.5 2.5 2.5" /><text x="28.5" y="16.5">TR</text></svg></span>
          <span class="titel">Deutsch und Türkisch</span><Icon name="pfeil" /></a></li>
      </ul>
      <a class="mehr" href="#weiter"><span>Mehr erfahren</span><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg></a>
    </div>
  </section>

  <div id="weiter"></div>
  <Vertrauensband />

  <!-- Leistungen (Bauwelt: zentrierter Abschnittskopf mit goldener Kurzlinie, Karten im Raster) -->
  <section class="abschnitt" id="leistungen" aria-labelledby="leistungen-titel">
    <div class="huelle">
      <div class="section-head reveal">
        <span class="eyebrow">Leistungen</span>
        <h2 id="leistungen-titel" class="regel">Übersetzen und Dolmetschen</h2>
        <p>Für die türkische und deutsche Sprache.</p>
      </div>
      <div class="leistungen">
        <article class="karte leistung reveal">
          <BildUebersetzung />
          <h3>Beglaubigte Übersetzungen</h3>
          <p>Gerne übersetze ich für Sie Dokumente aller Art, wie zum Beispiel Gerichtsurteile, Zeugnisse, Personalausweise, medizinische Unterlagen und Urkunden.</p>
          <a class="weiter" href={u("/uebersetzungen/")}>Mehr zu Übersetzungen</a>
        </article>
        <article class="karte leistung reveal">
          <BildDolmetschen />
          <h3>Dolmetschen</h3>
          <p>Es bereitet mir immer große Freude, wenn ich zu einem gelungenen Gespräch und zu gegenseitiger Verständigung beitragen kann.</p>
          <a class="weiter" href={u("/dolmetschen/")}>Mehr zum Dolmetschen</a>
        </article>
      </div>
    </div>
  </section>

  <section class="abschnitt sand" aria-labelledby="vertrauen-titel">
    <div class="huelle">
      <Nachweise>
        <span class="eyebrow">Qualifikation</span>
        <h2 id="vertrauen-titel">Allgemein beeidigt und ermächtigt</h2>
        <a class="weiter" href={u("/ueber-mich/")}>Mehr über mich</a>
      </Nachweise>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="erfahrung-titel">
    <div class="huelle">
      <div class="section-head reveal">
        <span class="eyebrow">Erfahrung</span>
        <h2 id="erfahrung-titel" class="regel">Bisherige Erfahrungen</h2>
        <p>Zu meinen bisherigen Erfahrungen gehört unter anderem die Arbeit mit:</p>
      </div>
      <ul class="erfahrung reveal">
        {ERFAHRUNGEN.map((e) => <li class="karte">{e}</li>)}
      </ul>
    </div>
  </section>

  <!-- Häufige Fragen auf der Startseite wie bei Bauwelt -->
  <section class="abschnitt sand" aria-labelledby="fragen-titel">
    <div class="huelle schmal-mittig">
      <div class="section-head reveal">
        <span class="eyebrow">Häufige Fragen</span>
        <h2 id="fragen-titel" class="regel">Gut zu wissen</h2>
      </div>
      <div class="fragen reveal">
        {fragenStart.map((f) => (
          <details>
            <summary><span>{f.frage}</span><span class="zeichen" aria-hidden="true"></span></summary>
            <div class="antwort">{f.antwort.map((a) => <p>{a}</p>)}</div>
          </details>
        ))}
      </div>
      <p class="alle"><a class="knopf rahmen" href={u("/fragen/")}>Alle Fragen ansehen</a></p>
    </div>
  </section>
</Basis>

<style>
  /* ---------- Hero (Bauwelt-Aufbau, Beige statt Foto) ---------- */
  .hero {
    position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center;
    min-height: calc(100svh - var(--kopf-h)); padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(168deg, #e6d9c5 0%, #eee4d5 50%, #f5eee3 100%);
  }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .hero-bg::before {
    content: ""; position: absolute; inset: -10%;
    background: radial-gradient(40rem 26rem at 78% 22%, rgba(255, 253, 249, 0.85), transparent 70%), radial-gradient(30rem 22rem at 10% 90%, rgba(168, 128, 60, 0.12), transparent 70%);
  }
  .kiel-gross { position: absolute; right: -4rem; bottom: -6rem; width: clamp(18rem, 34vw, 30rem); fill: var(--logo); opacity: 0.045; animation: kenburns 22s ease-in-out 1 forwards; will-change: transform; }
  @keyframes kenburns { from { transform: scale(1) translateX(0); } to { transform: scale(1.08) translateX(-1.5%); } }

  .hero-inhalt { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 62rem) { .hero-inhalt { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 4rem; } }
  /* gestaffeltes Aufsteigen wie Bauwelt (.fhero__in) */
  .auf { animation: rise var(--dur-reveal) var(--ease) both; }
  .auf[data-d="1"] { animation-delay: 120ms; }
  .auf[data-d="2"] { animation-delay: 220ms; }
  .auf[data-d="3"] { animation-delay: 360ms; }
  .auf[data-d="4"] { animation-delay: 440ms; }
  /* Badge laut Jamil 3907: 0,8 s */
  .badge.auf { animation-duration: 0.8s; }

  .badge {
    display: inline-flex; align-items: center; gap: 0.6rem; margin: 0 0 1.5rem; padding: 0.5rem 1rem 0.5rem 0.75rem;
    border: 1px solid var(--gold); border-radius: 999px; color: var(--text); font-size: 0.95rem; line-height: 1.35;
  }
  .badge :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--gold-dunkel); flex: none; }
  .hero h1 { font-size: clamp(2.05rem, 3.9vw, 3.25rem); line-height: 1.15; max-width: 16em; margin-bottom: 1rem; }
  .sub { font-size: clamp(1.15rem, 1.7vw, 1.3rem); color: var(--text-leise); max-width: 34em; margin-bottom: 1.9rem; }
  .haupt { transition: background-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease); }
  .haupt:hover { background: var(--rot-hover); transform: scale(1.02); }
  .vertrauen { list-style: none; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; margin: 1.5rem 0 0; padding: 0; color: var(--text); font-weight: 600; font-size: 1rem; }
  .vertrauen li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .vertrauen :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--gold-dunkel); }

  .bruecke { margin: 0; width: 100%; max-width: 34rem; justify-self: center; }
  .bruecke svg { width: 100%; height: auto; overflow: visible; }
  .bogen { fill: none; stroke: var(--gold); stroke-width: 2.2; stroke-linecap: round; }
  .deck { fill: none; stroke: var(--gold); stroke-width: 1; opacity: 0.6; }
  .ende { fill: var(--gold); }
  .licht {
    fill: none; stroke: #fffdf6; stroke-width: 6; stroke-linecap: round; stroke-dasharray: 0.001 2; stroke-dashoffset: 0.001; opacity: 0;
    animation: lichtpunkt 10s linear 1.5s infinite;
  }
  /* kein Zeichnen: nur ein heller Punkt gleitet alle 10 s einmal über den Bogen (1,6 s), sonst Ruhe */
  @keyframes lichtpunkt {
    0% { stroke-dashoffset: 0.001; opacity: 0; }
    2% { opacity: 1; }
    16% { stroke-dashoffset: -1; opacity: 1; }
    17%, 100% { stroke-dashoffset: -1; opacity: 0; }
  }
  .ufer { display: flex; justify-content: space-between; margin-top: -0.3rem; font: 600 clamp(1.4rem, 2.6vw, 1.9rem)/1 var(--serif); color: var(--text); }
  .claim { margin: 1.25rem 0 0; text-align: center; font: italic 500 clamp(1.15rem, 2vw, 1.45rem)/1.35 var(--serif); color: var(--gold-dunkel); }

  /* Drei Karten (Jamil 3907): nacheinander im Abstand von 0,15 s; Hover: Schatten, 3 px, goldener Rand */
  .karten { list-style: none; margin: clamp(2.5rem, 5vw, 3.25rem) 0 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .karten { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .karten a {
    display: flex; align-items: center; gap: 1rem; height: 100%; padding: 1.1rem 1.25rem; border-radius: 16px;
    background: rgba(255, 253, 249, 0.75); border: 1px solid var(--tinte-3); color: var(--text); text-decoration: none;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) ease;
  }
  .karten a:hover { transform: translateY(-3px); box-shadow: 0 16px 30px -20px rgba(43, 36, 31, 0.45); border-color: var(--gold); }
  .karten .symbol { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold-dunkel); }
  .karten .symbol :global(svg) { width: 1.45rem; height: 1.45rem; }
  .sprachen svg { width: 2.35rem !important; height: auto !important; overflow: visible; }
  .sprachen text { font: 700 11px var(--sans); fill: var(--text); }
  .sprachen path { fill: none; stroke: var(--gold-dunkel); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .karten .titel { flex: 1; font: 600 1.15rem/1.3 var(--serif); }
  .karten a > :global(svg:last-child) { width: 1.1rem; height: 1.1rem; color: var(--gold-dunkel); flex: none; }
  .karten li { animation: rise var(--dur-reveal) var(--ease) both; }
  .karten .k0 { animation-delay: 500ms; }
  .karten .k1 { animation-delay: 650ms; }
  .karten .k2 { animation-delay: 800ms; }

  /* Scroll-Hinweis wie Bauwelt: wippt einmal (2,2 s) */
  .mehr { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; width: max-content; margin: clamp(1.75rem, 3vw, 2.5rem) auto 0; color: var(--text-leise); text-decoration: none; font-size: 0.95rem; padding: 0.3rem 0.75rem; animation: nudge 2.2s ease-in-out 1s 1 both; }
  .mehr svg { width: 1.6rem; height: 1.6rem; fill: none; stroke: var(--gold-dunkel); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .mehr:hover { color: var(--gold-dunkel); }

  /* ---------- Abschnitte ---------- */
  .sand { background: var(--sand); }
  .leistungen { display: grid; gap: 1.5rem; }
  @media (min-width: 56rem) { .leistungen { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  .leistung :global(figure) { margin: -0.5rem 0 2.75rem; }
  .leistung p { color: var(--text-leise); }
  .erfahrung { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 40rem) { .erfahrung { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .erfahrung { grid-template-columns: repeat(3, 1fr); } }
  .erfahrung li { font: 600 1.1rem/1.4 var(--serif); color: var(--tinte); border-top: 3px solid var(--gold); }
  .schmal-mittig { max-width: 52rem; }
  .fragen { border-top: 1px solid var(--tinte-3); }
  details { border-bottom: 1px solid var(--tinte-3); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.25rem 0; cursor: pointer; list-style: none; font: 600 1.2rem/1.35 var(--serif); color: var(--tinte); }
  summary::-webkit-details-marker { display: none; }
  .zeichen { position: relative; flex: none; width: 2rem; height: 2rem; border: 1px solid var(--gold); border-radius: 50%; }
  .zeichen::before, .zeichen::after { content: ""; position: absolute; left: 50%; top: 50%; width: 0.8rem; height: 1.5px; background: var(--tinte); transform: translate(-50%, -50%); transition: transform 0.3s var(--ease); }
  .zeichen::after { transform: translate(-50%, -50%) rotate(90deg); }
  details[open] .zeichen::after { transform: translate(-50%, -50%) rotate(0deg); }
  .antwort { padding: 0 3rem 1.25rem 0; }
  .alle { text-align: center; margin: 2rem 0 0; }
</style>
