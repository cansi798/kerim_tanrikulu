---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Platzhalter from "../components/Platzhalter.astro";
import Ablauf from "../components/Ablauf.astro";
import { DOKUMENTE, HONORAR, GERICHT, SEIT, u } from "../daten";
---
<Basis titel="Beglaubigte Übersetzungen Türkisch Deutsch" beschreibung="Beglaubigte Übersetzungen Türkisch und Deutsch vom ermächtigten Übersetzer Kerim Mikael Tanrikulu: Gerichtsurteile, Scheidungsurteile, Zeugnisse, Ausweise, medizinische Unterlagen und Urkunden. Honorar nach JVEG.">
  <SeitenKopf titel="Beglaubigte Übersetzungen">
    <p class="lead">Ihr Dokument muss bei einer Behörde oder einem Gericht eingereicht werden? Ich übersetze es aus dem Türkischen ins Deutsche oder aus dem Deutschen ins Türkische.</p>
  </SeitenKopf>

  <section class="abschnitt" aria-labelledby="was-titel">
    <div class="huelle rand-raster">
      <h2 id="was-titel">Was eine beglaubigte Übersetzung ist</h2>
      <div>
        <p>Ich bin seit {SEIT} durch das {GERICHT} als Übersetzer ermächtigt. Damit kann ich schriftlich bestätigen, dass meine Übersetzung richtig und vollständig ist. Eine solche Übersetzung nennt man beglaubigte Übersetzung.</p>
        <p>Ob Sie für Ihr Dokument eine beglaubigte Übersetzung brauchen, legt die Stelle fest, bei der Sie es einreichen. Fragen Sie dort im Zweifel nach, welche Form verlangt wird.</p>
        <Platzhalter>Wortlaut zur Ermächtigung und Beglaubigung bitte vom Kunden bestätigen lassen (z. B. wie der Bestätigungsvermerk aussieht).</Platzhalter>
      </div>
    </div>
  </section>

  <section class="abschnitt pergament" aria-labelledby="dok-titel">
    <div class="huelle rand-raster">
      <h2 id="dok-titel">Häufig übersetzte Dokumente</h2>
      <div>
        <p>Gerne übersetze ich für Sie Dokumente aller Art, zum Beispiel:</p>
        <ul class="strichliste gross">
          {DOKUMENTE.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="ablauf-titel">
    <div class="huelle">
      <h2 id="ablauf-titel">So läuft eine Anfrage ab</h2>
      <div class="ablauf-platz">
        <Ablauf schritte={[
          { titel: "Dokument senden", text: "Schicken Sie mir das Dokument und schreiben Sie dazu, wofür Sie die Übersetzung brauchen." },
          { titel: "Anfrage prüfen", text: "Ich sehe mir das Dokument und Ihre Angaben an." },
          { titel: "Rückmeldung erhalten", text: "Sie hören von mir, wie es weitergeht." },
        ]} />
        <Platzhalter>Sicherer Weg für Dokumente (z. B. verschlüsselter Upload statt einfacher E-Mail) folgt nach Absprache mit dem Kunden. Ablauf bitte vom Kunden bestätigen.</Platzhalter>
      </div>
    </div>
  </section>

  <section class="abschnitt pergament" aria-labelledby="honorar-titel">
    <div class="huelle rand-raster">
      <h2 id="honorar-titel">Honorar</h2>
      <div>
        <p>{HONORAR}</p>
        <p>Antworten auf weitere Fragen finden Sie unter <a href={u("/fragen/")}>Häufige Fragen</a>.</p>
      </div>
    </div>
  </section>
</Basis>
<style>
  .gross li { font: 400 1.45rem/1.35 var(--caslon); color: var(--tinte); margin-bottom: 0.7rem; }
  .gross li::before { top: 0.8em; }
  .ablauf-platz { margin-top: 2.5rem; }
</style>
