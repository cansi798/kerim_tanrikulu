---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import SzeneUebersetzung from "../components/SzeneUebersetzung.astro";
import Platzhalter from "../components/Platzhalter.astro";
import Icon from "../components/Icon.astro";
import { HONORAR, GERICHT, SEIT, TELEFON_LINK, mailLink, u } from "../daten";
// Dokumentarten wörtlich nach der Jimdo-Seite („Dokumente aller Art, wie zum Beispiel …“), je mit Symbol
const dokumente = [
  { icon: "urteil", text: "Gerichtsurteile, darunter auch Scheidungsurteile" },
  { icon: "zeugnis", text: "Zeugnisse" },
  { icon: "ausweis", text: "Personalausweise" },
  { icon: "medizin", text: "medizinische Unterlagen" },
  { icon: "urkunde", text: "Urkunden" },
] as const;
---
<Basis titel="Beglaubigte Übersetzungen Türkisch Deutsch" beschreibung="Beglaubigte Übersetzungen Türkisch und Deutsch vom ermächtigten Übersetzer Kerim Mikael Tanrikulu: Gerichtsurteile, Scheidungsurteile, Zeugnisse, Personalausweise, medizinische Unterlagen und Urkunden. Honorar nach JVEG.">
  <SeitenKopf titel="Beglaubigte Übersetzungen" zeile="Türkisch und Deutsch">
    <p class="lead">Ihr Dokument muss bei einer Behörde, einem Gericht oder einer anderen offiziellen Stelle eingereicht werden? Gerne übersetze ich für Sie Dokumente aller Art.</p>
    <SzeneUebersetzung slot="bild" />
  </SeitenKopf>

  <section class="abschnitt" aria-labelledby="dok-titel">
    <div class="huelle">
      <div class="kopfzeile">
        <h2 id="dok-titel">Dokumente aller Art</h2>
        <p>Zum Beispiel:</p>
      </div>
      <ul class="dokumente" data-szene>
        {dokumente.map((d, i) => (
          <li class={`d${i}`}><span class="symbol"><Icon name={d.icon} zeichnen /></span><span>{d.text}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="was-titel">
    <div class="huelle raster-2">
      <h2 id="was-titel">Ermächtigter Übersetzer</h2>
      <div>
        <p class="lead">Seit {SEIT} bin ich durch das {GERICHT} als Übersetzer für die türkische und deutsche Sprache ermächtigt.</p>
        <Platzhalter>Wortlaut zur Ermächtigung und Beglaubigung bitte vom Kunden bestätigen lassen (z. B. wie der Bestätigungsvermerk aussieht).</Platzhalter>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="anfrage-titel">
    <div class="huelle raster-2">
      <h2 id="anfrage-titel">Anfrage</h2>
      <div>
        <p class="lead">Rufen Sie mich an oder senden Sie mir eine Anfrage per E-Mail.</p>
        <div class="knoepfe">
          <a class="knopf" href={mailLink("Anfrage: Übersetzung")}>Anfrage senden</a>
          <a class="knopf rahmen" href={TELEFON_LINK}>Anrufen</a>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt weiss honorar" aria-labelledby="honorar-titel">
    <div class="huelle raster-2">
      <h2 id="honorar-titel">Honorar</h2>
      <div>
        <p class="lead">{HONORAR}</p>
        <a class="weiter" href={u("/fragen/")}>Häufige Fragen</a>
      </div>
    </div>
  </section>
</Basis>
<style>
  .dokumente { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 40rem) { .dokumente { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .dokumente { grid-template-columns: repeat(5, 1fr); } }
  .dokumente li {
    display: flex; flex-direction: column; gap: 1.1rem; padding: 1.5rem; background: var(--weiss); border: 1px solid var(--linie); border-radius: 4px;
    font: 500 1.2rem/1.3 var(--serif); color: var(--tinte); animation: auftauchen 0.45s var(--sanft) both;
  }
  @media (max-width: 39.99rem) { .dokumente li { flex-direction: row; align-items: center; } }
  .symbol { display: grid; place-items: center; flex: none; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--tinte); color: var(--gold); }
  .symbol :global(svg) { width: 1.6rem; height: 1.6rem; }
  .dokumente :global(.strich) { animation: zeichnen 0.8s ease-out 0.2s both; }
  .dokumente .d1 { animation-delay: 0.1s; }
  .dokumente .d2 { animation-delay: 0.2s; }
  .dokumente .d3 { animation-delay: 0.3s; }
  .dokumente .d4 { animation-delay: 0.4s; }
  .honorar { border-top: 1px solid var(--linie); }
</style>
