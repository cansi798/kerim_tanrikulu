---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Platzhalter from "../components/Platzhalter.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { TELEFON, TELEFON_LINK, MAIL, mailLink, ORT, NAME, DOLMETSCHER, UEBERSETZER } from "../daten";
---
<Basis titel="Kontakt" beschreibung="Kontakt zu Kerim Mikael Tanrikulu, Dolmetscher und Übersetzer für Türkisch und Deutsch in Hamburg: Telefon und E-Mail." aufruf={false}>
  <SeitenKopf titel="Kontakt">
    <p class="lead">Haben Sie Fragen oder möchten Sie eine Übersetzung oder einen Dolmetscher anfragen? Rufen Sie an oder schreiben Sie mir eine E-Mail.</p>
  </SeitenKopf>

  <section class="abschnitt" aria-label="Kontaktwege">
    <div class="huelle karte-raster">
      <!-- wie eine Visitenkarte: alle Kontaktwege auf einen Blick -->
      <div class="karte">
        <Logo klein />
        <p class="name">{NAME}</p>
        <p class="titel">{DOLMETSCHER} und {UEBERSETZER} für Deutsch und Türkisch</p>
        <ul class="wege">
          <li><a href={TELEFON_LINK}><Icon name="telefon" /><span class="art">Telefon</span><span class="wert">{TELEFON}</span></a></li>
          <li><a href={mailLink()}><Icon name="mail" /><span class="art">E-Mail</span><span class="wert">{MAIL}</span></a></li>
          <li><span class="ohne"><Icon name="ort" /><span class="art">Standort</span><span class="wert">{ORT}</span></span></li>
        </ul>
      </div>
      <div class="knoepfe breit">
        <a class="knopf" href={TELEFON_LINK}><Icon name="telefon" />Anrufen</a>
        <a class="knopf zweit" href={mailLink()}><Icon name="mail" />E-Mail schreiben</a>
      </div>
    </div>
  </section>

  <section class="abschnitt pergament" aria-labelledby="nachricht-titel">
    <div class="huelle rand-raster">
      <h2 id="nachricht-titel">Was in Ihre Nachricht gehört</h2>
      <div>
        <h3>Für eine Übersetzung</h3>
        <ul class="strichliste">
          <li>um welches Dokument es geht</li>
          <li>wofür Sie die Übersetzung brauchen, zum Beispiel für eine Behörde oder ein Gericht</li>
          <li>ob aus dem Türkischen ins Deutsche oder umgekehrt</li>
        </ul>
        <h3>Für einen Dolmetscher</h3>
        <ul class="strichliste">
          <li>Datum, Uhrzeit und Ort des Termins</li>
          <li>um welche Art von Termin es geht und wie lange er ungefähr dauert</li>
        </ul>
        <p>Das weitere individuelle Vorgehen teile ich Ihnen gerne in einem persönlichen Gespräch mit.</p>
        <Platzhalter>Hinweis zum sicheren Versand von Dokumenten (z. B. verschlüsselter Upload) folgt nach Absprache mit dem Kunden. Bis dahin kein Upload und kein Formular mit Fremddienst.</Platzhalter>
      </div>
    </div>
  </section>
</Basis>
<style>
  .karte-raster { display: grid; gap: 2rem; justify-items: start; }
  /* am Handy übernimmt die feste Leiste unten Anrufen/E-Mail */
  .breit { display: none; }
  @media (min-width: 60rem) { .breit { display: flex; } }
  .karte {
    width: min(100%, 38rem); padding: clamp(1.5rem, 5vw, 2.75rem);
    background: var(--papier); border: 1px solid var(--linie); outline: 1px solid var(--linie); outline-offset: -8px;
    box-shadow: 0 24px 48px -28px rgba(43, 39, 33, 0.35);
  }
  .name { font: 400 clamp(1.6rem, 3.5vw, 2rem)/1.2 var(--caslon); color: var(--tinte); margin: 1.75rem 0 0.25rem; }
  .titel { color: var(--text-leise); margin-bottom: 1.5rem; }
  .wege { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--messing); }
  .wege a, .wege .ohne {
    display: grid; grid-template-columns: auto 1fr; gap: 0 0.9rem; align-items: center;
    padding: 0.85rem 0; border-bottom: 1px solid var(--linie); color: var(--text); text-decoration: none;
  }
  .wege li:last-child a, .wege li:last-child .ohne { border-bottom: 0; }
  .wege :global(svg) { grid-row: span 2; width: 1.35rem; height: 1.35rem; color: var(--messing); }
  .art { font-size: 0.88rem; color: var(--text-leise); letter-spacing: 0.03em; }
  .wert { font: 400 1.35rem/1.3 var(--caslon); color: var(--tinte); overflow-wrap: anywhere; }
  .wege a:hover .wert { text-decoration: underline; text-decoration-color: var(--messing); text-underline-offset: 0.2em; }
</style>
