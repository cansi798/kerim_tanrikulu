---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Platzhalter from "../components/Platzhalter.astro";
import Luecke from "../components/Luecke.astro";
import Icon from "../components/Icon.astro";
import { TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, MAIL, mailLink, ORT } from "../daten";
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
---
<Basis titel="Kontakt" beschreibung="Kontakt zu Kerim Mikael Tanrikulu, Dolmetscher und Übersetzer für Türkisch und Deutsch in Hamburg: Telefon und E-Mail." aufruf={false}>
  <SeitenKopf titel="Kontakt">
    <p class="lead">Haben Sie Fragen oder möchten Sie eine Übersetzung oder einen Dolmetscher anfragen? Rufen Sie an oder schreiben Sie mir eine E-Mail.</p>
  </SeitenKopf>

  <section class="abschnitt" aria-label="Kontaktwege">
    <div class="huelle">
      <ul class="wege" data-szene>
        <li class="w0">
          <a href={TELEFON_LINK}>
            <span class="symbol"><Icon name="telefon" zeichnen /></span>
            <span class="art">Anrufen</span>
            <span class:list={["wert", { unbestaetigt: markieren }]}>{TELEFON}</span>
            {markieren && <span class="hinweis"><Luecke>Nummer bitte bestätigen</Luecke></span>}
          </a>
        </li>
        <li class="w1">
          <a href={mailLink()}>
            <span class="symbol"><Icon name="mail" zeichnen /></span>
            <span class="art">E-Mail schreiben</span>
            <span class="wert">{MAIL}</span>
          </a>
        </li>
        <li class="w2">
          <div>
            <span class="symbol"><Icon name="ort" zeichnen /></span>
            <span class="art">Standort</span>
            <span class="wert">{ORT}</span>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="abschnitt weiss" aria-label="Hinweis zur Anfrage">
    <div class="huelle">
      <p class="lead schluss">Das weitere individuelle Vorgehen teile ich Ihnen gerne in einem persönlichen Gespräch mit.</p>
      <Platzhalter>Die bisherige Website hat ein Kontaktformular. Ob und wie es hier wieder eingebaut wird (eigener Versand, Spamschutz, Datenschutz), klären wir mit dem Kunden.</Platzhalter>
    </div>
  </section>
</Basis>
<style>
  .wege { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .wege { grid-template-columns: 1.15fr 1.15fr 0.9fr; gap: 1.5rem; } }
  .wege a, .wege div {
    display: flex; flex-direction: column; gap: 0.35rem; height: 100%; padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 4px; text-decoration: none; color: var(--text); background: var(--sand); border: 1px solid var(--tinte-3);
  }
  .wege a { transition: transform 0.35s var(--sanft), box-shadow 0.35s var(--sanft); }
  .wege a:hover { transform: translateY(-3px); box-shadow: 0 22px 36px -26px rgba(43, 36, 31, 0.45); border-color: var(--gold); }
  .wege .w2 div { background: var(--weiss); color: var(--tinte); border: 1px solid var(--linie); }
  .symbol { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; border: 1px solid var(--gold); color: var(--gold-dunkel); margin-bottom: 1rem; }
  .w2 .symbol { color: var(--gold-dunkel); border-color: var(--gold); }
  .symbol :global(svg) { width: 1.5rem; height: 1.5rem; }
  .art { font-size: 0.95rem; color: var(--hell-leise); }
  .w2 .art { color: var(--text-leise); }
  .wert { font: 500 clamp(1.3rem, 2.2vw, 1.6rem)/1.3 var(--sans); overflow-wrap: anywhere; }
  .hinweis { margin-top: 0.5rem; font-size: 0.85rem; }
  .wege li { animation: auftauchen 0.45s var(--sanft) both; }
  .wege .w1 { animation-delay: 0.12s; }
  .wege .w2 { animation-delay: 0.24s; }
  .wege :global(.strich) { animation: zeichnen 0.8s ease-out 0.2s both; }
  .schluss { margin: 0; max-width: 46rem; }
</style>
