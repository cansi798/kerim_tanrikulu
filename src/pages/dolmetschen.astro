---
import Basis from "../layouts/Basis.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import SzeneDolmetschen from "../components/SzeneDolmetschen.astro";
import Platzhalter from "../components/Platzhalter.astro";
import { ERFAHRUNGEN, HONORAR, GERICHT, SEIT, TELEFON_LINK, mailLink, u } from "../daten";
---
<Basis titel="Dolmetscher Türkisch Deutsch" beschreibung="Allgemein beeidigter Dolmetscher für Türkisch und Deutsch: Kerim Mikael Tanrikulu, beeidigt durch das Oberlandesgericht Schleswig seit Mai 2021, Hamburg.">
  <SeitenKopf titel="Dolmetschen" zeile="Türkisch und Deutsch">
    <p class="lead">Es bereitet mir immer große Freude, wenn ich zu einem gelungenen Gespräch und zu gegenseitiger Verständigung beitragen kann.</p>
    <SzeneDolmetschen slot="bild" />
  </SeitenKopf>

  <section class="abschnitt" aria-labelledby="beeidigt-titel">
    <div class="huelle raster-2">
      <h2 id="beeidigt-titel">Allgemein beeidigt</h2>
      <div>
        <p class="lead">Seit {SEIT} bin ich durch das {GERICHT} als Dolmetscher für die türkische und deutsche Sprache allgemein beeidigt.</p>
      </div>
    </div>
  </section>

  <section class="abschnitt weiss" aria-labelledby="anfrage-titel">
    <div class="huelle raster-2">
      <h2 id="anfrage-titel">Anfrage</h2>
      <div>
        <p class="lead">Rufen Sie mich an oder senden Sie mir eine Anfrage per E-Mail.</p>
        <div class="knoepfe">
          <a class="knopf" href={mailLink("Anfrage: Dolmetschen")}>Anfrage senden</a>
          <a class="knopf rahmen" href={TELEFON_LINK}>Anrufen</a>
        </div>
        <p class="honorar leise">{HONORAR}</p>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="erfahrung-titel">
    <div class="huelle raster-2">
      <h2 id="erfahrung-titel">Bisherige Erfahrungen</h2>
      <div>
        <p>Zu meinen bisherigen Erfahrungen gehört unter anderem die Arbeit mit:</p>
        <ul class="strichliste">
          {ERFAHRUNGEN.map((e) => <li>{e}</li>)}
        </ul>
        <Platzhalter>Typische Einsätze und Einsatzgebiet bitte vom Kunden nennen lassen. Bis dahin steht hier nur, was auf der bisherigen Website steht.</Platzhalter>
        <p class="mt"><a class="weiter" href={u("/ueber-mich/")}>Mehr über mich</a></p>
      </div>
    </div>
  </section>
</Basis>
<style>
  .honorar { margin: 2rem 0 0; max-width: 46rem; }
  .mt { margin-top: 1.5rem; }
</style>
