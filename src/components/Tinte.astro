---
// Tinten-Notiz mit rough.js (Can 31.10.2026): edle Feder-Handschrift statt Comic.
// rough.js läuft NUR beim Bauen (rough.generator braucht kein DOM, fester Seed) – im Browser liegt nur fertiges SVG,
// also 0 KB Skript (Bauwelt-Muster). Niedrige roughness (0,7–1,0), ein einziger feiner Strich, Navy-Tinte aus dem Logo oder Gold.
// Bewegung: zieht sich einmal (0,6–1,0 s), sobald der umgebende [data-szene]-Bereich sichtbar ist (global.css pausiert bis dahin).
// Ohne JS: läuft einmal beim Laden. „Bewegung reduzieren“: sofort fertig.
// Jamil Talk 3910 („ruhig-elegant, nicht gezeichnet“): darum nur einzelne Notizen an wenigen Stellen, nie flächige Zeichnungen.
import rough from "roughjs";

type Art = "strich" | "kreis" | "rahmen" | "pfeil" | "klammer";
interface Props {
  art: Art;
  /** viewBox-Breite und -Höhe; Höhe möglichst = Pixelhöhe im Layout, damit die Strichstärke stimmt */
  b?: number;
  h?: number;
  seed?: number;
  farbe?: "tinte" | "gold";
  /** Startverzögerung in Schritten zu 0,15 s */
  v?: number;
  dauer?: "kurz" | "mittel" | "lang";
  staerke?: number;
  class?: string;
}
const { art, b = 200, h = 12, seed = 3, farbe = "tinte", v = 0, dauer = "mittel", staerke = 1.5, class: klasse } = Astro.props;

const gen = rough.generator();
const basis = { seed, roughness: 0.8, bowing: 0.7, strokeWidth: staerke, disableMultiStroke: true, preserveVertices: false };
const n = (x: number) => Math.round(x * 10) / 10;
const zeichnungen = [] as ReturnType<typeof gen.curve>[];

if (art === "strich") {
  // leicht ansteigender Federstrich, Ende etwas dünner wirkend durch Kurve
  zeichnungen.push(gen.curve([[2, h * 0.62], [b * 0.3, h * 0.48], [b * 0.66, h * 0.6], [b - 2, h * 0.36]], basis));
} else if (art === "kreis") {
  // Handkreis: gut eine Umdrehung mit leichtem Überschwung, beginnt links oben
  const cx = b / 2, cy = h / 2, rx = b / 2 - 3, ry = h / 2 - 3;
  const punkte: [number, number][] = [];
  for (let i = 0; i <= 26; i++) {
    const w = Math.PI * 1.15 + (i / 24) * Math.PI * 2.12;
    const f = 1 + (i / 26) * 0.05;
    punkte.push([n(cx + Math.cos(w) * rx * f), n(cy + Math.sin(w) * ry * (1.02 - (i / 26) * 0.08))]);
  }
  zeichnungen.push(gen.curve(punkte, { ...basis, roughness: 0.6 }));
} else if (art === "rahmen") {
  zeichnungen.push(gen.rectangle(4, 4, b - 8, h - 8, { ...basis, roughness: 0.9, bowing: 1 }));
} else if (art === "pfeil") {
  const y = h / 2, l = 10, r = b - 10, k = Math.min(10, h / 2 - 2);
  zeichnungen.push(gen.curve([[l, y + 1], [b * 0.35, y - 3], [b * 0.65, y + 2], [r, y - 1]], basis));
  zeichnungen.push(gen.linearPath([[r - k * 1.2, y - k], [r, y - 1], [r - k * 1.1, y + k * 0.9]], { ...basis, roughness: 0.5 }));
  zeichnungen.push(gen.linearPath([[l + k * 1.2, y - k * 0.9], [l, y + 1], [l + k * 1.1, y + k]], { ...basis, roughness: 0.5 }));
} else if (art === "klammer") {
  zeichnungen.push(gen.curve([[b - 2, 3], [3, h * 0.08], [5, h * 0.5], [3, h * 0.92], [b - 2, h - 3]], { ...basis, roughness: 0.6 }));
}

// Jede Teilstrecke einzeln mit pathLength=1, damit sie sich sauber von Anfang bis Ende zieht
const teile: string[] = [];
for (const z of zeichnungen) {
  for (const set of z.sets) {
    if (set.type !== "path") continue;
    gen.opsToPath(set, 1).split(/(?=M)/).map((s) => s.trim()).filter(Boolean).forEach((d) => teile.push(d));
  }
}
const html = teile.map((d, i) => `<path class="t${Math.min(i, 4)}" pathLength="1" d="${d}" stroke-width="${staerke}"/>`).join("");
---
<svg
  class:list={["tinte", `tinte-${art}`, farbe, `v${v}`, dauer, klasse]}
  viewBox={`0 0 ${b} ${h}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
  set:html={html}
/>
