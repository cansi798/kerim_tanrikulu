---
// Hero-Zeichnung: Die Feder aus dem Logo schreibt eine Brücke von „Deutsch“ nach „Türkçe“.
// Bild aus Kerims eigenen Worten („Brückenbildung zwischen den Kulturen“, Jimdo-Seite); Feder-Animation auf Jamils Wunsch (Talk 3889).
// Ablauf einmalig, ca. 3,4 s: Fahrbahn und Pfeiler, dann zieht die Feder das Tragseil, „Türkçe“ erscheint, wenn sie ankommt.
// Ohne JavaScript. Feder und Tragseil laufen beide als SVG-Animation (gleiche Uhr, damit die Feder genau an der Linienspitze bleibt). Bei reduzierter Bewegung: sofort das fertige Bild, keine Feder.
const SEIL = "M0 166 Q 140 150 250 40 Q 500 240 750 40 Q 860 150 1000 166";

// Hänger: Punkte auf dem Tragseil (quadratische Bézierkurven) abtasten, senkrecht zur Fahrbahn
type P = [number, number];
const quad = (a: P, c: P, b: P, t: number): P => [
  (1 - t) ** 2 * a[0] + 2 * t * (1 - t) * c[0] + t ** 2 * b[0],
  (1 - t) ** 2 * a[1] + 2 * t * (1 - t) * c[1] + t ** 2 * b[1],
];
const stuecke: [P, P, P][] = [
  [[0, 166], [140, 150], [250, 40]],
  [[250, 40], [500, 240], [750, 40]],
  [[750, 40], [860, 150], [1000, 166]],
];
const punkte: P[] = stuecke.flatMap(([a, c, b]) => Array.from({ length: 400 }, (_, i) => quad(a, c, b, i / 399)));
const yBei = (x: number) => punkte.reduce((best, p) => (Math.abs(p[0] - x) < Math.abs(best[0] - x) ? p : best))[1];
const haenger = [];
for (let x = 40; x <= 960; x += 34) {
  if (Math.abs(x - 250) < 14 || Math.abs(x - 750) < 14) continue;
  const y = yBei(x);
  if (170 - y > 8) haenger.push(`M${x} ${y.toFixed(1)}V170`);
}
---
<div class="bruecke" aria-hidden="true">
  <svg viewBox="0 -60 1000 260" focusable="false">
    <g class="pfeiler">
      <path d="M244 30V190 M256 30V190 M744 30V190 M756 30V190" />
      <path class="riegel" d="M244 72H256 M744 72H756" />
    </g>
    <path class="fahrbahn" pathLength="1" d="M0 170H1000" />
    <path class="fahrbahn unten" pathLength="1" d="M0 177H1000" />
    <path class="haenger" d={haenger.join(" ")} opacity="0">
      <animate attributeName="opacity" values="0;1" dur="0.8s" begin="2.7s" fill="freeze" />
    </path>
    <path class="seil" pathLength="1" d={SEIL} stroke-dasharray="1" stroke-dashoffset="1">
      <animate attributeName="stroke-dashoffset" values="1;0" dur="2s" begin="1s" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines=".45 .05 .25 1" />
    </path>
    <g class="feder" opacity="0">
      <g transform="translate(-5 -62)">
        <path class="fahne" d="M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z" />
        <path class="schaft" d="M5 62 L 46 11" />
      </g>
      <animateMotion dur="2s" begin="1s" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines=".45 .05 .25 1" path={SEIL} />
      <animate attributeName="opacity" values="0;1" dur="0.3s" begin="0.75s" fill="freeze" />
      <animate attributeName="opacity" values="1;0" dur="0.5s" begin="3.1s" fill="freeze" />
    </g>
  </svg>
  <div class="ufer">
    <span class="de">Deutsch</span>
    <span class="tr" lang="tr">Türkçe</span>
  </div>
</div>
<style>
  .bruecke { width: 100%; }
  svg { width: 100%; height: auto; overflow: visible; }
  .pfeiler path { fill: none; stroke: var(--tinte); stroke-width: 2; }
  .pfeiler .riegel { stroke-width: 2; }
  .fahrbahn { fill: none; stroke: var(--tinte); stroke-width: 2; }
  .fahrbahn.unten { stroke: var(--messing); stroke-width: 1.2; }
  .haenger { fill: none; stroke: var(--messing); stroke-width: 1.2; }
  .seil { fill: none; stroke: var(--messing); stroke-width: 2.4; stroke-linecap: round; }
  .fahne { fill: var(--tinte); }
  .schaft { fill: none; stroke: var(--elfenbein); stroke-width: 1.4; stroke-linecap: round; }
  .ufer { display: flex; justify-content: space-between; margin-top: 0.6rem; }
  .ufer span { font: italic 400 clamp(1.15rem, 2.2vw, 1.6rem)/1 var(--caslon-kursiv); color: var(--tinte); }

  @media (prefers-reduced-motion: no-preference) {
    .fahrbahn { stroke-dasharray: 1; animation: zeichnen 1.1s var(--sanft) 0.15s both; }
    .pfeiler { transform-box: fill-box; transform-origin: 50% 100%; animation: wachsen 0.8s var(--sanft) 0.45s both; }
    .de { animation: auf 0.6s ease 0.2s both; }
    .tr { animation: auf 0.6s ease 2.85s both; }
  }
  /* reduzierte Bewegung: Feder gar nicht zeigen (animateMotion lässt sich per CSS nicht anhalten) */
  @media (prefers-reduced-motion: reduce) { .feder { display: none; } .seil { stroke-dasharray: none !important; } .haenger { opacity: 1 !important; } }
  @keyframes zeichnen { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes wachsen { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes auf { from { opacity: 0; } to { opacity: 1; } }
</style>
