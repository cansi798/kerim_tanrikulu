---
// Einsatzgebiet als kleine, edle Karte (Can 31.10.2026 10:46): vier goldene Punkte in ihrer ungefähren Lage
// (Landeshauptstädte Kiel, Hamburg, Bremen, Hannover), Hamburg als Standort mit Ring, feine Linien von Hamburg aus.
// Keine Grenzlinien (bewusst abstrakt, nichts Falsches gezeichnet). Bewegung: einmal beim Sichtbarwerden (data-szene),
// Punkte erscheinen nacheinander, eine Welle breitet sich einmal von Hamburg aus (≤ 1,4 s). Ohne JS / „Bewegung reduzieren“: fertiges Bild.
import type { Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang; dunkel?: boolean }
const { lang, dunkel = false } = Astro.props;
const T = t(lang);
// x = (Länge − 6,6) · 26, y = (55,1 − Breite) · 42  (grob flächentreu für Norddeutschland)
const orte = [
  { k: "SH", x: 92, y: 33, lx: 100, ly: 30, a: "start" },
  { k: "HH", x: 88, y: 65, lx: 98, ly: 69, a: "start" },
  { k: "HB", x: 57, y: 85, lx: 47, ly: 88, a: "end" },
  { k: "NI", x: 81, y: 115, lx: 91, ly: 119, a: "start" },
];
const hh = orte[1];
---
<figure class:list={["gebiet-karte", { "auf-dunkel": dunkel }]} role="img" aria-label={T.gebiet.karte} data-szene>
  <svg viewBox="20 10 120 120" aria-hidden="true" focusable="false">
    <g class="flaechen">{orte.map((o, i) => <circle class={`f f${i}`} cx={o.x} cy={o.y} r={o.k === "HH" ? 15 : 22} />)}</g>
    <g class="linien">{orte.filter((o) => o.k !== "HH").map((o, i) => <line class={`l l${i}`} x1={hh.x} y1={hh.y} x2={o.x} y2={o.y} />)}</g>
    <circle class="welle" cx={hh.x} cy={hh.y} r="6" />
    <circle class="ring" cx={hh.x} cy={hh.y} r="6" />
    {orte.map((o, i) => (
      <g class={`ort o${i}`}>
        <circle cx={o.x} cy={o.y} r={o.k === "HH" ? 4.2 : 3.2} />
        <text x={o.lx} y={o.ly} text-anchor={o.a}>{o.k}</text>
      </g>
    ))}
  </svg>
</figure>
<style>
  .gebiet-karte { --g: var(--gold); --g-text: var(--gold-dunkel); --g-flaeche: rgba(168, 128, 60, 0.13); margin: 0; width: 100%; max-width: 11rem; }
  .gebiet-karte.auf-dunkel { --g: #c9a35b; --g-text: #e3c88f; --g-flaeche: rgba(217, 189, 133, 0.12); }
  svg { width: 100%; height: auto; overflow: visible; }
  .f { fill: var(--g-flaeche); }
  .l { stroke: var(--g); stroke-width: 0.9; stroke-dasharray: 2 3; opacity: 0.75; }
  .ring, .welle { fill: none; stroke: var(--g); stroke-width: 1; opacity: 0.6; transform-box: fill-box; transform-origin: center; }
  .welle { opacity: 0; }
  .ort circle { fill: var(--g); }
  .ort text { font: 700 9.5px/1 var(--sans); letter-spacing: 0.06em; fill: var(--g-text); }
  .ort, .f { transform-box: fill-box; transform-origin: center; }
  /* einmal beim Sichtbarwerden (pausiert, bis sichtbar.js „an“ setzt); Grundzustand = Endbild */
  .ort { animation: g-punkt 0.5s var(--ease) both; }
  .o0 { animation-delay: 0.3s; } .o2 { animation-delay: 0.45s; } .o3 { animation-delay: 0.6s; }
  .f { animation: einblenden 0.8s ease both; }
  .f0 { animation-delay: 0.3s; } .f2 { animation-delay: 0.45s; } .f3 { animation-delay: 0.6s; }
  .l { animation: g-linie 0.6s ease 0.25s both; }
  .ring { animation: g-punkt 0.5s var(--ease) 0.1s both; }
  .welle { animation: g-welle 1.1s ease-out 0.3s both; }
  @keyframes g-punkt { from { opacity: 0; transform: scale(0.3); } to { opacity: 1; transform: none; } }
  @keyframes g-linie { from { opacity: 0; } to { opacity: 0.75; } }
  @keyframes g-welle { from { opacity: 0.8; transform: scale(1); } to { opacity: 0; transform: scale(3.4); } }
</style>
