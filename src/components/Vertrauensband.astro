---
// Vertrauensleiste direkt unter dem Hero nach Bauwelt-Muster (dunkle Leiste, vier goldene Ringe; Jamil Talk 3910).
// Nur Angaben der bestehenden Website. Ringe stehen still (kein Zeichnen), die Punkte gleiten nacheinander ein.
import Icon from "./Icon.astro";
import { GERICHT, SEIT } from "../daten";
const punkte = [
  { icon: "schild", text: "Allgemein beeidigter Dolmetscher" },
  { icon: "dokument", text: "Ermächtigter Übersetzer" },
  { icon: "urteil", text: GERICHT },
  { icon: "kalender", text: `Seit ${SEIT}` },
] as const;
---
<section class="band" aria-label="Qualifikation auf einen Blick" data-szene>
  <div class="huelle">
    <ul>
      {punkte.map((p, i) => (
        <li class={`p${i}`}><span class="ring"><Icon name={p.icon} /></span><span class="text">{p.text}</span></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .band { background: var(--tinte); color: #f3ede4; }
  ul { list-style: none; margin: 0; padding: 2rem 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1rem; }
  @media (min-width: 52rem) { ul { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.85rem; text-align: center; }
  @media (min-width: 52rem) {
    li + li::before { content: ""; position: absolute; left: -0.5rem; top: 0.5rem; width: 1px; height: 4.5rem; background: linear-gradient(transparent, #c9a35b, transparent); opacity: 0.45; }
  }
  .ring { display: grid; place-items: center; width: 4.75rem; height: 4.75rem; border-radius: 50%; border: 1.5px solid #c9a35b; color: #d9bd85; }
  .ring :global(svg) { width: 1.9rem; height: 1.9rem; }
  .text { font-weight: 600; font-size: 1rem; line-height: 1.35; max-width: 16ch; }
  li { animation: rise 0.5s var(--ease) both; }
  .p1 { animation-delay: 0.12s; }
  .p2 { animation-delay: 0.24s; }
  .p3 { animation-delay: 0.36s; }
</style>
