---
// Ruhiges Bild „Dolmetschen“ (Jamil Talk 3910): zwei Sprechblasen als Flächen, dazwischen der Federkiel aus dem Logo.
// Beim Sichtbarwerden blendet zuerst Deutsch, dann der Federkiel, dann Türkisch sanft ein (bis 1,1 s), danach Ruhe.
// Can 31.10.2026 („Wow-Animation, die den Prozess zeigt“): mit JS und Bewegung übernimmt licht.js – Deutsch spricht (goldene Wellen),
// die Worte fließen als Licht zum Federkiel, werden dort verwandelt (Aufleuchten, tiefes Gold) und kommen als Wellen bei Türkisch an,
// dann eine kurze Antwort zurück; danach alle 14 s erneut und beim Wiederkommen ins Bild. Ohne JS / ruhig: dieses Standbild bzw. die alten Einblendungen.
import type { Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const T = t(Astro.props.lang);
// Richtung (Can 31.10. 09:43): deutsche Seiten Deutsch → Türkisch, türkische Seiten Türkçe → Almanca
const [ERST, DANN] = Astro.props.lang === "tr" ? [T.ui.tuerkisch, T.ui.deutsch] : [T.ui.deutsch, T.ui.tuerkisch];
const KIEL = "M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z";
---
<figure class="bild-dolmetschen" data-szene data-dolmetschen role="img" aria-label={T.ui.bildDo}>
  <div class="blase links" aria-hidden="true">{ERST}</div>
  <svg class="kiel" viewBox="0 0 58 66" aria-hidden="true" focusable="false"><path d={KIEL} /><path class="schaft" d="M5 62 L 46 11" /></svg>
  <div class="blase rechts" aria-hidden="true">{DANN}</div>
</figure>
<style>
  .bild-dolmetschen { position: relative; margin: 0; height: clamp(12rem, 24vw, 15rem); }
  .blase {
    position: absolute; padding: 0.9rem 1.5rem; border-radius: 999px; font: 600 clamp(1.15rem, 2vw, 1.35rem)/1 var(--serif);
    box-shadow: 0 14px 30px -20px rgba(43, 36, 31, 0.45);
  }
  .blase::after { content: ""; position: absolute; bottom: -9px; width: 18px; height: 18px; background: inherit; transform: rotate(45deg); border-radius: 3px; }
  .links { left: 6%; top: 14%; background: var(--weiss); color: var(--tinte); border: 1px solid var(--linie); }
  .links::after { left: 22%; border-right: 1px solid var(--linie); border-bottom: 1px solid var(--linie); }
  .rechts { right: 6%; bottom: 14%; background: #e8d6b0; color: var(--tinte); }
  .rechts::after { right: 22%; top: -9px; bottom: auto; }
  .kiel { position: absolute; left: 50%; top: 50%; width: 2.6rem; transform: translate(-50%, -50%); overflow: visible; }
  .kiel path { fill: var(--logo); }
  .kiel .schaft { fill: none; stroke: var(--sand); stroke-width: 1.6; stroke-linecap: round; }
  .links { animation: rise 0.6s var(--ease) both; }
  .kiel { animation: einblenden 0.5s ease 0.3s both; }
  .rechts { animation: rise 0.6s var(--ease) 0.5s both; }
  .blase, .kiel { z-index: 1; }
  .blase { transition: box-shadow 0.5s ease; }
  .blase:global(.d-glanz) { box-shadow: 0 0 0 1px rgba(168, 128, 60, 0.55), 0 0 26px 2px rgba(214, 170, 92, 0.6); }
  /* licht.js steuert Ein- und Ausblenden selbst (Inline-Stile); bis die Szene startet, ist sie leer */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bild-dolmetschen:global(.d-bereit) :is(.blase, .kiel) { animation: none; }
    :global(.js) .bild-dolmetschen:global(.d-bereit):not(:global(.d-fertig)) :is(.blase, .kiel) { opacity: 0; will-change: opacity, transform; }
    /* vor jeder Wiederholung sanft ausblenden */
    :global(.js) .bild-dolmetschen:global(.d-aus) :is(.blase, .kiel) { opacity: 0 !important; transition: opacity 0.6s ease !important; }
  }
</style>
