---
// Ruhiges Bild „Dolmetschen“ (Jamil Talk 3910): zwei Sprechblasen als Flächen, dazwischen der Federkiel aus dem Logo.
// Beim Sichtbarwerden blendet zuerst Deutsch, dann der Federkiel, dann Türkisch sanft ein (bis 1,1 s), danach Ruhe.
const KIEL = "M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z";
---
<figure class="bild-dolmetschen" data-szene role="img" aria-label="Dolmetschen: von Deutsch über den Dolmetscher zu Türkisch">
  <div class="blase links" aria-hidden="true">Deutsch</div>
  <svg class="kiel" viewBox="0 0 58 66" aria-hidden="true" focusable="false"><path d={KIEL} /><path class="schaft" d="M5 62 L 46 11" /></svg>
  <div class="blase rechts" aria-hidden="true">Türkisch</div>
</figure>
<style>
  .bild-dolmetschen { position: relative; margin: 0; height: clamp(12rem, 24vw, 15rem); }
  .blase {
    position: absolute; padding: 0.9rem 1.5rem; border-radius: 999px; font: 600 clamp(1.15rem, 2vw, 1.35rem)/1 var(--serif);
    box-shadow: 0 14px 30px -20px rgba(43, 36, 31, 0.45);
  }
  .blase::after { content: ""; position: absolute; bottom: -9px; width: 18px; height: 18px; background: inherit; transform: rotate(45deg); border-radius: 3px; }
  .links { left: 6%; top: 14%; background: var(--weiss); color: var(--tinte); border: 1px solid var(--linie); }
  .links::after { left: 22%; border-right: 1px solid var(--linie); border-bottom: 1px solid var(--linie); }
  .rechts { right: 6%; bottom: 14%; background: #e8d6b0; color: var(--tinte); }
  .rechts::after { right: 22%; top: -9px; bottom: auto; }
  .kiel { position: absolute; left: 50%; top: 50%; width: 2.6rem; transform: translate(-50%, -50%); overflow: visible; }
  .kiel path { fill: var(--logo); }
  .kiel .schaft { fill: none; stroke: var(--sand); stroke-width: 1.6; stroke-linecap: round; }
  .links { animation: rise 0.6s var(--ease) both; }
  .kiel { animation: einblenden 0.5s ease 0.3s both; }
  .rechts { animation: rise 0.6s var(--ease) 0.5s both; }
</style>
