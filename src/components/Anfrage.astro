  .anfrage .preis-zeile strong { display: inline-block; font: 600 clamp(1.45rem, 3.5vw, 1.8rem)/1.25 var(--serif); }
  .anfrage .preis-hinweis { margin: 0; font-size: 0.95rem; color: var(--primaer-leise); }
  .anfrage p.preis.ohne { font-weight: 600; }
  .anfrage .foto-hinweis { margin: 0 0 1.5rem; padding-left: 1rem; border-left: 2px solid var(--deko); }
