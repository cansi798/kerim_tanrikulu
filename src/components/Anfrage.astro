---
// Mehrstufiges Anfrageformular (Jamil Talk xidc8qvq #5217, 09.11.2026): eine Frage pro Schritt, thematisch geordnet,
// der unverbindliche Richtwert erscheint erst in der Zusammenfassung direkt vor „Anfrage senden“.
// Versand ohne Fremddienst: „Anfrage senden“ öffnet das eigene E-Mail-Programm (mailto), „Per WhatsApp senden“ öffnet wa.me –
// jeweils mit dem fertigen Text. Optional später ein eigener Empfang über PUBLIC_FORM_ENDPOINT (leer = mailto; entscheidet Can).
// Einmal pro Seite einbinden (feste ids): /kontakt/ und – seit Jamil Talk xidc8qvq #5312 – die deutsche Startseite.
// Kein Datei-Upload (sensible Dokumente). Ohne JavaScript bleibt das Formular verborgen, die Kontaktwege darunter gelten.
// Robustheit (Jamil Talk xidc8qvq #5237, 09.11.2026): Das Formular ist sichtbar erst, wenn das Skript es fertig eingerichtet hat
// (data-bereit am Rahmen). Bis dahin steht „Das Anfrage-Formular lädt …“; lädt das Skript nicht, erscheint nach einigen Sekunden
// ein Hinweis auf Neuladen bzw. die Kontaktwege. So gibt es nie Karten, die anklickbar aussehen, aber nichts tun.
// Preise stehen NICHT im HTML: die Dokumentlisten baut das Skript aus src/daten/dokumente.ts (gebündelte JS-Datei).
import Icon from "./Icon.astro";
import { THEMEN } from "../daten/dokumente";
import { MAIL, WHATSAPP_LINK } from "../daten";
import { p } from "../i18n";
interface Props {
  /** id der Überschrift über dem Formular (Ziel der Links „Anfrage senden“) */
  titelId?: string;
  /** Sprungziel der Kontaktwege (Telefon, WhatsApp, E-Mail) auf dieser Seite */
  direkt?: string;
  /** wo die Kontaktwege stehen, für den Hinweis ohne JavaScript */
  wegeOrt?: string;
}
const { titelId = "anfrage-titel", direkt = "#direkt", wegeOrt = "gleich unter diesem Abschnitt" } = Astro.props;

// Linien-Symbole der 9 Themen (24er-Raster, 1,4 px, runde Enden) – passend zu Icon.astro
const SYMBOLE: Record<string, string> = {
  familie: "M8.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M2.8 20v-1.2A4.6 4.6 0 0 1 7.4 14.2h2.2a4.6 4.6 0 0 1 4.6 4.6V20 M16.6 12a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8Z M15.6 14.6h1.7a3.9 3.9 0 0 1 3.9 3.9V20",
  ausweis: "M2.8 5.5h18.4v13H2.8z M5.5 9h4.5v6H5.5z M12.5 10h6 M12.5 13h6 M12.5 16h3.5",
  schule: "M2.5 9 12 4.5 21.5 9 12 13.5Z M6.5 11.2v4.6c0 1.6 2.5 3.2 5.5 3.2s5.5-1.6 5.5-3.2v-4.6 M21.5 9v5.5",
  gericht: "M12 3.5v16 M7 20.5h10 M5 7h14 M12 5.5V7 M5 7l-2.5 6h5Z M19 7l-2.5 6h5Z",
  arbeit: "M3.5 7.5h17v12h-17z M8.5 7.5v-2A1.5 1.5 0 0 1 10 4h4a1.5 1.5 0 0 1 1.5 1.5v2 M3.5 12.5h17 M10.5 12.5v2h3v-2",
  medizin: "M5 3.5h14v17H5z M12 8v6 M9 11h6 M8.5 17h7",
  finanzen: "M3.5 11 12 4l8.5 7 M5.5 9.5V20h13V9.5 M14.2 12.6a2.6 2.6 0 1 0 0 4.3 M9.6 14.1h3.4 M9.6 15.5h3.4",
  unternehmen: "M4.5 20.5V4.5h10v16 M14.5 9.5h5v11 M2.5 20.5h19 M7.5 8h1.5 M10.5 8H12 M7.5 11.5h1.5 M10.5 11.5H12 M7.5 15h1.5 M10.5 15H12 M17 13h.01 M17 16.5h.01",
  fahrzeug: "M3.5 16.5v-4l2-5h13l2 5v4z M3.5 12.5h17 M6 16.5v2 M18 16.5v2 M7 14.5h.01 M17 14.5h.01",
};
const datenschutz = p("de", "datenschutz");
---
<div class="anfrage-rahmen" data-anfrage-rahmen>
  <div class="anfrage-laedt">
    <p class="laedt-zeile"><span class="laedt-punkt" aria-hidden="true"></span>Das Anfrage-Formular lädt …</p>
    <p class="laedt-notfall">Lädt das Formular nicht? Bitte laden Sie die Seite einmal neu – oder melden Sie sich direkt per <a href={direkt}>Telefon, WhatsApp oder E-Mail</a>.</p>
  </div>
  <noscript>
    <p class="ohne-js">Das Anfrageformular braucht JavaScript. Sie erreichen Herrn Tanrikulu direkt per Telefon, WhatsApp oder E-Mail – die Kontaktwege finden Sie {wegeOrt}.</p>
  </noscript>
  <form class="anfrage" id="anfrage" novalidate data-mail={MAIL} data-wa={WHATSAPP_LINK} aria-labelledby={titelId}>
    <div class="fortschritt">
      <p class="stand" aria-hidden="true">Schritt <span data-nr>1</span> von <span data-von>7</span></p>
      <div class="balken" aria-hidden="true"><span data-balken></span></div>
    </div>
    <p class="sr" aria-live="polite" data-ansage></p>

    <!-- 1 Leistung -->
    <fieldset class="schritt" data-schritt="leistung">
      <legend><h3 tabindex="-1">Worum geht es?</h3></legend>
      <div class="wahlen zwei">
        <label class="wahl">
          <input type="radio" name="leistung" value="uebersetzung" />
          <span class="innen"><span class="sym"><Icon name="dokument" /></span><span class="text"><span class="titel">Übersetzung</span><span class="unter">Ein Dokument schriftlich übersetzen lassen</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
        <label class="wahl">
          <input type="radio" name="leistung" value="dolmetschen" />
          <span class="innen"><span class="sym"><Icon name="gespraech" /></span><span class="text"><span class="titel">Dolmetschen</span><span class="unter">Ein Gespräch oder einen Termin dolmetschen lassen – vor Ort, per Video oder Telefon</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 2 Sprachrichtung (nur Übersetzung) -->
    <fieldset class="schritt" data-schritt="richtung" hidden>
      <legend><h3 tabindex="-1">In welche Richtung soll übersetzt werden?</h3></legend>
      <div class="wahlen zwei">
        <label class="wahl">
          <input type="radio" name="richtung" value="tr-de" />
          <span class="innen"><span class="text"><span class="titel">Türkisch <span aria-hidden="true">→</span><span class="sr">nach</span> Deutsch</span><span class="unter">Das Dokument ist auf Türkisch</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
        <label class="wahl">
          <input type="radio" name="richtung" value="de-tr" />
          <span class="innen"><span class="text"><span class="titel">Deutsch <span aria-hidden="true">→</span><span class="sr">nach</span> Türkisch</span><span class="unter">Das Dokument ist auf Deutsch</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 3 Thema -->
    <fieldset class="schritt" data-schritt="thema" hidden>
      <legend><h3 tabindex="-1">Zu welchem Thema gehört Ihr Dokument?</h3></legend>
      <div class="wahlen themen">
        {THEMEN.map((t) => (
          <label class="wahl kompakt">
            <input type="radio" name="thema" value={t.id} />
            <span class="innen">
              <span class="sym"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={SYMBOLE[t.icon] ?? SYMBOLE.ausweis} /></svg></span>
              <span class="text"><span class="titel">{t.titel}</span></span>
              <span class="punkt" aria-hidden="true"></span>
            </span>
          </label>
        ))}
      </div>
      <p class="fehler" data-fehler hidden></p>
      <p class="nebenweg"><button type="button" class="textknopf" data-ohne-thema>Nicht sicher? Direkt nach dem Dokument suchen</button></p>
    </fieldset>

    <!-- 4 Dokument -->
    <fieldset class="schritt" data-schritt="dokument" hidden>
      <legend><h3 tabindex="-1">Um welches Dokument geht es?</h3></legend>
      <div class="feld">
        <label for="dok-suche">Dokument suchen <span class="opt">(in allen Themen)</span></label>
        <input id="dok-suche" type="search" autocomplete="off" enterkeyhint="search" spellcheck="false" placeholder="Dokument suchen, z. B. Geburtsurkunde" aria-describedby="dok-treffer" data-suche />
      </div>
      <p class="sr" id="dok-treffer" aria-live="polite" data-treffer></p>
      <p class="listenkopf" data-listenkopf></p>
      <p class="auswahl" data-auswahl hidden></p>
      <ul class="dokliste" data-dokliste></ul>
      <label class="wahl zeile anderes">
        <input type="radio" name="dokument" value="anderes" />
        <span class="innen"><span class="text"><span class="titel">Anderes Dokument</span><span class="unter">Mein Dokument ist nicht dabei</span></span><span class="punkt" aria-hidden="true"></span></span>
      </label>
      <div class="feld" data-anderes-feld hidden>
        <label for="dok-anderes">Welches Dokument ist es?</label>
        <input id="dok-anderes" name="anderes" type="text" maxlength="120" autocomplete="off" />
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 5 Umfang + Wunschtermin -->
    <fieldset class="schritt" data-schritt="umfang" hidden>
      <legend><h3 tabindex="-1" data-umfang-titel>Wie viele Seiten, und bis wann?</h3></legend>
      <div class="feld" data-seiten-feld>
        <label for="seiten">Seiten der fertigen Übersetzung <span class="opt">(ca.)</span></label>
        <div class="zahl">
          <button type="button" class="zahlknopf" data-minus aria-label="Eine Seite weniger">−</button>
          <input id="seiten" name="seiten" type="number" inputmode="numeric" min="1" max="500" step="1" value="1" aria-describedby="seiten-hilfe" />
          <button type="button" class="zahlknopf" data-plus aria-label="Eine Seite mehr">+</button>
        </div>
        <p class="hilfe" id="seiten-hilfe">Eine Schätzung genügt.</p>
      </div>
      <div class="feld">
        <label for="wunsch">Wunschtermin <span class="opt">(optional)</span></label>
        <input id="wunsch" name="wunsch" type="date" data-ab-heute />
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Termin -->
    <fieldset class="schritt" data-schritt="termin" hidden>
      <legend><h3 tabindex="-1">Wann ist der Termin?</h3></legend>
      <div class="reihe">
        <div class="feld">
          <label for="d-datum">Datum</label>
          <input id="d-datum" name="datum" type="date" aria-describedby="d-datum-hilfe" data-ab-heute />
        </div>
        <div class="feld">
          <label for="d-zeit">Uhrzeit <span class="opt">(optional)</span></label>
          <input id="d-zeit" name="uhrzeit" type="time" />
        </div>
      </div>
      <p class="hilfe" id="d-datum-hilfe">Steht der Termin noch nicht fest, lassen Sie die Felder einfach leer.</p>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Art -->
    <fieldset class="schritt" data-schritt="art" hidden>
      <legend><h3 tabindex="-1">Wie soll gedolmetscht werden?</h3></legend>
      <div class="wahlen drei">
        <label class="wahl kompakt"><input type="radio" name="art" value="vor-ort" /><span class="innen"><span class="sym"><Icon name="ort" /></span><span class="text"><span class="titel">Vor Ort</span></span><span class="punkt" aria-hidden="true"></span></span></label>
        <label class="wahl kompakt"><input type="radio" name="art" value="video" /><span class="innen"><span class="sym"><Icon name="video" /></span><span class="text"><span class="titel">Per Video</span></span><span class="punkt" aria-hidden="true"></span></span></label>
        <label class="wahl kompakt"><input type="radio" name="art" value="telefon" /><span class="innen"><span class="sym"><Icon name="telefon" /></span><span class="text"><span class="titel">Per Telefon</span></span><span class="punkt" aria-hidden="true"></span></span></label>
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Ort (nur vor Ort) -->
    <fieldset class="schritt" data-schritt="ort" hidden>
      <legend><h3 tabindex="-1">Wo findet der Termin statt?</h3></legend>
      <div class="feld">
        <label for="d-ort">Ort oder Adresse</label>
        <input id="d-ort" name="ort" type="text" maxlength="160" autocomplete="off" placeholder="z. B. Amtsgericht Hamburg" />
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Dauer -->
    <fieldset class="schritt" data-schritt="dauer" hidden>
      <legend><h3 tabindex="-1">Wie lange dauert der Termin ungefähr?</h3></legend>
      <div class="wahlen zwei">
        {["bis 1 Stunde", "1 bis 2 Stunden", "2 bis 4 Stunden", "mehr als 4 Stunden", "weiß ich noch nicht"].map((d) => (
          <label class="wahl kompakt"><input type="radio" name="dauer" value={d} /><span class="innen"><span class="text"><span class="titel">{d.charAt(0).toUpperCase() + d.slice(1)}</span></span><span class="punkt" aria-hidden="true"></span></span></label>
        ))}
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 6 Kontaktdaten -->
    <fieldset class="schritt" data-schritt="kontakt" hidden>
      <legend><h3 tabindex="-1">Wie erreicht Herr Tanrikulu Sie?</h3></legend>
      <div class="feld">
        <label for="k-name">Name</label>
        <input id="k-name" name="name" type="text" autocomplete="name" maxlength="100" />
      </div>
      <div class="feld">
        <label for="k-mail">E-Mail</label>
        <input id="k-mail" name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" spellcheck="false" />
      </div>
      <div class="feld">
        <label for="k-tel">Telefon <span class="opt">(optional)</span></label>
        <input id="k-tel" name="tel" type="tel" autocomplete="tel" maxlength="40" />
      </div>
      <div class="feld">
        <label for="k-text">Nachricht <span class="opt">(optional)</span></label>
        <textarea id="k-text" name="nachricht" rows="4" maxlength="800"></textarea>
      </div>
      <p class="datenschutz-hinweis">Ihre Angaben bleiben in Ihrem Browser. Übertragen werden sie erst, wenn Sie die Anfrage im letzten Schritt selbst per E-Mail oder WhatsApp absenden. Mehr dazu in der <a href={datenschutz}>Datenschutzerklärung</a>.</p>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 7 Zusammenfassung (hier und nur hier der Richtwert) -->
    <fieldset class="schritt" data-schritt="zusammenfassung" hidden>
      <legend><h3 tabindex="-1">Ihre Anfrage im Überblick</h3></legend>
      <dl class="uebersicht" data-uebersicht></dl>
      <div class="preis" data-preis hidden>
        <p class="preis-zeile"><span data-preis-titel>Unverbindlicher Richtwert:</span> <strong data-preis-wert></strong></p>
        <p class="preis-hinweis" data-preis-hinweis></p>
      </div>
      <p class="preis ohne" data-ohne-preis hidden></p>
      <p class="foto-hinweis" data-foto hidden>Ein Foto oder Scan des Dokuments schicken Sie bitte erst nach unserer Rückmeldung.</p>
      <div class="senden">
        <a class="knopf" href={`mailto:${MAIL}`} data-senden-mail><Icon name="mail" />Anfrage senden</a>
        <a class="knopf rahmen" href={WHATSAPP_LINK} rel="noopener" data-senden-wa><Icon name="whatsapp" />Per WhatsApp senden</a>
      </div>
      <p class="senden-hinweis">Es öffnet sich Ihr E-Mail-Programm oder WhatsApp mit dem fertigen Text. Erst wenn Sie dort auf „Senden“ tippen, geht Ihre Anfrage an Herrn Tanrikulu.</p>
      <p class="gesendet" role="status" data-gesendet></p>
    </fieldset>

    <div class="steuerung">
      <button type="button" class="knopf rahmen zurueck" data-zurueck hidden>Zurück</button>
      <button type="submit" class="knopf vor" data-weiter>Weiter</button>
    </div>
  </form>
</div>

<script>
  // Lader (Jamil Talk xidc8qvq #5312, 09.11.2026: Formular auch auf der Startseite). Die Logik (src/lib/anfrage-formular.ts, eigene
  // JS-Datei) wird erst nachgeladen, wenn das Formular in die Nähe des Bildschirms kommt oder jemand einen Link dorthin antippt –
  // so konkurriert sie nicht mit dem ersten Bildschirm. Sichtbar wie bisher erst nach fehlerfreiem Start (data-bereit);
  // der Notfall-Hinweis zählt ab Ladebeginn (data-laedt), bei einem Ladefehler erscheint er sofort (data-fehler).
  const rahmen = document.querySelector<HTMLElement>("[data-anfrage-rahmen]");
  const form = rahmen?.querySelector<HTMLFormElement>("form.anfrage");
  if (rahmen && form) {
    rahmen.dataset.wartet = "";
    let los = false;
    let io: IntersectionObserver | null = null;
    const laden = () => {
      if (los) return;
      los = true;
      io?.disconnect();
      rahmen.dataset.laedt = "";
      import("../lib/anfrage-formular")
        .then(({ starten }) => {
          starten(form);
          form.dataset.bereit = "";
          rahmen.dataset.bereit = "";
        })
        .catch((e) => {
          console.error("Anfrageformular:", e);
          rahmen.dataset.fehler = "";
        });
    };
    if ("IntersectionObserver" in window) {
      io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) laden(); }, { rootMargin: "800px 0px" });
      io.observe(rahmen.closest("section") ?? rahmen); // Abschnitt beobachten: sein Inhalt wird per content-visibility evtl. noch nicht gerendert
    } else laden();
    // Links zum Formular auf derselben Seite (z. B. Hauptknopf der Startseite): sofort laden; der Sprung selbst ist sanft
    // (scroll-behavior in global.css, bei „weniger Bewegung“ direkt), der Fokus geht auf die Überschrift des Formulars.
    const titel = document.getElementById(form.getAttribute("aria-labelledby") || "");
    if (titel) {
      if (!titel.hasAttribute("tabindex")) titel.setAttribute("tabindex", "-1");
      document.addEventListener("click", (ev) => {
        const a = (ev.target as Element | null)?.closest?.("a[href]");
        if (!a || a.getAttribute("href") !== "#" + titel.id || ev.defaultPrevented || ev.button || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
        ev.preventDefault();
        laden();
        const ruhig = matchMedia("(prefers-reduced-motion: reduce)").matches;
        // Abschnitte davor (content-visibility: auto, nur geschätzte Höhe) jetzt echt rendern, sonst verschiebt sich das Ziel
        // während des Scrollens (Safari hat keine Scroll-Verankerung und landete ca. 80 px zu tief)
        let vor = titel.closest("section")?.previousElementSibling;
        for (; vor; vor = vor.previousElementSibling) if (vor instanceof HTMLElement) vor.style.contentVisibility = "visible";
        titel.scrollIntoView({ behavior: ruhig ? "auto" : "smooth", block: "start" });
        if (location.hash !== "#" + titel.id) history.pushState(null, "", "#" + titel.id);
        // Fokus erst nach dem Scrollen (WebKit scrollt sonst beim Fokussieren selbst und ignoriert den Kopfabstand)
        let fertig = false;
        const fokus = () => {
          if (fertig) return;
          fertig = true;
          const soll = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
          if (Math.abs(titel.getBoundingClientRect().top - soll) > 12) titel.scrollIntoView({ behavior: "auto", block: "start" });
          titel.focus({ preventScroll: true });
        };
        if (ruhig) fokus();
        else { addEventListener("scrollend", fokus, { once: true }); setTimeout(fokus, 1200); }
      });
    }
  }
</script>

<style is:global>
  .anfrage-rahmen { max-width: 52rem; margin-inline: auto; }
  .anfrage-rahmen .ohne-js { padding: 1rem 1.2rem; border-left: 3px solid var(--primaer); background: var(--sekundaer); margin: 0; }
  /* Formular erst zeigen, wenn das Skript es eingerichtet hat (auch ohne JS verborgen) */
  .anfrage-rahmen:not([data-bereit]) .anfrage { display: none; }
  .anfrage-laedt { display: none; }
  html.js .anfrage-rahmen:not([data-bereit]) .anfrage-laedt { display: block; padding: 1.1rem 1.25rem; border: 1px solid var(--linie); border-radius: 16px; background: #fff; }
  .anfrage-laedt p { margin: 0; }
  .anfrage-laedt .laedt-zeile { display: flex; align-items: center; gap: 0.7rem; font-weight: 600; color: var(--primaer); }
  .anfrage-laedt .laedt-punkt { flex: none; width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--primaer); animation: laedt-puls 1.2s ease-in-out infinite; }
  /* Notfall-Hinweis erst nach 6 s (reines CSS – greift auch, wenn das Skript gar nicht lädt) */
  .anfrage-laedt .laedt-notfall { margin-top: 0.6rem; color: var(--primaer-leise); animation: laedt-spaet 0s linear 6s both; }
  .anfrage-laedt .laedt-notfall a { font-weight: 600; color: var(--primaer); }
  @keyframes laedt-puls { 50% { opacity: 0.25; } }
  @keyframes laedt-spaet { from { visibility: hidden; } to { visibility: visible; } }
  /* Mit Lader (Skript läuft, Formular wird erst später nachgeladen): Uhr startet erst beim Laden, bei einem Ladefehler sofort */
  .anfrage-rahmen[data-wartet]:not([data-laedt]) .anfrage-laedt .laedt-notfall { animation: none; visibility: hidden; }
  .anfrage-rahmen[data-laedt] .anfrage-laedt .laedt-notfall { animation: laedt-spaet2 0s linear 6s both; }
  .anfrage-rahmen[data-fehler] .anfrage-laedt .laedt-notfall { animation: none; visibility: visible; }
  @keyframes laedt-spaet2 { from { visibility: hidden; } to { visibility: visible; } }
  @media (prefers-reduced-motion: reduce) { .anfrage-laedt .laedt-punkt { animation: none; } }

  .anfrage { background: #fff; border: 1px solid var(--linie); border-radius: 16px; padding: clamp(1.1rem, 4vw, 2.5rem); box-shadow: 0 24px 48px -36px rgba(29, 49, 90, 0.35); }
  .anfrage .fortschritt { margin-bottom: clamp(1.25rem, 3vw, 1.75rem); }
