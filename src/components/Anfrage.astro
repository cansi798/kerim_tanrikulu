  @media (min-width: 36rem) { .anfrage .uebersicht div { grid-template-columns: 10rem minmax(0, 1fr); } }
  .anfrage .uebersicht dt { color: var(--primaer-leise); font-size: 0.98rem; }
  .anfrage .uebersicht dd { margin: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; font-weight: 600; overflow-wrap: anywhere; }
  .anfrage .uebersicht .lang dd span { font-weight: 400; white-space: pre-line; }
  .anfrage .uebersicht .aendern { font-size: 0.92rem; padding: 0; }
  .anfrage .preis { margin: 0 0 1rem; padding: 1.1rem 1.25rem; border-radius: 12px; background: var(--sekundaer); border-left: 4px solid var(--primaer); }
  .anfrage .preis[hidden], .anfrage .foto-hinweis[hidden] { display: none; }
