---
// Mehrstufiges Anfrageformular (Jamil Talk xidc8qvq #5217, 09.11.2026): eine Frage pro Schritt, thematisch geordnet,
// der unverbindliche Richtwert erscheint erst in der Zusammenfassung direkt vor „Anfrage senden“.
// Versand ohne Fremddienst: „Anfrage senden“ öffnet das eigene E-Mail-Programm (mailto), „Per WhatsApp senden“ öffnet wa.me –
// jeweils mit dem fertigen Text. Optional später ein eigener Empfang über PUBLIC_FORM_ENDPOINT (leer = mailto; entscheidet Can).
// Kein Datei-Upload (sensible Dokumente). Ohne JavaScript bleibt das Formular verborgen, die Kontaktwege darunter gelten.
// Preise stehen NICHT im HTML: die Dokumentlisten baut das Skript aus src/daten/dokumente.ts (gebündelte JS-Datei).
import Icon from "./Icon.astro";
import { THEMEN } from "../daten/dokumente";
import { MAIL, WHATSAPP_LINK } from "../daten";
import { p } from "../i18n";

// Linien-Symbole der 9 Themen (24er-Raster, 1,4 px, runde Enden) – passend zu Icon.astro
const SYMBOLE: Record<string, string> = {
  familie: "M8.5 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z M2.8 20v-1.2A4.6 4.6 0 0 1 7.4 14.2h2.2a4.6 4.6 0 0 1 4.6 4.6V20 M16.6 12a2.4 2.4 0 1 0 0-4.8 2.4 2.4 0 0 0 0 4.8Z M15.6 14.6h1.7a3.9 3.9 0 0 1 3.9 3.9V20",
  ausweis: "M2.8 5.5h18.4v13H2.8z M5.5 9h4.5v6H5.5z M12.5 10h6 M12.5 13h6 M12.5 16h3.5",
  schule: "M2.5 9 12 4.5 21.5 9 12 13.5Z M6.5 11.2v4.6c0 1.6 2.5 3.2 5.5 3.2s5.5-1.6 5.5-3.2v-4.6 M21.5 9v5.5",
  gericht: "M12 3.5v16 M7 20.5h10 M5 7h14 M12 5.5V7 M5 7l-2.5 6h5Z M19 7l-2.5 6h5Z",
  arbeit: "M3.5 7.5h17v12h-17z M8.5 7.5v-2A1.5 1.5 0 0 1 10 4h4a1.5 1.5 0 0 1 1.5 1.5v2 M3.5 12.5h17 M10.5 12.5v2h3v-2",
  medizin: "M5 3.5h14v17H5z M12 8v6 M9 11h6 M8.5 17h7",
  finanzen: "M3.5 11 12 4l8.5 7 M5.5 9.5V20h13V9.5 M14.2 12.6a2.6 2.6 0 1 0 0 4.3 M9.6 14.1h3.4 M9.6 15.5h3.4",
  unternehmen: "M4.5 20.5V4.5h10v16 M14.5 9.5h5v11 M2.5 20.5h19 M7.5 8h1.5 M10.5 8H12 M7.5 11.5h1.5 M10.5 11.5H12 M7.5 15h1.5 M10.5 15H12 M17 13h.01 M17 16.5h.01",
  fahrzeug: "M3.5 16.5v-4l2-5h13l2 5v4z M3.5 12.5h17 M6 16.5v2 M18 16.5v2 M7 14.5h.01 M17 14.5h.01",
};
const datenschutz = p("de", "datenschutz");
---
<div class="anfrage-rahmen">
  <noscript>
    <p class="ohne-js">Das Anfrageformular braucht JavaScript. Sie erreichen Herrn Tanrikulu direkt per Telefon, WhatsApp oder E-Mail – die Kontaktwege finden Sie gleich unter diesem Abschnitt.</p>
  </noscript>
  <form class="anfrage" id="anfrage" novalidate data-mail={MAIL} data-wa={WHATSAPP_LINK} aria-labelledby="anfrage-titel">
    <div class="fortschritt">
      <p class="stand" aria-hidden="true">Schritt <span data-nr>1</span> von <span data-von>7</span></p>
      <div class="balken" aria-hidden="true"><span data-balken></span></div>
    </div>
    <p class="sr" aria-live="polite" data-ansage></p>

    <!-- 1 Leistung -->
    <fieldset class="schritt" data-schritt="leistung">
      <legend><h3 tabindex="-1">Worum geht es?</h3></legend>
      <div class="wahlen zwei">
        <label class="wahl">
          <input type="radio" name="leistung" value="uebersetzung" />
          <span class="innen"><span class="sym"><Icon name="dokument" /></span><span class="text"><span class="titel">Übersetzung</span><span class="unter">Ein Dokument schriftlich übersetzen lassen</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
        <label class="wahl">
          <input type="radio" name="leistung" value="dolmetschen" />
          <span class="innen"><span class="sym"><Icon name="gespraech" /></span><span class="text"><span class="titel">Dolmetschen</span><span class="unter">Ein Gespräch oder einen Termin dolmetschen lassen – vor Ort, per Video oder Telefon</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 2 Sprachrichtung (nur Übersetzung) -->
    <fieldset class="schritt" data-schritt="richtung" hidden>
      <legend><h3 tabindex="-1">In welche Richtung soll übersetzt werden?</h3></legend>
      <div class="wahlen zwei">
        <label class="wahl">
          <input type="radio" name="richtung" value="tr-de" />
          <span class="innen"><span class="text"><span class="titel">Türkisch <span aria-hidden="true">→</span><span class="sr">nach</span> Deutsch</span><span class="unter">Das Dokument ist auf Türkisch</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
        <label class="wahl">
          <input type="radio" name="richtung" value="de-tr" />
          <span class="innen"><span class="text"><span class="titel">Deutsch <span aria-hidden="true">→</span><span class="sr">nach</span> Türkisch</span><span class="unter">Das Dokument ist auf Deutsch</span></span><span class="punkt" aria-hidden="true"></span></span>
        </label>
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 3 Thema -->
    <fieldset class="schritt" data-schritt="thema" hidden>
      <legend><h3 tabindex="-1">Zu welchem Thema gehört Ihr Dokument?</h3></legend>
      <div class="wahlen themen">
        {THEMEN.map((t) => (
          <label class="wahl kompakt">
            <input type="radio" name="thema" value={t.id} />
            <span class="innen">
              <span class="sym"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={SYMBOLE[t.icon] ?? SYMBOLE.ausweis} /></svg></span>
              <span class="text"><span class="titel">{t.titel}</span></span>
              <span class="punkt" aria-hidden="true"></span>
            </span>
          </label>
        ))}
      </div>
      <p class="fehler" data-fehler hidden></p>
      <p class="nebenweg"><button type="button" class="textknopf" data-ohne-thema>Nicht sicher? Direkt nach dem Dokument suchen</button></p>
    </fieldset>

    <!-- 4 Dokument -->
    <fieldset class="schritt" data-schritt="dokument" hidden>
      <legend><h3 tabindex="-1">Um welches Dokument geht es?</h3></legend>
      <div class="feld">
        <label for="dok-suche">Dokument suchen <span class="opt">(in allen Themen)</span></label>
        <input id="dok-suche" type="search" autocomplete="off" enterkeyhint="search" spellcheck="false" placeholder="z. B. Geburtsurkunde" aria-describedby="dok-treffer" data-suche />
      </div>
      <p class="sr" id="dok-treffer" aria-live="polite" data-treffer></p>
      <p class="listenkopf" data-listenkopf></p>
      <p class="auswahl" data-auswahl hidden></p>
      <ul class="dokliste" data-dokliste></ul>
      <label class="wahl zeile anderes">
        <input type="radio" name="dokument" value="anderes" />
        <span class="innen"><span class="text"><span class="titel">Anderes Dokument</span><span class="unter">Mein Dokument ist nicht dabei</span></span><span class="punkt" aria-hidden="true"></span></span>
      </label>
      <div class="feld" data-anderes-feld hidden>
        <label for="dok-anderes">Welches Dokument ist es?</label>
        <input id="dok-anderes" name="anderes" type="text" maxlength="120" autocomplete="off" />
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 5 Umfang + Wunschtermin -->
    <fieldset class="schritt" data-schritt="umfang" hidden>
      <legend><h3 tabindex="-1" data-umfang-titel>Wie viele Seiten, und bis wann?</h3></legend>
      <div class="feld" data-seiten-feld>
        <label for="seiten">Seiten der fertigen Übersetzung <span class="opt">(ca.)</span></label>
        <div class="zahl">
          <button type="button" class="zahlknopf" data-minus aria-label="Eine Seite weniger">−</button>
          <input id="seiten" name="seiten" type="number" inputmode="numeric" min="1" max="500" step="1" value="1" aria-describedby="seiten-hilfe" />
          <button type="button" class="zahlknopf" data-plus aria-label="Eine Seite mehr">+</button>
        </div>
        <p class="hilfe" id="seiten-hilfe">Eine Schätzung genügt.</p>
      </div>
      <div class="feld">
        <label for="wunsch">Wunschtermin <span class="opt">(optional)</span></label>
        <input id="wunsch" name="wunsch" type="date" data-ab-heute />
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Termin -->
    <fieldset class="schritt" data-schritt="termin" hidden>
      <legend><h3 tabindex="-1">Wann ist der Termin?</h3></legend>
      <div class="reihe">
        <div class="feld">
          <label for="d-datum">Datum</label>
          <input id="d-datum" name="datum" type="date" aria-describedby="d-datum-hilfe" data-ab-heute />
        </div>
        <div class="feld">
          <label for="d-zeit">Uhrzeit <span class="opt">(optional)</span></label>
          <input id="d-zeit" name="uhrzeit" type="time" />
        </div>
      </div>
      <p class="hilfe" id="d-datum-hilfe">Steht der Termin noch nicht fest, lassen Sie die Felder einfach leer.</p>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Art -->
    <fieldset class="schritt" data-schritt="art" hidden>
      <legend><h3 tabindex="-1">Wie soll gedolmetscht werden?</h3></legend>
      <div class="wahlen drei">
        <label class="wahl kompakt"><input type="radio" name="art" value="vor-ort" /><span class="innen"><span class="sym"><Icon name="ort" /></span><span class="text"><span class="titel">Vor Ort</span></span><span class="punkt" aria-hidden="true"></span></span></label>
        <label class="wahl kompakt"><input type="radio" name="art" value="video" /><span class="innen"><span class="sym"><Icon name="video" /></span><span class="text"><span class="titel">Per Video</span></span><span class="punkt" aria-hidden="true"></span></span></label>
        <label class="wahl kompakt"><input type="radio" name="art" value="telefon" /><span class="innen"><span class="sym"><Icon name="telefon" /></span><span class="text"><span class="titel">Per Telefon</span></span><span class="punkt" aria-hidden="true"></span></span></label>
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Ort (nur vor Ort) -->
    <fieldset class="schritt" data-schritt="ort" hidden>
      <legend><h3 tabindex="-1">Wo findet der Termin statt?</h3></legend>
      <div class="feld">
        <label for="d-ort">Ort oder Adresse</label>
        <input id="d-ort" name="ort" type="text" maxlength="160" autocomplete="off" placeholder="z. B. Amtsgericht Hamburg" />
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- Dolmetschen: Dauer -->
    <fieldset class="schritt" data-schritt="dauer" hidden>
      <legend><h3 tabindex="-1">Wie lange dauert der Termin ungefähr?</h3></legend>
      <div class="wahlen zwei">
        {["bis 1 Stunde", "1 bis 2 Stunden", "2 bis 4 Stunden", "mehr als 4 Stunden", "weiß ich noch nicht"].map((d) => (
          <label class="wahl kompakt"><input type="radio" name="dauer" value={d} /><span class="innen"><span class="text"><span class="titel">{d.charAt(0).toUpperCase() + d.slice(1)}</span></span><span class="punkt" aria-hidden="true"></span></span></label>
        ))}
      </div>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 6 Kontaktdaten -->
    <fieldset class="schritt" data-schritt="kontakt" hidden>
      <legend><h3 tabindex="-1">Wie erreicht Herr Tanrikulu Sie?</h3></legend>
      <div class="feld">
        <label for="k-name">Name</label>
        <input id="k-name" name="name" type="text" autocomplete="name" maxlength="100" />
      </div>
      <div class="feld">
        <label for="k-mail">E-Mail</label>
        <input id="k-mail" name="email" type="email" autocomplete="email" inputmode="email" maxlength="120" spellcheck="false" />
      </div>
      <div class="feld">
        <label for="k-tel">Telefon <span class="opt">(optional)</span></label>
        <input id="k-tel" name="tel" type="tel" autocomplete="tel" maxlength="40" />
      </div>
      <div class="feld">
        <label for="k-text">Nachricht <span class="opt">(optional)</span></label>
        <textarea id="k-text" name="nachricht" rows="4" maxlength="800"></textarea>
      </div>
      <p class="datenschutz-hinweis">Ihre Angaben bleiben in Ihrem Browser. Übertragen werden sie erst, wenn Sie die Anfrage im letzten Schritt selbst per E-Mail oder WhatsApp absenden. Mehr dazu in der <a href={datenschutz}>Datenschutzerklärung</a>.</p>
      <p class="fehler" data-fehler hidden></p>
    </fieldset>

    <!-- 7 Zusammenfassung (hier und nur hier der Richtwert) -->
    <fieldset class="schritt" data-schritt="zusammenfassung" hidden>
      <legend><h3 tabindex="-1">Ihre Anfrage im Überblick</h3></legend>
      <dl class="uebersicht" data-uebersicht></dl>
      <div class="preis" data-preis hidden>
        <p class="preis-zeile">Unverbindlicher Richtwert: <strong data-preis-wert></strong></p>
        <p class="preis-hinweis" data-preis-hinweis></p>
      </div>
      <p class="preis ohne" data-ohne-preis hidden></p>
      <p class="foto-hinweis" data-foto hidden>Ein Foto oder Scan des Dokuments schicken Sie bitte erst nach unserer Rückmeldung.</p>
      <div class="senden">
        <a class="knopf" href={`mailto:${MAIL}`} data-senden-mail><Icon name="mail" />Anfrage senden</a>
        <a class="knopf rahmen" href={WHATSAPP_LINK} rel="noopener" data-senden-wa><Icon name="whatsapp" />Per WhatsApp senden</a>
      </div>
      <p class="senden-hinweis">Es öffnet sich Ihr E-Mail-Programm oder WhatsApp mit dem fertigen Text. Erst wenn Sie dort auf „Senden“ tippen, geht Ihre Anfrage an Herrn Tanrikulu.</p>
      <p class="gesendet" role="status" data-gesendet></p>
    </fieldset>

    <div class="steuerung">
      <button type="button" class="knopf rahmen zurueck" data-zurueck hidden>Zurück</button>
      <button type="submit" class="knopf vor" data-weiter>Weiter</button>
    </div>
  </form>
</div>

<script>
  import { finden, thema as themaVon, suchen, richtwert, spanne, datumDe, MINDESTPREIS, type Eintrag } from "../lib/anfrage";

  const ENDPOINT: string = import.meta.env.PUBLIC_FORM_ENDPOINT || "";
  const form = document.querySelector<HTMLFormElement>("#anfrage");
  if (form) starten(form);

  function starten(form: HTMLFormElement) {
    const $ = <T extends Element = HTMLElement>(s: string, w: ParentNode = form) => w.querySelector<T>(s)!;
    const schritte = new Map([...form.querySelectorAll<HTMLFieldSetElement>("[data-schritt]")].map((el) => [el.dataset.schritt!, el]));
    const feld = (name: string) => form.elements.namedItem(name) as HTMLInputElement | RadioNodeList | null;
    const wert = (name: string) => ((feld(name) as HTMLInputElement | RadioNodeList | null)?.value ?? "").trim();
    const MAIL = form.dataset.mail!;
    const WA = form.dataset.wa!;

    let aktuell = "leistung";
    let vonUebersicht = false;
    let ohneThema = false;
    let dokId = "";
    let zeigerZeit = 0;

    // Datumsfelder: frühestens heute
    const heute = new Date();
    const iso = `${heute.getFullYear()}-${String(heute.getMonth() + 1).padStart(2, "0")}-${String(heute.getDate()).padStart(2, "0")}`;
    form.querySelectorAll<HTMLInputElement>("[data-ab-heute]").forEach((i) => (i.min = iso));

    const pfad = () =>
      wert("leistung") === "dolmetschen"
        ? ["leistung", "termin", "art", ...(wert("art") === "vor-ort" ? ["ort"] : []), "dauer", "kontakt", "zusammenfassung"]
        : ["leistung", "richtung", "thema", "dokument", "umfang", "kontakt", "zusammenfassung"];

    const gewaehlt = (): Eintrag | undefined => (dokId && dokId !== "anderes" ? finden(dokId) : undefined);
    const seitenZaehlen = () => !!gewaehlt() && gewaehlt()!.dok.einheit === "seite";
    const seiten = () => Math.max(1, Math.min(500, Math.round(Number(wert("seiten"))) || 1));

    // ---------- Prüfen ----------
    type Fehler = { el: HTMLElement; text: string } | null;
    const erstesRadio = (name: string) => form.querySelector<HTMLInputElement>(`[data-schritt] input[name="${name}"]`)!;
    function pruefen(id: string): Fehler {
      const wahl = "Bitte wählen Sie eine Möglichkeit.";
      switch (id) {
        case "leistung": case "richtung": case "art": case "dauer":
          return wert(id) ? null : { el: erstesRadio(id), text: wahl };
        case "thema":
          return wert("thema") || ohneThema ? null : { el: erstesRadio("thema"), text: wahl };
        case "dokument":
          if (!dokId) return { el: (form.querySelector<HTMLInputElement>('.dokliste input') ?? $<HTMLInputElement>('input[value="anderes"]')), text: "Bitte wählen Sie ein Dokument oder „Anderes Dokument“." };
          if (dokId === "anderes" && !wert("anderes")) return { el: $("#dok-anderes"), text: "Bitte schreiben Sie kurz, um welches Dokument es geht." };
          return null;
        case "umfang": {
          if (!seitenZaehlen()) return null;
          const n = Number(wert("seiten"));
          return Number.isInteger(n) && n >= 1 && n <= 500 ? null : { el: $("#seiten"), text: "Bitte geben Sie eine Seitenzahl zwischen 1 und 500 an." };
        }
        case "ort":
          return wert("ort") ? null : { el: $("#d-ort"), text: "Bitte geben Sie den Ort des Termins an." };
        case "kontakt":
          if (!wert("name")) return { el: $("#k-name"), text: "Bitte geben Sie Ihren Namen an." };
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(wert("email"))) return { el: $("#k-mail"), text: "Bitte geben Sie eine gültige E-Mail-Adresse an, damit Herr Tanrikulu Ihnen antworten kann." };
          return null;
        default:
          return null;
      }
    }
    function fehlerZeigen(id: string, f: NonNullable<Fehler>) {
      const p = $<HTMLParagraphElement>("[data-fehler]", schritte.get(id)!);
      p.id = `fehler-${id}`;
      p.hidden = false;
      p.textContent = f.text;
      p.setAttribute("role", "alert");
      f.el.setAttribute("aria-invalid", "true");
      f.el.setAttribute("aria-describedby", [f.el.getAttribute("aria-describedby"), p.id].filter((x) => x && !x.includes(p.id)).concat(p.id).join(" "));
      f.el.focus();
    }
    function fehlerWeg(id: string) {
      const s = schritte.get(id)!;
      const p = $<HTMLParagraphElement>("[data-fehler]", s);
      p.hidden = true;
      p.textContent = "";
      s.querySelectorAll("[aria-invalid]").forEach((el) => {
        el.removeAttribute("aria-invalid");
        const rest = (el.getAttribute("aria-describedby") || "").split(" ").filter((x) => x && x !== `fehler-${id}`);
        rest.length ? el.setAttribute("aria-describedby", rest.join(" ")) : el.removeAttribute("aria-describedby");
      });
    }

    // ---------- Anzeigen ----------
    function zeigen(id: string, fokus = true) {
      vorbereiten(id);
      schritte.forEach((el, k) => (el.hidden = k !== id));
      aktuell = id;
      const weg = pfad();
      const nr = weg.indexOf(id) + 1;
      $("[data-nr]").textContent = String(nr);
      $("[data-von]").textContent = String(weg.length);
      $("[data-balken]").style.transform = `scaleX(${nr / weg.length})`;
      $<HTMLButtonElement>("[data-zurueck]").hidden = nr <= 1;
      $<HTMLButtonElement>("[data-weiter]").hidden = id === "zusammenfassung";
      const h = $<HTMLHeadingElement>("h3", schritte.get(id)!);
      $("[data-ansage]").textContent = `Schritt ${nr} von ${weg.length}: ${h.textContent}`;
      if (fokus) h.focus();
    }

    function vorbereiten(id: string) {
      if (id === "dokument") liste();
      if (id === "umfang") {
        const mit = seitenZaehlen();
        $("[data-seiten-feld]").hidden = !mit;
        $("[data-umfang-titel]").textContent = mit ? "Wie viele Seiten, und bis wann?" : "Bis wann brauchen Sie die Übersetzung?";
      }
      if (id === "zusammenfassung") uebersicht();
    }

    function weiter() {
      const f = pruefen(aktuell);
      if (f) return fehlerZeigen(aktuell, f);
      fehlerWeg(aktuell);
      const weg = pfad();
      if (vonUebersicht && weg.every((s) => s === "zusammenfassung" || !pruefen(s))) return zeigen("zusammenfassung");
      zeigen(weg[Math.min(weg.indexOf(aktuell) + 1, weg.length - 1)]);
    }
    function zurueck() {
      const weg = pfad();
      const i = weg.indexOf(aktuell);
      if (i > 0) zeigen(weg[i - 1]);
    }

    form.addEventListener("submit", (e) => { e.preventDefault(); weiter(); });
    $("[data-zurueck]").addEventListener("click", zurueck);
    // Nur eine Auswahl, die direkt mit Maus/Finger auf genau diese Karte getroffen wurde, springt automatisch weiter
    let zeigerZiel: Element | null = null;
    form.addEventListener("pointerdown", (e) => { zeigerZeit = Date.now(); zeigerZiel = (e.target as Element).closest("label"); });

    // Auswahl: mit Maus/Finger geht es nach kurzer Pause automatisch weiter; mit Tastatur bewusst über „Weiter“
    const AUTO = new Set(["leistung", "richtung", "thema", "art", "dauer", "dokument"]);
    form.addEventListener("change", (e) => {
      const el = e.target as HTMLInputElement;
      if (el.type !== "radio") return;
      fehlerWeg(aktuell);
      if (el.name === "thema") { ohneThema = false; const e2 = gewaehlt(); if (e2 && e2.thema.id !== el.value) dokId = ""; }
      if (el.name === "dokument") {
        dokId = el.value;
        const anders = dokId === "anderes";
        $("[data-anderes-feld]").hidden = !anders;
        auswahlZeile();
        if (anders) { $<HTMLInputElement>("#dok-anderes").focus(); return; }
      }
      if (el.name === "leistung") vonUebersicht = false;
      if (AUTO.has(el.name) && zeigerZiel?.contains(el) && Date.now() - zeigerZeit < 1000) {
        zeigerZiel = null;
        const hier = aktuell;
        setTimeout(() => { if (aktuell === hier) weiter(); }, 220);
      }
    });

    $("[data-ohne-thema]").addEventListener("click", () => {
      form.querySelectorAll<HTMLInputElement>('input[name="thema"]').forEach((i) => (i.checked = false));
      ohneThema = true;
      fehlerWeg("thema");
      zeigen("dokument");
    });

    // ---------- Dokumentliste + Suche (ohne Preise) ----------
    const suche = $<HTMLInputElement>("[data-suche]");
    suche.addEventListener("input", () => liste());
    suche.addEventListener("keydown", (e) => { if (e.key === "Enter") e.preventDefault(); });

    function auswahlZeile() {
      const z = $("[data-auswahl]");
      const e = gewaehlt();
      z.hidden = !e;
      z.textContent = e ? `Ihre Auswahl: ${e.dok.name}` : "";
    }

    function liste() {
      const ul = $("[data-dokliste]");
      const q = suche.value.trim();
      const t = themaVon(wert("thema"));
      let eintraege: Eintrag[];
      if (q) {
        eintraege = suchen(q);
        $("[data-treffer]").textContent = eintraege.length ? `${eintraege.length} ${eintraege.length === 1 ? "Dokument" : "Dokumente"} gefunden` : "Kein Dokument gefunden";
        $("[data-listenkopf]").textContent = eintraege.length ? "Treffer aus allen Themen" : "";
      } else {
        eintraege = t ? t.dokumente.map((dok) => ({ dok, thema: t })) : [];
        $("[data-treffer]").textContent = "";
        $("[data-listenkopf]").textContent = t ? `Häufige Dokumente im Thema „${t.titel}“` : "Geben Sie oben ein, wie Ihr Dokument heißt – oder wählen Sie „Anderes Dokument“.";
      }
      const kinder = eintraege.map(({ dok, thema }) => {
        const li = document.createElement("li");
        const label = document.createElement("label");
        label.className = "wahl zeile";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "dokument";
        input.value = dok.id;
        input.checked = dok.id === dokId;
        const innen = document.createElement("span");
        innen.className = "innen";
        const text = document.createElement("span");
        text.className = "text";
        const titel = document.createElement("span");
        titel.className = "titel";
        titel.textContent = dok.name;
        text.append(titel);
        if (q) {
          const unter = document.createElement("span");
          unter.className = "unter";
          unter.textContent = thema.titel;
          text.append(unter);
        }
        const punkt = document.createElement("span");
        punkt.className = "punkt";
        punkt.setAttribute("aria-hidden", "true");
        innen.append(text, punkt);
        label.append(input, innen);
        li.append(label);
        return li;
      });
      if (q && !eintraege.length) {
        const li = document.createElement("li");
        li.className = "leer";
        li.textContent = "Kein passendes Dokument gefunden. Wählen Sie unten „Anderes Dokument“ und schreiben Sie, worum es geht.";
        kinder.push(li);
      }
      ul.replaceChildren(...kinder);
      $<HTMLInputElement>('input[value="anderes"]').checked = dokId === "anderes";
      $("[data-anderes-feld]").hidden = dokId !== "anderes";
      auswahlZeile();
    }

    // Seitenzahl − / +
    const seitenFeld = $<HTMLInputElement>("#seiten");
    $("[data-minus]").addEventListener("click", () => { seitenFeld.value = String(Math.max(1, seiten() - 1)); });
    $("[data-plus]").addEventListener("click", () => { seitenFeld.value = String(Math.min(500, seiten() + 1)); });

    // ---------- Zusammenfassung, Text, Versand ----------
    const RICHTUNG: Record<string, string> = { "tr-de": "Türkisch → Deutsch", "de-tr": "Deutsch → Türkisch" };
    const ART: Record<string, string> = { "vor-ort": "Vor Ort", video: "Per Video", telefon: "Per Telefon" };

    function zeilen(): [string, string, string][] {
      const z: [string, string, string][] = [];
      if (wert("leistung") === "dolmetschen") {
        z.push(["Leistung", "Dolmetschen", "leistung"]);
        const termin = wert("datum") ? datumDe(wert("datum")) + (wert("uhrzeit") ? `, ${wert("uhrzeit")} Uhr` : "") : "noch offen";
        z.push(["Termin", termin, "termin"]);
        z.push(["Art", ART[wert("art")] ?? "", "art"]);
        if (wert("art") === "vor-ort") z.push(["Ort", wert("ort"), "ort"]);
        z.push(["Dauer ca.", wert("dauer"), "dauer"]);
      } else {
        z.push(["Leistung", "Übersetzung", "leistung"]);
        z.push(["Sprachrichtung", RICHTUNG[wert("richtung")] ?? "", "richtung"]);
        const e = gewaehlt();
        const t = e?.thema ?? themaVon(wert("thema"));
        if (t) z.push(["Thema", t.titel, "thema"]);
        z.push(["Dokument", e ? e.dok.name : `Anderes Dokument: ${wert("anderes")}`, "dokument"]);
        if (seitenZaehlen()) z.push(["Seiten ca.", String(seiten()), "umfang"]);
        z.push(["Wunschtermin", wert("wunsch") ? datumDe(wert("wunsch")) : "keiner angegeben", "umfang"]);
      }
      z.push(["Name", wert("name"), "kontakt"]);
      z.push(["E-Mail", wert("email"), "kontakt"]);
      if (wert("tel")) z.push(["Telefon", wert("tel"), "kontakt"]);
      return z;
    }

    function preis() {
      if (wert("leistung") === "dolmetschen") return { wert: "", hinweis: "", ohne: "Das Honorar nennt Ihnen Herr Tanrikulu nach individueller Absprache." };
      const e = gewaehlt();
      if (!e) return { wert: "", hinweis: "", ohne: "Preis nach Sichtung des Dokuments." };
      const n = seiten();
      const basis = e.dok.einheit === "seite"
        ? `Berechnet für ca. ${n} ${n === 1 ? "Seite" : "Seiten"}, pro Seite der fertigen Übersetzung, Mindestpreis ${MINDESTPREIS} €.`
        : `Pro Dokument, Mindestpreis ${MINDESTPREIS} €.`;
      return { wert: spanne(richtwert(e.dok, n)), hinweis: `${basis} Verbindlich ist erst der Kostenvoranschlag nach Sichtung des Dokuments.`, ohne: "" };
    }

    function uebersicht() {
      const dl = $("[data-uebersicht]");
      const reihen = zeilen().map(([k, v, schritt]) => {
        const div = document.createElement("div");
        const dt = document.createElement("dt");
        dt.textContent = k;
        const dd = document.createElement("dd");
        const span = document.createElement("span");
        span.textContent = v;
        const b = document.createElement("button");
        b.type = "button";
        b.className = "textknopf aendern";
        b.dataset.gehe = schritt;
        b.innerHTML = 'Ändern<span class="sr"></span>';
        b.querySelector(".sr")!.textContent = `: ${k}`;
        dd.append(span, b);
        div.append(dt, dd);
        return div;
      });
      if (wert("nachricht")) {
        const div = document.createElement("div");
        div.className = "lang";
        const dt = document.createElement("dt");
        dt.textContent = "Nachricht";
        const dd = document.createElement("dd");
        const span = document.createElement("span");
        span.textContent = wert("nachricht");
        const b = document.createElement("button");
        b.type = "button";
        b.className = "textknopf aendern";
        b.dataset.gehe = "kontakt";
        b.innerHTML = 'Ändern<span class="sr">: Nachricht</span>';
        dd.append(span, b);
        div.append(dt, dd);
        reihen.push(div);
      }
      dl.replaceChildren(...reihen);

      const pr = preis();
      $("[data-preis]").hidden = !pr.wert;
      $("[data-preis-wert]").textContent = pr.wert;
      $("[data-preis-hinweis]").textContent = pr.hinweis;
      $("[data-ohne-preis]").hidden = !pr.ohne;
      $("[data-ohne-preis]").textContent = pr.ohne;
      $("[data-foto]").hidden = wert("leistung") === "dolmetschen";
      $("[data-gesendet]").textContent = "";

      const { betreff, text } = nachricht();
      const enc = encodeURIComponent;
      $<HTMLAnchorElement>("[data-senden-mail]").href = `mailto:${MAIL}?subject=${enc(betreff)}&body=${enc(text.replace(/\n/g, "\r\n"))}`;
      $<HTMLAnchorElement>("[data-senden-wa]").href = `${WA}?text=${enc(`${betreff}\n\n${text}`)}`;
    }

    function nachricht() {
      const dolm = wert("leistung") === "dolmetschen";
      const e = gewaehlt();
      const betreff = dolm
        ? `Anfrage Dolmetschen – ${wert("datum") ? datumDe(wert("datum")) : "Termin offen"}`
        : `Anfrage Übersetzung – ${e ? e.dok.name : wert("anderes") || "Anderes Dokument"}`;
      const pr = preis();
      const bau = (notiz: string) => {
        const t = ["Guten Tag Herr Tanrikulu,", "", "ich möchte folgende Anfrage stellen:", ""];
        zeilen().forEach(([k, v]) => t.push(`${k}: ${v}`));
        if (notiz) t.push("", `Nachricht: ${notiz}`);
        if (pr.wert) t.push("", `Unverbindlicher Richtwert laut Website: ${pr.wert}`);
        else if (!dolm) t.push("", "Preis: nach Sichtung des Dokuments");
        if (!dolm) t.push("", "Ein Foto oder Scan des Dokuments schicke ich nach Ihrer Rückmeldung.");
        t.push("", "Viele Grüße", wert("name"));
        return t.join("\n");
      };
      // WhatsApp-/mailto-Links kurz halten (unter ca. 1800 Zeichen): notfalls nur die freie Nachricht kürzen
      let notiz = wert("nachricht");
      let text = bau(notiz);
      while (text.length + betreff.length > 1800 && notiz.length > 0) {
        notiz = notiz.slice(0, Math.max(0, notiz.length - (text.length + betreff.length - 1800) - 2)).trimEnd() + "…";
        if (notiz === "…") notiz = "";
        text = bau(notiz);
      }
      return { betreff, text };
    }

    form.addEventListener("click", (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>("[data-gehe]");
      if (b) { vonUebersicht = true; zeigen(b.dataset.gehe!); }
    });

    const gesendet = $("[data-gesendet]");
    $<HTMLAnchorElement>("[data-senden-mail]").addEventListener("click", (ev) => {
      const a = ev.currentTarget as HTMLAnchorElement;
      if (ENDPOINT) {
        ev.preventDefault();
        const { betreff, text } = nachricht();
        fetch(ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ betreff, text, email: wert("email"), name: wert("name") }) })
          .then((r) => {
            if (!r.ok) throw new Error(String(r.status));
            gesendet.textContent = "Vielen Dank, Ihre Anfrage ist angekommen. Herr Tanrikulu meldet sich bei Ihnen.";
          })
          .catch(() => { location.href = a.href; });
        return;
      }
      gesendet.textContent = `Ihr E-Mail-Programm öffnet sich mit der fertigen Anfrage. Falls nicht, schreiben Sie bitte direkt an ${MAIL} oder nutzen Sie WhatsApp.`;
    });
    $<HTMLAnchorElement>("[data-senden-wa]").addEventListener("click", () => {
      gesendet.textContent = "WhatsApp öffnet sich mit der fertigen Anfrage. Tippen Sie dort auf „Senden“.";
    });

    zeigen("leistung", false);
  }
</script>

