---
// Abschluss jeder Seite (Jamils Konzept: „Benötigen Sie Unterstützung?“ + „Jetzt Kontakt aufnehmen“).
// Überschrift steigt beim Sichtbarwerden ruhig auf (Bauwelt-Bewegung).
import Icon from "./Icon.astro";
import { TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, MAIL, WHATSAPP_LINK, mailLink } from "../daten";
import { p, type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
---
<section class="aufruf dunkel" aria-labelledby="aufruf-titel" data-szene>
  <span class="faden" aria-hidden="true"></span>
  <div class="huelle innen">
    <div class="frage">
      <h2 id="aufruf-titel">{T.aufruf.titel}</h2>
      <p>{T.aufruf.text}</p>
      <a class="knopf" href={p(lang, "kontakt")}>{T.aufruf.knopf}</a>
    </div>
    <ul class="wege">
      <li><a href={TELEFON_LINK}><Icon name="telefon" /><span class="art">{T.ui.telefon}</span><span class:list={["wert", { unbestaetigt: markieren }]}>{TELEFON}</span></a></li>
      <li><a href={WHATSAPP_LINK} rel="noopener"><Icon name="whatsapp" /><span class="art">{T.ui.whatsapp}</span><span class="wert">{T.ui.whatsappLang}</span></a></li>
      <li><a href={mailLink(T.ui.mailBetreff)}><Icon name="mail" /><span class="art">{T.ui.email}</span><span class="wert">{MAIL}</span></a></li>
      <li><span class="ohne"><Icon name="ort" /><span class="art">{T.ui.standort}</span><span class="wert">{T.fakten.ort}</span></span></li>
    </ul>
  </div>
</section>
<style>
  .aufruf { position: relative; overflow: hidden; padding-block: clamp(4rem, 9vw, 6.5rem); background: var(--tinte-2); }
  .faden { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--tinte-3); }
  .innen { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 56rem) { .innen { grid-template-columns: 1.2fr 1fr; gap: 5rem; } }
  .frage h2 { animation: rise var(--dur-reveal) var(--ease) both; }
  .frage p { color: var(--hell-leise); font-size: 1.15rem; margin-bottom: 1.75rem; max-width: 30em; }
  .wege { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--tinte-3); position: relative; z-index: 1; }
  .wege a, .wege .ohne {
    display: grid; grid-template-columns: auto 1fr; gap: 0 1rem; align-items: center;
    padding: 1rem 0; border-bottom: 1px solid var(--tinte-3); text-decoration: none; color: var(--hell);
  }
  .wege :global(svg) { grid-row: span 2; width: 1.4rem; height: 1.4rem; color: var(--primaer-leise); }
  .art { font-size: 0.86rem; color: var(--hell-leise); letter-spacing: 0.02em; }
  .wert { font: 500 1.2rem/1.35 var(--sans); overflow-wrap: anywhere; }
  .wege a:hover .wert { color: var(--primaer); text-decoration: underline; text-underline-offset: 0.22em; }
</style>
