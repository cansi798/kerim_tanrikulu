---
// Abschluss jeder Seite (Jamils Konzept: „Benötigen Sie Unterstützung?“ + „Jetzt Kontakt aufnehmen“).
// Szene: der Goldfaden läuft einmal über die Breite (1 s).
import Icon from "./Icon.astro";
import { u, TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, MAIL, mailLink, ORT } from "../daten";
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
---
<section class="aufruf dunkel" aria-labelledby="aufruf-titel" data-szene>
  <span class="faden" aria-hidden="true"></span>
  <div class="huelle innen">
    <div class="frage">
      <h2 id="aufruf-titel">Benötigen Sie Unterstützung?</h2>
      <p>Sie benötigen eine Übersetzung oder einen Dolmetscher? Nehmen Sie Kontakt auf.</p>
      <a class="knopf" href={u("/kontakt/")}>Jetzt Kontakt aufnehmen</a>
    </div>
    <ul class="wege">
      <li><a href={TELEFON_LINK}><Icon name="telefon" /><span class="art">Telefon</span><span class:list={["wert", { unbestaetigt: markieren }]}>{TELEFON}</span></a></li>
      <li><a href={mailLink()}><Icon name="mail" /><span class="art">E-Mail</span><span class="wert">{MAIL}</span></a></li>
      <li><span class="ohne"><Icon name="ort" /><span class="art">Standort</span><span class="wert">{ORT}</span></span></li>
    </ul>
  </div>
</section>
<style>
  .aufruf { position: relative; overflow: hidden; padding-block: clamp(4rem, 9vw, 6.5rem); background: var(--tinte-2); }
  .faden { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: var(--gold); transform-origin: left; animation: breiten 1s var(--sanft) both; }
  .innen { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 56rem) { .innen { grid-template-columns: 1.2fr 1fr; gap: 5rem; } }
  .frage h2 { animation: auftauchen 0.7s var(--sanft) 0.15s both; }
  .frage p { color: var(--hell-leise); font-size: 1.15rem; margin-bottom: 1.75rem; max-width: 30em; }
  .wege { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--tinte-3); position: relative; z-index: 1; }
  .wege a, .wege .ohne {
    display: grid; grid-template-columns: auto 1fr; gap: 0 1rem; align-items: center;
    padding: 1rem 0; border-bottom: 1px solid var(--tinte-3); text-decoration: none; color: var(--hell);
  }
  .wege :global(svg) { grid-row: span 2; width: 1.4rem; height: 1.4rem; color: var(--gold-dunkel); }
  .art { font-size: 0.86rem; color: var(--hell-leise); letter-spacing: 0.02em; }
  .wert { font: 500 1.2rem/1.35 var(--sans); overflow-wrap: anywhere; }
  .wege a:hover .wert { color: var(--gold-hell); }
</style>
