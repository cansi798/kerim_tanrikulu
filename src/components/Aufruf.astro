---
// Abschluss jeder Seite (Jamils Konzept: „Benötigen Sie Unterstützung?“ + „Jetzt Kontakt aufnehmen“)
import Icon from "./Icon.astro";
import { u, TELEFON, TELEFON_LINK, MAIL, mailLink, ORT } from "../daten";
---
<section class="aufruf" aria-labelledby="aufruf-titel">
  <div class="huelle rahmen einblenden">
    <div class="frage">
      <h2 id="aufruf-titel">Benötigen Sie Unterstützung?</h2>
      <p>Sie benötigen eine Übersetzung oder einen Dolmetscher? Nehmen Sie Kontakt auf.</p>
      <a class="knopf" href={u("/kontakt/")}>Jetzt Kontakt aufnehmen</a>
    </div>
    <ul class="wege">
      <li><a href={TELEFON_LINK}><Icon name="telefon" /><span class="art">Telefon</span><span class="wert">{TELEFON}</span></a></li>
      <li><a href={mailLink()}><Icon name="mail" /><span class="art">E-Mail</span><span class="wert">{MAIL}</span></a></li>
      <li><span class="ohne"><Icon name="ort" /><span class="art">Standort</span><span class="wert">{ORT}</span></span></li>
    </ul>
  </div>
</section>
<style>
  .aufruf { padding-block: clamp(3.5rem, 8vw, 6rem); border-top: 1px solid var(--linie); }
  .rahmen {
    display: grid; gap: 2.5rem; align-items: center;
    padding: clamp(1.75rem, 5vw, 3.5rem); background: var(--papier);
    border: 1px solid var(--linie); outline: 1px solid var(--linie); outline-offset: -8px;
  }
  @media (min-width: 56rem) { .rahmen { grid-template-columns: 1.2fr 1fr; gap: 4rem; } }
  .frage p { margin-bottom: 1.75rem; }
  .wege { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--linie); }
  .wege a, .wege .ohne {
    display: grid; grid-template-columns: auto 1fr; gap: 0 0.9rem; align-items: center;
    padding: 0.9rem 0; border-bottom: 1px solid var(--linie); color: var(--text); text-decoration: none;
  }
  .wege :global(svg) { grid-row: span 2; width: 1.35rem; height: 1.35rem; color: var(--messing); }
  .art { font-size: 0.88rem; color: var(--text-leise); letter-spacing: 0.03em; }
  .wert { font: 400 1.35rem/1.3 var(--caslon); color: var(--tinte); overflow-wrap: anywhere; }
  .wege a:hover .wert { text-decoration: underline; text-decoration-color: var(--messing); text-underline-offset: 0.2em; }
</style>
