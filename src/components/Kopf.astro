---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, u, TELEFON, TELEFON_LINK, MAIL, mailLink, ORT } from "../daten";
const pfad = Astro.url.pathname.replace(/\/?$/, "/");
const aktiv = (href: string) => pfad === u(href).replace(/\/?$/, "/");
---
<div class="leiste dunkel">
  <div class="huelle leiste-innen">
    <a href={TELEFON_LINK}><Icon name="telefon" />{TELEFON}</a>
    <a href={mailLink()}><Icon name="mail" />{MAIL}</a>
    <span><Icon name="ort" />{ORT}</span>
  </div>
</div>
<header class="kopf">
  <div class="huelle kopf-innen">
    <a class="marke" href={u("/")} aria-label="Tanrikulu Translations, zur Startseite"><Logo /></a>
    <nav class="nav-breit" aria-label="Hauptnavigation">
      <ul>
        {NAV.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? "page" : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <details class="nav-schmal">
      <summary><span class="zu"><Icon name="menue" /></span><span class="auf"><Icon name="schliessen" /></span>Menü</summary>
      <nav aria-label="Hauptnavigation">
        <ul>
          {NAV.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? "page" : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .leiste { background: var(--tinte-tief); color: #dfe5ef; font-size: 0.95rem; display: none; }
  @media (min-width: 60rem) { .leiste { display: block; } }
  .leiste-innen { display: flex; justify-content: flex-end; gap: 2rem; min-height: 2.6rem; align-items: center; }
  .leiste a, .leiste span { display: inline-flex; align-items: center; gap: 0.45rem; color: inherit; text-decoration: none; }
  .leiste a:hover { color: #fff; text-decoration: underline; }
  .leiste :global(svg) { width: 1.05rem; height: 1.05rem; }

  .kopf { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.97); border-bottom: 1px solid var(--linie); }
  .kopf-innen { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 4.75rem; }
  .marke { display: block; padding-block: 0.6rem; }
  .marke :global(.logo) { width: 11.5rem; }
  @media (min-width: 60rem) { .marke :global(.logo) { width: 13rem; } }

  .nav-breit { display: none; }
  .nav-breit ul { list-style: none; display: flex; gap: 0.25rem; margin: 0; padding: 0; }
  .nav-breit a {
    display: block; padding: 0.65rem 0.7rem; color: var(--text); text-decoration: none; font-size: 0.98rem;
    border-bottom: 2px solid transparent;
  }
  .nav-breit a:hover { color: var(--tinte); border-bottom-color: var(--linie); }
  .nav-breit a[aria-current="page"] { color: var(--tinte); font-weight: 700; border-bottom-color: var(--kordel); }
  @media (min-width: 66rem) { .nav-breit { display: block; } .nav-schmal { display: none; } }

  .nav-schmal summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 3rem; padding: 0.5rem 0.9rem; border: 2px solid var(--tinte); border-radius: var(--radius);
    color: var(--tinte); font-weight: 700;
  }
  .nav-schmal summary::-webkit-details-marker { display: none; }
  .nav-schmal .auf { display: none; }
  .nav-schmal[open] .auf { display: inline-flex; }
  .nav-schmal[open] .zu { display: none; }
  .nav-schmal nav {
    position: absolute; left: 0; right: 0; top: 100%;
    background: #fff; border-bottom: 1px solid var(--linie); box-shadow: 0 12px 24px rgba(19, 30, 55, 0.12);
  }
  .nav-schmal ul { list-style: none; margin: 0; padding: 0.5rem var(--rand) 1rem; }
  .nav-schmal a { display: block; padding: 0.85rem 0; border-bottom: 1px solid var(--loeschblatt); color: var(--text); text-decoration: none; font-size: 1.1rem; }
  .nav-schmal a[aria-current="page"] { color: var(--tinte); font-weight: 700; }
</style>
