---
// Kopfzeile nach Bauwelt-Muster (Jamil Talk 3910): Logo links, Navigation, Telefon, Hauptknopf, goldene Fortschrittsleiste.
// v4: Sprachwahl DE | TR (auch mobil sichtbar), führt auf die entsprechende Seite der anderen Sprache. Menü am Handy ohne JS (<details>).
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, mailLink } from "../daten";
import { NAV_SEITEN, p, type Lang, type Seite } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang; seite: Seite | null }
const { lang, seite } = Astro.props;
const T = t(lang);
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
const sprachen: Lang[] = ["de", "tr"];
---
<header class="kopf">
  <div class="huelle kopf-innen">
    <a class="marke" href={p(lang, "start")} aria-label={T.ui.zurStart}><Logo /></a>
    <nav class="nav-breit" aria-label={T.ui.hauptnav}>
      <ul>
        {NAV_SEITEN.map((s) => <li><a href={p(lang, s)} aria-current={seite === s ? "page" : undefined}>{T.nav[s]}</a></li>)}
      </ul>
    </nav>
    <a class="anruf" href={TELEFON_LINK} title={markieren ? T.ui.telefonPruefen : undefined}><Icon name="telefon" /><span class:list={{ unbestaetigt: markieren }}>{TELEFON}</span></a>
    <nav class="sprache" aria-label={T.ui.sprache}>
      {sprachen.map((l) => (
        <a href={p(l, seite ?? "start")} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined} title={T.ui.spracheName[l]}>
          <span aria-hidden="true">{l.toUpperCase()}</span><span class="sr">{T.ui.spracheName[l]}</span>
        </a>
      ))}
    </nav>
    <a class="knopf kopf-cta" href={mailLink(T.ui.anfrageBetreff)}>{T.ui.anfrage}</a>
    <details class="nav-schmal">
      <summary><span class="zu"><Icon name="menue" /></span><span class="auf"><Icon name="schliessen" /></span><span>{T.ui.menue}</span></summary>
      <nav aria-label={T.ui.hauptnavMobil}>
        <ul>
          <li><a href={p(lang, "start")} aria-current={seite === "start" ? "page" : undefined}>{T.nav.start}</a></li>
          {NAV_SEITEN.map((s) => <li><a href={p(lang, s)} aria-current={seite === s ? "page" : undefined}>{T.nav[s]}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
  <div class="kopf-balken" aria-hidden="true"><span></span></div>
</header>
<style>
  .kopf {
    position: sticky; top: 0; z-index: 50; background: var(--creme); color: var(--text); --logo-grund: var(--creme);
    border-bottom: 1px solid var(--tinte-3); transition: box-shadow 0.3s ease;
  }
  .kopf.gescrollt { box-shadow: 0 10px 28px -16px rgba(43, 36, 31, 0.35); }
  .kopf-innen { display: flex; align-items: center; gap: 0.9rem; height: var(--kopf-h); }
  .marke { display: block; margin-right: auto; color: var(--hell); flex: none; }
  .marke :global(.logo) { width: 9.5rem; height: auto; }
  @media (min-width: 26rem) { .marke :global(.logo) { width: 10.5rem; } }
  @media (min-width: 90rem) { .marke :global(.logo) { width: 11.5rem; } }

  .nav-breit { display: none; }
  .nav-breit ul { list-style: none; display: flex; gap: 0; margin: 0; padding: 0; }
  .nav-breit a {
    position: relative; display: block; padding: 0.6rem 0.5rem; color: var(--hell);
    text-decoration: none; font-size: 0.95rem; white-space: nowrap;
  }
  .nav-breit a::after {
    content: ""; position: absolute; left: 0.5rem; right: 0.5rem; bottom: 0.3rem; height: 1px; background: var(--gold);
    transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--sanft);
  }
  /* aktuelle Seite: Farbe + Gewicht statt dauerhafter Linie (v5, Jamil 3957); Linie nur beim Darüberfahren */
  .nav-breit a:hover::after { transform: scaleX(1); }
  .nav-breit a[aria-current="page"] { color: var(--gold-hell); font-weight: 600; }

  /* Sprachwahl: zwei kleine Felder, aktive Sprache dunkel hinterlegt */
  .sprache { display: flex; flex: none; border: 1px solid var(--gold); border-radius: 999px; padding: 2px; }
  .sprache a {
    display: grid; place-items: center; min-width: 2.75rem; min-height: 2.75rem; padding: 0 0.55rem; border-radius: 999px;
    color: var(--text); text-decoration: none; font: 600 0.85rem/1 var(--sans); letter-spacing: 0.06em;
  }
  .sprache a:hover { background: var(--tinte-2); }
  .sprache a[aria-current="true"] { background: var(--tinte); color: var(--weiss); }

  .anruf { display: none; align-items: center; gap: 0.5rem; color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.98rem; white-space: nowrap; }
  .anruf :global(svg) { width: 1.15rem; height: 1.15rem; color: var(--gold-dunkel); }
  .kopf-cta { display: none; min-height: 2.75rem; padding: 0.55rem 1.2rem; font-size: 0.92rem; white-space: nowrap; }
  .kopf-balken { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; overflow: hidden; }
  .kopf-balken span { display: block; height: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left center; }
  @media (min-width: 80rem) { .nav-breit { display: block; } .nav-schmal { display: none; } .kopf-cta { display: inline-flex; } }
  @media (min-width: 100rem) { .anruf { display: inline-flex; } }

  .nav-schmal summary {
    display: flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.4rem 0.85rem;
    border: 1px solid var(--gold); border-radius: 999px; cursor: pointer; list-style: none; font-size: 0.98rem;
  }
  .nav-schmal summary::-webkit-details-marker { display: none; }
  .nav-schmal summary :global(svg) { width: 1.2rem; height: 1.2rem; }
  @media (max-width: 25.99rem) { .nav-schmal summary > span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  .nav-schmal .auf, .nav-schmal[open] .zu { display: none; }
  .nav-schmal[open] .auf { display: inline; }
  .nav-schmal nav {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--creme); border-bottom: 1px solid var(--tinte-3);
    box-shadow: 0 24px 40px -24px rgba(43, 36, 31, 0.35); max-height: calc(100svh - var(--kopf-h)); overflow-y: auto;
  }
  .nav-schmal ul { list-style: none; margin: 0; padding: 0.5rem var(--rand) 1.25rem; }
  .nav-schmal li a {
    display: block; padding: 0.8rem 0; border-bottom: 1px solid var(--tinte-3); color: var(--hell);
    text-decoration: none; font: 500 1.3rem/1.3 var(--serif);
  }
  .nav-schmal li a[aria-current="page"] { color: var(--gold-hell); }
  @media (prefers-reduced-motion: no-preference) {
    .nav-schmal[open] nav { animation: einblenden 0.25s ease both; }
  }
</style>
