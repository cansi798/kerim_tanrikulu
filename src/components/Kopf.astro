---
// Kopfzeile nach Bauwelt-Muster (Jamil Talk 3910): Logo links, Navigation, Telefon, Hauptknopf, feine Fortschrittsleiste.
// v4: Sprachwahl DE | TR (auch mobil sichtbar), führt auf die entsprechende Seite der anderen Sprache. Menü am Handy ohne JS (<details>).
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, WHATSAPP_LINK } from "../daten";
import { KOPF_NAV, p, anfrageLink, type Lang, type Seite } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang; seite: Seite | null }
const { lang, seite } = Astro.props;
const T = t(lang);
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
const sprachen: Lang[] = ["de", "tr"];
const PFEIL = "M6 9l6 6 6-6";
---
<header class="kopf">
  <div class="huelle kopf-innen">
    <a class="marke" href={p(lang, "start")} aria-label={T.ui.zurStart}><Logo /></a>
    <!-- Übersetzungen und Dolmetschen unter „Leistungen“ (Jamil Talk xidc8qvq #5315, 09.11.2026): Aufklappmenü per Maus, Klick und
         Tastatur (Enter/Leertaste öffnen und schließen, Pfeil runter springt in die Liste, Escape schließt); ohne JS per Hover/Fokus -->
    <nav class="nav-breit" aria-label={T.ui.hauptnav}>
      <ul>
        {KOPF_NAV.map((e) => typeof e === "string" ? (
          <li><a href={p(lang, e)} aria-current={seite === e ? "page" : undefined}>{T.nav[e]}</a></li>
        ) : (
          <li class="nav-gruppe" data-nav-gruppe>
            <button type="button" class="gruppe-knopf" aria-expanded="false" aria-controls="nav-leistungen" data-aktiv={seite && e.seiten.includes(seite) ? "" : undefined}>
              {T.nav.leistungen}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={PFEIL} /></svg>
            </button>
            <ul class="unter" id="nav-leistungen">
              {e.seiten.map((s) => <li><a href={p(lang, s)} aria-current={seite === s ? "page" : undefined}>{T.nav[s]}</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </nav>
    <a class="anruf" href={TELEFON_LINK} title={markieren ? T.ui.telefonPruefen : undefined}><Icon name="telefon" /><span class:list={{ unbestaetigt: markieren }}>{TELEFON}</span></a>
    <!-- WhatsApp neben der Nummer (Jamil Talk 3994), runder Symbol-Knopf -->
    <a class="wa-kopf" href={WHATSAPP_LINK} rel="noopener" aria-label={T.ui.whatsappLabel} title={T.ui.whatsappLang}><Icon name="whatsapp" /></a>
    <nav class="sprache" aria-label={T.ui.sprache}>
      {sprachen.map((l) => (
        <a href={p(l, seite ?? "start")} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined} title={T.ui.spracheName[l]}>
          <span aria-hidden="true">{l.toUpperCase()}</span><span class="sr">{T.ui.spracheName[l]}</span>
        </a>
      ))}
    </nav>
    <a class="knopf kopf-cta" href={anfrageLink(lang, T.ui.anfrageBetreff, seite)}>{T.ui.anfrage}</a>
    <details class="nav-schmal">
      <summary><span class="zu"><Icon name="menue" /></span><span class="auf"><Icon name="schliessen" /></span><span>{T.ui.menue}</span></summary>
      <nav aria-label={T.ui.hauptnavMobil}>
        <ul>
          <li><a href={p(lang, "start")} aria-current={seite === "start" ? "page" : undefined}>{T.nav.start}</a></li>
          {KOPF_NAV.map((e) => typeof e === "string" ? (
            <li><a href={p(lang, e)} aria-current={seite === e ? "page" : undefined}>{T.nav[e]}</a></li>
          ) : (
            <li class="m-gruppe">
              <span class="m-kopf" id="m-leistungen">{T.nav.leistungen}</span>
              <ul aria-labelledby="m-leistungen">
                {e.seiten.map((s) => <li><a href={p(lang, s)} aria-current={seite === s ? "page" : undefined}>{T.nav[s]}</a></li>)}
              </ul>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
  <div class="kopf-balken" aria-hidden="true"><span></span></div>
</header>
<script>
  // Aufklappmenü „Leistungen“ (Jamil #5315): Zustand nur über aria-expanded / data-offen
  document.querySelectorAll<HTMLElement>("[data-nav-gruppe]").forEach((gruppe) => {
    const knopf = gruppe.querySelector<HTMLButtonElement>(".gruppe-knopf")!;
    const links = () => [...gruppe.querySelectorAll<HTMLAnchorElement>(".unter a")];
    let zu: number | undefined;
    const setzen = (offen: boolean) => {
      clearTimeout(zu);
      knopf.setAttribute("aria-expanded", String(offen));
      offen ? (gruppe.dataset.offen = "") : delete gruppe.dataset.offen;
    };
    let perMaus = false; // per Darüberfahren geöffnet: der folgende Klick soll es nicht gleich wieder schließen
    knopf.addEventListener("click", () => { if (perMaus) { perMaus = false; setzen(true); } else setzen(knopf.getAttribute("aria-expanded") !== "true"); });
    knopf.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); setzen(true); links()[0]?.focus(); }
    });
    gruppe.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && gruppe.hasAttribute("data-offen")) { e.preventDefault(); setzen(false); knopf.focus(); }
      const l = links(), i = l.indexOf(e.target as HTMLAnchorElement); // nur Tasten auf den Links selbst (nicht auf dem Knopf)
      if (i >= 0 && (e.key === "ArrowDown" || e.key === "ArrowUp")) { e.preventDefault(); l[(i + (e.key === "ArrowDown" ? 1 : l.length - 1)) % l.length].focus(); }
    });
    gruppe.addEventListener("focusout", (e) => { if (!gruppe.contains(e.relatedTarget as Node | null)) setzen(false); });
    // Maus: öffnet beim Darüberfahren, schließt kurz nach dem Verlassen (Finger/Stift nutzen den Klick)
    gruppe.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse" && !gruppe.hasAttribute("data-offen")) { perMaus = true; setzen(true); } else clearTimeout(zu); });
    gruppe.addEventListener("pointerleave", (e) => { if (e.pointerType === "mouse") { clearTimeout(zu); zu = window.setTimeout(() => { perMaus = false; setzen(false); }, 180); } });
    document.addEventListener("click", (e) => { if (!gruppe.contains(e.target as Node)) setzen(false); });
  });
</script>
<style>
  .kopf {
    position: sticky; top: 0; z-index: 50; /* Kopf in Primär (Jamil 06.11.2026): helle Schrift und helles Logo, Gold nur am Hauptknopf */
    background: var(--primaer); color: var(--auf-dunkel); --logo: var(--auf-dunkel); --logo-grund: var(--primaer);
    --hell: var(--auf-dunkel); --text: var(--auf-dunkel); --tinte-2: var(--primaer-hell); --tinte-3: var(--linie-dunkel);
    border-bottom: 1px solid var(--linie-dunkel); transition: box-shadow 0.3s ease;
  }
  .kopf.gescrollt { box-shadow: 0 10px 28px -16px rgba(10, 20, 40, 0.45); }
  .kopf-innen { display: flex; align-items: center; gap: 0.9rem; height: var(--kopf-h); }
  .marke { display: block; margin-right: auto; color: var(--hell); flex: none; }
  .marke :global(.logo) { width: 9.5rem; height: auto; }
  @media (min-width: 26rem) { .marke :global(.logo) { width: 10.5rem; } }
  /* 320 px (Formular-Prüfung 09.11.2026): Kopf war 4 px zu breit → etwas engere Abstände und kleineres Logo, kein Querscrollen */
  @media (min-width: 90rem) { .marke :global(.logo) { width: 11.5rem; } }

  .nav-breit { display: none; }
  .nav-breit ul { list-style: none; display: flex; gap: 0; margin: 0; padding: 0; }
  .nav-breit a {
    position: relative; display: block; padding: 0.6rem 0.5rem; color: var(--hell);
    text-decoration: none; font-size: 0.95rem; white-space: nowrap;
  }
  .nav-breit a::after {
    content: ""; position: absolute; left: 0.5rem; right: 0.5rem; bottom: 0.3rem; height: 1px; background: var(--sekundaer);
    transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--sanft);
  }
  /* aktuelle Seite: Farbe + Gewicht statt dauerhafter Linie (v5, Jamil 3957); Linie nur beim Darüberfahren */
  .nav-breit a:hover::after { transform: scaleX(1); }
  .nav-breit a[aria-current="page"] { color: var(--sekundaer); font-weight: 700; }
  /* Aufklappmenü „Leistungen“ */
  .nav-gruppe { position: relative; }
  .gruppe-knopf {
    display: flex; align-items: center; gap: 0.3rem; min-height: 2.75rem; padding: 0.6rem 0.5rem; border: 0; background: none; cursor: pointer;
    color: var(--hell); font: inherit; font-size: 0.95rem; white-space: nowrap;
  }
  .gruppe-knopf svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.25s var(--sanft); }
  .gruppe-knopf[aria-expanded="true"] svg { transform: rotate(180deg); }
  .gruppe-knopf[data-aktiv] { color: var(--sekundaer); font-weight: 700; }
  .gruppe-knopf:hover { color: var(--sekundaer); }
  .gruppe-knopf:focus-visible { outline: 2px solid var(--sekundaer); outline-offset: 2px; border-radius: 4px; }
  .nav-breit .unter {
    display: none; position: absolute; left: -0.5rem; top: 100%; z-index: 60; min-width: 13.5rem; margin: 0; padding: 0.5rem;
    flex-direction: column; background: var(--primaer); border: 1px solid var(--linie-dunkel); border-radius: 12px; box-shadow: 0 22px 40px -22px rgba(10, 20, 40, 0.55);
  }
  .nav-breit .unter::before { content: ""; position: absolute; left: 0; right: 0; top: -0.75rem; height: 0.75rem; } /* Brücke für die Maus */
  .nav-breit .unter a { padding: 0.7rem 0.85rem; border-radius: 8px; font-size: 0.98rem; }
  .nav-breit .unter a::after { left: 0.85rem; right: 0.85rem; bottom: 0.45rem; }
  .nav-breit .unter a:hover, .nav-breit .unter a:focus-visible { background: var(--primaer-hell); }
  .nav-gruppe[data-offen] .unter { display: flex; }
  :global(html:not(.js)) .nav-gruppe:is(:hover, :focus-within) .unter { display: flex; }
  @media (prefers-reduced-motion: no-preference) { .nav-gruppe[data-offen] .unter { animation: einblenden 0.2s ease both; } }

  /* Sprachwahl: zwei kleine Felder, aktive Sprache dunkel hinterlegt */
  .sprache { display: flex; flex: none; border: 1px solid rgba(239, 230, 214, 0.55); border-radius: 999px; padding: 2px; }
  .sprache a {
    display: grid; place-items: center; min-width: 2.75rem; min-height: 2.75rem; padding: 0 0.55rem; border-radius: 999px;
    color: var(--text); text-decoration: none; font: 600 0.85rem/1 var(--sans); letter-spacing: 0.06em;
  }
  .sprache a:hover { background: var(--tinte-2); }
  .sprache a[aria-current="true"] { background: var(--sekundaer); color: var(--primaer); }

  .anruf { display: none; align-items: center; gap: 0.5rem; color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.98rem; white-space: nowrap; }
  .anruf :global(svg) { width: 1.15rem; height: 1.15rem; color: var(--sekundaer); }
  .wa-kopf { display: none; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid rgba(239, 230, 214, 0.55); color: var(--sekundaer); }
  .wa-kopf:hover { background: var(--tinte-2); }
  .wa-kopf :global(svg) { width: 1.3rem; height: 1.3rem; }
  .kopf-cta { display: none; min-height: 2.75rem; padding: 0.55rem 1.2rem; font-size: 0.92rem; white-space: nowrap; }
  .kopf-balken { position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; overflow: hidden; }
  .kopf-balken span { display: block; height: 100%; background: var(--deko); transform: scaleX(0); transform-origin: left center; }
  @media (min-width: 80rem) { .nav-breit { display: block; } .nav-schmal { display: none; } .kopf-cta { display: inline-flex; } }
  @media (min-width: 100rem) { .anruf { display: inline-flex; } }
  @media (min-width: 80rem) { .wa-kopf { display: grid; } }

  .nav-schmal summary {
    display: flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0.4rem 0.85rem;
    border: 1px solid rgba(239, 230, 214, 0.55); border-radius: 999px; cursor: pointer; list-style: none; font-size: 0.98rem;
  }
  .nav-schmal summary::-webkit-details-marker { display: none; }
  /* Audit 09.11.2026 (M1): Knopf und Symbol dürfen nicht schrumpfen – bei 320/360 px war das Menü-Symbol 0/16 px breit */
  .nav-schmal { flex: none; }
  .nav-schmal summary > .zu, .nav-schmal summary > .auf { flex: none; line-height: 0; }
  .nav-schmal summary :global(svg) { width: 1.2rem; height: 1.2rem; flex: none; }
  @media (max-width: 25.99rem) { .nav-schmal summary > span:last-child { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  .nav-schmal .auf, .nav-schmal[open] .zu { display: none; }
  .nav-schmal[open] .auf { display: inline; }
  .nav-schmal nav {
    position: absolute; left: 0; right: 0; top: 100%; background: var(--primaer); border-bottom: 1px solid var(--linie-dunkel);
    box-shadow: 0 24px 40px -24px rgba(10, 20, 40, 0.45); max-height: calc(100svh - var(--kopf-h)); overflow-y: auto;
  }
  .nav-schmal ul { list-style: none; margin: 0; padding: 0.5rem var(--rand) 1.25rem; }
  .nav-schmal li a {
    display: block; padding: 0.8rem 0; border-bottom: 1px solid var(--tinte-3); color: var(--hell);
    text-decoration: none; font: 500 1.3rem/1.3 var(--serif);
  }
  .nav-schmal li a[aria-current="page"] { color: var(--sekundaer); font-weight: 700; }
  /* Handy-Menü: „Leistungen“ als Gruppenkopf, darunter Übersetzungen und Dolmetschen eingerückt */
  .m-kopf { display: block; padding: 0.9rem 0 0.3rem; font: 600 0.82rem/1.5 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--sekundaer); }
  .nav-schmal .m-gruppe ul { padding: 0 0 0 1rem; border-left: 1px solid var(--tinte-3); margin: 0 0 0.25rem; }
  .nav-schmal .m-gruppe li a { font-size: 1.2rem; }
  @media (prefers-reduced-motion: no-preference) {
    .nav-schmal[open] nav { animation: einblenden 0.25s ease both; }
  }
  /* Audit 09.11.2026 (M1): mit nicht schrumpfendem Menü-Symbol enger setzen (am Ende, damit es die Grundregeln oben überschreibt) – 360 px: kleinere Abstände; 320 px: Logo 8,25rem, Sprachfelder je 40 px */
  @media (max-width: 25.99rem) { .kopf-innen { gap: 0.6rem; } .nav-schmal summary { padding-inline: 0.7rem; } }
  @media (max-width: 22.49rem) {
    .kopf-innen { gap: 0.45rem; } .marke :global(.logo) { width: 8.25rem; }
    .sprache a { min-width: 2.5rem; padding-inline: 0.4rem; } .nav-schmal summary { padding-inline: 0.6rem; }
  }
</style>
