---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, u, TELEFON, TELEFON_LINK } from "../daten";
const pfad = Astro.url.pathname.replace(/\/?$/, "/");
const aktiv = (href: string) => pfad === u(href).replace(/\/?$/, "/");
const start = aktiv("/");
---
<header class="kopf">
  <div class="huelle kopf-innen">
    <a class="marke" href={u("/")} aria-label="Tanrikulu Translations, zur Startseite"><Logo animiert={start} /></a>
    <nav class="nav-breit" aria-label="Hauptnavigation">
      <ul>
        {NAV.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? "page" : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="anruf" href={TELEFON_LINK}><Icon name="telefon" /><span>{TELEFON}</span></a>
    <details class="nav-schmal">
      <summary><span class="zu"><Icon name="menue" /></span><span class="auf"><Icon name="schliessen" /></span>Menü</summary>
      <nav aria-label="Hauptnavigation">
        <ul>
          {NAV.map((n) => <li><a href={u(n.href)} aria-current={aktiv(n.href) ? "page" : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
</header>
<style>
  .kopf { position: sticky; top: 0; z-index: 50; background: var(--elfenbein); border-bottom: 1px solid var(--linie); }
  .kopf-innen { display: flex; align-items: center; gap: 1.5rem; min-height: 5rem; }
  .marke { display: block; padding-block: 0.7rem; margin-right: auto; }
  .marke :global(.logo) { width: 11.5rem; }
  @media (min-width: 60rem) { .marke :global(.logo) { width: 13rem; } }

  .nav-breit { display: none; }
  .nav-breit ul { list-style: none; display: flex; gap: 0.15rem; margin: 0; padding: 0; }
  .nav-breit a {
    position: relative; display: block; padding: 0.7rem 0.75rem;
    color: var(--text); text-decoration: none; font-size: 1rem; letter-spacing: 0.01em;
  }
  .nav-breit a::after {
    content: ""; position: absolute; left: 0.75rem; right: 0.75rem; bottom: 0.35rem; height: 1px;
    background: var(--messing); transform: scaleX(0); transform-origin: left; transition: transform 0.35s var(--sanft);
  }
  .nav-breit a:hover { color: var(--tinte); }
  .nav-breit a:hover::after, .nav-breit a[aria-current="page"]::after { transform: scaleX(1); }
  .nav-breit a[aria-current="page"] { color: var(--tinte); font-weight: 500; }

  .anruf { display: none; align-items: center; gap: 0.5rem; padding: 0.55rem 1rem; min-height: 2.9rem;
    border: 1px solid var(--messing); border-radius: var(--ecke); color: var(--tinte); text-decoration: none; font-weight: 500; white-space: nowrap; }
  .anruf:hover { border-color: var(--tinte); background: var(--papier); }
  .anruf :global(svg) { width: 1.1rem; height: 1.1rem; }
  @media (min-width: 68rem) { .nav-breit { display: block; } .nav-schmal { display: none; } }
  @media (min-width: 84rem) { .anruf { display: inline-flex; } }

  .nav-schmal summary {
    list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: 3rem; padding: 0.5rem 1rem; border: 1px solid var(--messing); border-radius: var(--ecke);
    color: var(--tinte); font-weight: 500;
  }
  .nav-schmal summary::-webkit-details-marker { display: none; }
  .nav-schmal .auf { display: none; }
  .nav-schmal[open] .auf { display: inline-flex; }
  .nav-schmal[open] .zu { display: none; }
  .nav-schmal :global(svg) { width: 1.25rem; height: 1.25rem; }
  .nav-schmal nav {
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--elfenbein); border-bottom: 1px solid var(--linie); box-shadow: 0 18px 30px rgba(43, 39, 33, 0.1);
  }
  .nav-schmal ul { list-style: none; margin: 0; padding: 0.5rem var(--rand) 1.25rem; }
  .nav-schmal a { display: block; padding: 0.9rem 0; border-bottom: 1px solid var(--linie); color: var(--text); text-decoration: none; font: 400 1.35rem/1.3 var(--caslon); }
  .nav-schmal a[aria-current="page"] { color: var(--tinte); text-decoration: underline; text-decoration-color: var(--messing); text-underline-offset: 0.25em; }
  @media (prefers-reduced-motion: no-preference) {
    .nav-schmal[open] nav { animation: menue 0.3s var(--sanft) both; }
  }
  @keyframes menue { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
</style>
