---
// Vertrauensbereich: links Überschrift (Slot), rechts die Angaben der bestehenden Website (Zeilen erscheinen nacheinander, 1 s).
// Bewusst kein Siegel-Motiv (Jamil Talk 3904: „Behördensiegel – nicht vorhanden“).
import { NACHWEISE } from "../daten";
---
<div class="nachweise" data-szene>
  <div class="links">
    <slot />
  </div>
  <dl class="liste">
    {NACHWEISE.map((n, i) => (
      <div class="zeile" data-i={i}><dt>{n.titel}</dt><dd>{n.wert}</dd></div>
    ))}
  </dl>
</div>
<style>
  .nachweise { display: grid; gap: 2.5rem 4rem; align-items: start; }
  @media (min-width: 56rem) { .nachweise { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .liste { margin: 0; border-top: 1px solid var(--linie); }
  .zeile { display: grid; grid-template-columns: minmax(0, 13rem) 1fr; gap: 0.25rem 1.5rem; align-items: baseline; padding: 1.05rem 0; border-bottom: 1px solid var(--linie); }
  @media (max-width: 30rem) { .zeile { grid-template-columns: 1fr; } }
  dt { color: var(--text-leise); font-size: 0.98rem; }
  dd { margin: 0; font: 500 clamp(1.2rem, 2vw, 1.4rem)/1.35 var(--serif); color: var(--tinte); }

  .zeile { animation: auftauchen 0.4s var(--sanft) both; }
  .zeile[data-i="1"] { animation-delay: 0.12s; }
  .zeile[data-i="2"] { animation-delay: 0.24s; }
  .zeile[data-i="3"] { animation-delay: 0.36s; }
  .zeile[data-i="4"] { animation-delay: 0.48s; }
  .zeile[data-i="5"] { animation-delay: 0.6s; }
</style>
