---
// Vertrauensbereich: nur nachweisbare Angaben (Jamils Konzept), aus daten.ts.
// Gestaltet wie ein Urkundenblatt: feiner Doppelrahmen, Angaben als Felder.
import { NACHWEISE } from "../daten";
interface Props { dunkel?: boolean }
const { dunkel = false } = Astro.props;
---
<dl class:list={["nachweise", { dunkel }]}>
  {NACHWEISE.map((n) => <div class="feld"><dt>{n.titel}</dt><dd>{n.wert}</dd></div>)}
</dl>
<style>
  .nachweise {
    display: grid; grid-template-columns: 1fr; margin: 0 0 2rem;
    border: 1px solid var(--linie); outline: 1px solid var(--linie); outline-offset: -7px;
    background: var(--papier); padding: 0.75rem 1.5rem;
  }
  @media (min-width: 36rem) { .nachweise { grid-template-columns: 1fr 1fr; column-gap: 2rem; } }
  .feld { padding: 1rem 0; border-bottom: 1px solid var(--linie); }
  @media (min-width: 36rem) { .feld:nth-last-child(-n + 2) { border-bottom: 0; } }
  @media (max-width: 35.99rem) { .feld:last-child { border-bottom: 0; } }
  dt { font-size: 0.9rem; letter-spacing: 0.03em; color: var(--text-leise); margin-bottom: 0.2rem; }
  dd { margin: 0; font: 400 1.4rem/1.25 var(--caslon); color: var(--tinte); }

  .dunkel { background: transparent; border-color: rgba(217, 189, 133, 0.45); outline-color: rgba(217, 189, 133, 0.45); }
  .dunkel .feld { border-color: rgba(217, 189, 133, 0.3); }
  .dunkel dt { color: var(--messing-hell); }
  .dunkel dd { color: var(--elfenbein); }
</style>
