---
// Vertrauensbereich: nur nachweisbare Angaben (Jamils Konzept), aus daten.ts
import { NACHWEISE } from "../daten";
---
<dl class="nachweise">
  {NACHWEISE.map((n) => <div><dt>{n.titel}</dt><dd>{n.wert}</dd></div>)}
</dl>
<style>
  .nachweise { display: grid; margin: 0 0 2rem; border-top: 1px solid var(--linie); max-width: 44rem; }
  .nachweise div { display: grid; grid-template-columns: minmax(9rem, 14rem) 1fr; gap: 0.25rem 1.5rem; padding: 0.85rem 0; border-bottom: 1px solid var(--linie); }
  @media (max-width: 30rem) { .nachweise div { grid-template-columns: 1fr; } }
  dt { color: var(--text-leise); }
  dd { margin: 0; font: 600 1.35rem/1.3 var(--serif); color: var(--tinte); }
  /* dezent beim Scrollen, nur wo der Browser Scroll-Animationen kann (sonst sofort sichtbar, auch ohne JS) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .nachweise div { animation: einblenden linear both; animation-timeline: view(); animation-range: entry 0% entry 60%; }
    }
  }
  @keyframes einblenden { from { opacity: 0.2; transform: translateY(8px); } to { opacity: 1; transform: none; } }
</style>
