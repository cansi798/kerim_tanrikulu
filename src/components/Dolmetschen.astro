---
// Kurze Animation „Dolmetschen“ (Jamil, Talk 3892): Eine Aussage in der Sprechblase „Deutsch“ wandert
// über die Feder aus dem Logo und kommt in der Sprechblase „Türkçe“ an. Keine echten Sätze, nur Textzeilen.
// Reines CSS, ein einziger Durchlauf beim Laden, Gesamtdauer genau 1,5 s (letzte Animation endet bei 1,5 s).
// Bei reduzierter Bewegung oder ohne Animationen: sofort das fertige Bild. Dekorativ, daher aria-hidden.
---
<svg class="dolmetschen" viewBox="0 0 400 186" aria-hidden="true" focusable="false">
  <!-- Sprechblase Deutsch -->
  <g class="blase de">
    <path class="rand" d="M22 30H134a14 14 0 0 1 14 14V92a14 14 0 0 1-14 14H56L34 124l4-18H22a14 14 0 0 1-14-14V44a14 14 0 0 1 14-14Z" />
    <rect class="zeile z1" x="26" y="50" width="104" height="5" rx="2.5" />
    <rect class="zeile z2" x="26" y="65" width="86" height="5" rx="2.5" />
    <rect class="zeile z3" x="26" y="80" width="62" height="5" rx="2.5" />
  </g>
  <!-- Weg der Aussage: zur Feder, von der Feder weiter -->
  <path class="weg w1" pathLength="1" d="M150 60 Q 178 40 198 94" />
  <path class="puls p1" pathLength="1" d="M150 60 Q 178 40 198 94" />
  <path class="weg w2" pathLength="1" d="M203 98 Q 228 130 252 110" />
  <path class="puls p2" pathLength="1" d="M203 98 Q 228 130 252 110" />
  <!-- Feder (wie im Logo), Spitze bei 200/96 -->
  <g class="feder">
    <path class="fahne" d="M200 96 C 204 79, 216 57, 248 36 C 246 51, 241 62, 232 72 C 225 80, 213 88, 200 96 Z" />
    <path class="schaft" d="M200 96 L 241 45" />
  </g>
  <!-- Sprechblase Türkçe -->
  <g class="blase tr">
    <path class="rand" d="M266 70H378a14 14 0 0 1 14 14V132a14 14 0 0 1-14 14H362l4 18-22-18H266a14 14 0 0 1-14-14V84a14 14 0 0 1 14-14Z" />
    <rect class="zeile z1" x="270" y="90" width="104" height="5" rx="2.5" />
    <rect class="zeile z2" x="270" y="105" width="90" height="5" rx="2.5" />
    <rect class="zeile z3" x="270" y="120" width="58" height="5" rx="2.5" />
  </g>
  <text class="sprache de-t" x="78" y="152" text-anchor="middle">Deutsch</text>
  <text class="sprache tr-t" x="322" y="182" text-anchor="middle" lang="tr">Türkçe</text>
</svg>
<style>
  .dolmetschen { width: 100%; height: auto; overflow: visible; }
  .rand { fill: var(--papier); stroke-width: 1.5; }
  .de .rand { stroke: var(--tinte); }
  .tr .rand { stroke: var(--messing); }
  .de .zeile { fill: var(--tinte); opacity: 0.55; }
  .tr .zeile { fill: var(--messing); opacity: 0.8; }
  .weg { fill: none; stroke-width: 1.5; stroke-linecap: round; }
  .w1 { stroke: var(--tinte); }
  .w2 { stroke: var(--messing); }
  .puls { fill: none; stroke-width: 5; stroke-linecap: round; stroke-dasharray: 0.08 1.2; stroke-dashoffset: -1; opacity: 0; }
  .p1 { stroke: var(--tinte); }
  .p2 { stroke: var(--messing); }
  .fahne { fill: var(--tinte); }
  .schaft { fill: none; stroke: var(--elfenbein); stroke-width: 1.4; stroke-linecap: round; }
  .sprache { font: italic 400 22px var(--caslon-kursiv); fill: var(--tinte); }

  /* Zeitplan (Sekunden): Deutsch 0–0,45 · Weg zur Feder 0,3–0,7 · Feder 0,6–0,9 · Weg weiter 0,7–1,1 · Türkçe 1,0–1,5 */
  @media (prefers-reduced-motion: no-preference) {
    .blase, .feder { transform-box: fill-box; }
    .de { transform-origin: 15% 100%; animation: blase 0.3s var(--sanft) 0s both; }
    .tr { transform-origin: 85% 100%; animation: blase 0.3s var(--sanft) 1s both; }
    .zeile { transform-box: fill-box; transform-origin: left center; }
    .de .z1 { animation: zeile 0.2s ease-out 0.1s both; }
    .de .z2 { animation: zeile 0.2s ease-out 0.18s both; }
    .de .z3 { animation: zeile 0.2s ease-out 0.25s both; }
    .tr .z1 { animation: zeile 0.25s ease-out 1.1s both; }
    .tr .z2 { animation: zeile 0.25s ease-out 1.18s both; }
    .tr .z3 { animation: zeile 0.25s ease-out 1.25s both; }
    .weg { stroke-dasharray: 1; }
    .w1 { animation: weg 0.4s ease-in-out 0.3s both; }
    .w2 { animation: weg 0.4s ease-in-out 0.7s both; }
    .p1 { animation: puls 0.4s ease-in-out 0.3s both; }
    .p2 { animation: puls 0.4s ease-in-out 0.7s both; }
    .feder { transform-origin: 0% 100%; animation: feder 0.3s var(--sanft) 0.6s both; }
    .de-t { animation: auf 0.3s ease 0s both; }
    .tr-t { animation: auf 0.3s ease 1s both; }
  }
  @keyframes blase { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: none; } }
  @keyframes zeile { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes weg { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes puls { 0% { stroke-dashoffset: 0.08; opacity: 1; } 85% { opacity: 1; } 100% { stroke-dashoffset: -1; opacity: 0; } }
  @keyframes feder { 0% { transform: rotate(0deg); } 45% { transform: rotate(-9deg); } 100% { transform: rotate(0deg); } }
  @keyframes auf { from { opacity: 0; } to { opacity: 1; } }
</style>
