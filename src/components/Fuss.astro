---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAME, TELEFON, TELEFON_LINK, TELEFON_BESTAETIGT, VORSCHAU, MAIL, WHATSAPP_LINK, mailLink } from "../daten";
import { NAV_SEITEN, p, type Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = t(lang);
const jahr = new Date().getFullYear();
const markieren = VORSCHAU && !TELEFON_BESTAETIGT;
---
<footer class="fuss">
  <div class="huelle raster">
    <div class="wer">
      <Logo />
      <p>{NAME}<br /><span class="leise">{T.fakten.rolle}</span></p>
    </div>
    <div>
      <h2 class="klein">{T.ui.kontakt}</h2>
      <ul class="liste">
        <li><a href={TELEFON_LINK}><Icon name="telefon" /><span class:list={{ unbestaetigt: markieren }}>{TELEFON}</span></a></li>
        <li><a href={WHATSAPP_LINK} rel="noopener" aria-label={T.ui.whatsappLabel}><Icon name="whatsapp" />{T.ui.whatsapp}</a></li>
        <li><a href={mailLink(T.ui.mailBetreff)}><Icon name="mail" />{MAIL}</a></li>
        <li><span><Icon name="ort" />{T.fakten.ort}</span></li>
      </ul>
    </div>
    <nav aria-label={T.ui.seiten}>
      <h2 class="klein">{T.ui.seiten}</h2>
      <ul class="liste spalten">
        {NAV_SEITEN.map((s) => <li><a href={p(lang, s)}>{T.nav[s]}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="huelle unten">
    <span>© {jahr} {NAME}</span>
    <ul>
      <li><a href={p(lang, "impressum")}>{T.nav.impressum}</a></li>
      <li><a href={p(lang, "datenschutz")}>{T.nav.datenschutz}</a></li>
      <li><a href={p(lang === "de" ? "tr" : "de", "start")} hreflang={lang === "de" ? "tr" : "de"} lang={lang === "de" ? "tr" : "de"}>{lang === "de" ? "Türkçe" : "Deutsch"}</a></li>
    </ul>
  </div>
</footer>
<!-- Handy: Anrufen · WhatsApp · E-Mail immer erreichbar (Jamils Konzept; WhatsApp: Kerim Talk 3993, Jamil 3994). Drei gleich breite Felder, je ≥ 56 px hoch. -->
<nav class="schnell" aria-label={T.ui.schnellkontakt}>
  <a class="ruf" href={TELEFON_LINK}><Icon name="telefon" /><span>{T.ui.anrufen}</span></a>
  <a class="wa" href={WHATSAPP_LINK} rel="noopener" aria-label={T.ui.whatsappLabel}><Icon name="whatsapp" /><span>{T.ui.whatsapp}</span></a>
  <a href={mailLink(T.ui.mailBetreff)} aria-label={T.ui.mailSchreiben}><Icon name="mail" /><span>{T.ui.mailKurz}</span></a>
</nav>
<!-- „Nach oben“ (Can Talk 3964): erscheint nach ca. 1,5 Bildschirmhöhen Scrollen, rechts unten über der Kontaktleiste; am Handy nur beim Hochscrollen,
     damit er beim Lesen keinen Text verdeckt (Audit 09.11.2026, N1). Steuerung in sichtbar.js.
     Ohne JS unsichtbar (dann wäre er nur ein Sprung ohne Anzeige-Logik). -->
<a class="hoch" href="#" data-hoch aria-label={T.ui.nachOben} title={T.ui.nachOben}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 15l6-6 6 6" /></svg></a>
<style>
  .hoch {
    position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: calc(3.5rem + env(safe-area-inset-bottom) + 0.85rem); z-index: 41;
    display: none; place-items: center; width: 3rem; height: 3rem; border-radius: 50%;
    background: var(--primaer); color: var(--sekundaer); border: 1.5px solid rgba(239, 230, 214, 0.6); box-shadow: 0 10px 24px -12px rgba(10, 20, 40, 0.55);
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s var(--ease), visibility 0s linear 0.3s, background-color var(--dur-fast) ease;
  }
  :global(.js) .hoch { display: grid; }
  .hoch:global(.zeigen) { opacity: 1; visibility: visible; transform: none; transition: opacity 0.3s ease, transform 0.3s var(--ease), visibility 0s, background-color var(--dur-fast) ease; }
  .hoch:hover { background: var(--primaer-hell); }
  .hoch:focus-visible { outline: 2px solid var(--primaer); outline-offset: 3px; }
  .hoch svg { width: 1.4rem; height: 1.4rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (min-width: 66rem) { .hoch { bottom: 1.5rem; right: 1.5rem; width: 2.85rem; height: 2.85rem; opacity: 0; } .hoch:global(.zeigen) { opacity: 0.85; } .hoch:global(.zeigen):hover { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .hoch, .hoch:global(.zeigen) { transform: none; } }
  /* Fuß in Primär (Jamil 06.11.2026), helle Schrift */
  .fuss { background: var(--primaer); color: var(--auf-dunkel); --logo: var(--auf-dunkel); --logo-grund: var(--primaer); padding-block: clamp(3.5rem, 7vw, 5rem) 1.5rem; font-size: 0.98rem; }
  .fuss a { color: var(--auf-dunkel); text-decoration: none; }
  .fuss a:hover { color: var(--sekundaer); text-decoration: underline; text-underline-offset: 0.22em; }
  .raster { display: grid; gap: 2.5rem; }
  @media (min-width: 52rem) { .raster { grid-template-columns: 1.4fr 1fr 1fr; gap: 3rem; } }
  .wer :global(.logo) { width: 12rem; margin-bottom: 1.25rem; }
  .wer p { max-width: 24rem; line-height: 1.6; }
  .leise { color: var(--auf-dunkel-leise); }
  .klein { font: 600 0.95rem/1.4 var(--sans); letter-spacing: 0.02em; color: var(--sekundaer); margin-bottom: 0.9rem; }
  .liste { list-style: none; padding: 0; margin: 0; }
  .liste li { margin-bottom: 0.55rem; }
  @media (min-width: 30rem) { .spalten { columns: 2; column-gap: 2rem; } }
  .liste a, .liste span { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 1.75rem; overflow-wrap: anywhere; }
  .liste :global(svg) { width: 1.05rem; height: 1.05rem; color: var(--auf-dunkel-leise); flex: none; }
  .unten {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem;
    margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--linie-dunkel); color: var(--auf-dunkel-leise); font-size: 0.92rem;
  }
  .unten ul { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0; }
  .unten a { display: inline-block; padding-block: 0.25rem; }

  .schnell {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--creme); border-top: 1px solid var(--tinte-3); padding-bottom: env(safe-area-inset-bottom); box-shadow: 0 -8px 24px -16px rgba(29, 49, 90, 0.3);
  }
  .schnell a {
    display: flex; align-items: center; justify-content: center; gap: 0.45rem; min-height: 3.5rem; min-width: 0; padding-inline: 0.35rem;
    color: var(--hell); text-decoration: none; font-weight: 600; font-size: 0.95rem; white-space: nowrap;
  }
  .schnell .ruf { background: var(--akzent); color: var(--primaer); } /* Gold = Conversion, Primär-Schrift 5,0:1 */
  .schnell .ruf:hover { background: var(--akzent-hover); }
  /* WhatsApp in der Mitte: Primär-Schrift, leises Symbol, feine Trennlinien zu den Nachbarn */
  .schnell .wa { border-inline: 1px solid var(--tinte-3); }
  .schnell .wa :global(svg) { color: var(--primaer-leise); }
  .schnell a:not(.ruf):hover { background: var(--tinte-2); }
  .schnell :global(svg) { width: 1.2rem; height: 1.2rem; flex: none; }
  @media (max-width: 22rem) { .schnell a { font-size: 0.88rem; gap: 0.35rem; } }
  @media (min-width: 66rem) { .schnell { display: none; } }
  @media (max-width: 65.99rem) { :global(body) { padding-bottom: 3.5rem; } }
</style>
