---
// Logo als SVG nachgebaut (Federkiel + „TANRIKULU / TRANSLATIONS“).
// NACHBAU nach dem Screenshot der Jimdo-Seite – Original-Logo beim Kunden anfordern (OFFENE-INFOS.md).
// animiert: die Feder zeichnet sich einmal (Umriss, dann Fläche), der Schriftzug folgt. Nur auf der Startseite (Jamil, Talk 3889).
interface Props { klein?: boolean; animiert?: boolean }
const { klein = false, animiert = false } = Astro.props;
---
<svg class:list={["logo", { klein, animiert }]} viewBox="0 0 256 64" role="img" aria-label="Tanrikulu Translations" focusable="false">
  <g class="feder">
    <path class="fahne" pathLength="1" d="M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z" />
    <path class="schaft" d="M5 62 L 46 11" />
    <path class="kerbe" d="M37 38 L 30 37 M 44 26 L 38 26 M 49 15 L 44 16" />
  </g>
  <g class="wort">
    <text x="62" y="33" textLength="190" lengthAdjust="spacing" class="w1">TANRIKULU</text>
    <text x="63" y="54" textLength="188" lengthAdjust="spacing" class="w2">TRANSLATIONS</text>
  </g>
</svg>
<style>
  .logo { width: 13.5rem; height: auto; color: var(--tinte); overflow: visible; }
  .logo.klein { width: 11rem; }
  .fahne { fill: currentColor; stroke: currentColor; stroke-width: 1; }
  .schaft, .kerbe { fill: none; stroke: var(--elfenbein); stroke-width: 1.4; stroke-linecap: round; }
  text { fill: currentColor; font-family: var(--logo-schrift); font-weight: 600; }
  .w1 { font-size: 31px; }
  .w2 { font-size: 15.5px; }
  :global(.fuss) .logo { color: var(--elfenbein); }
  :global(.fuss) .schaft, :global(.fuss) .kerbe { stroke: var(--nacht); }

  @media (prefers-reduced-motion: no-preference) {
    .animiert .fahne { stroke-dasharray: 1; animation: umriss 1.1s var(--sanft) 0.1s both, fuellen 0.5s ease 0.95s both; }
    .animiert .schaft, .animiert .kerbe { animation: auf 0.4s ease 1.2s both; }
    .animiert .wort { animation: auf 0.7s ease 0.7s both; }
  }
  @keyframes umriss { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes fuellen { from { fill-opacity: 0; } to { fill-opacity: 1; } }
  @keyframes auf { from { opacity: 0; } to { opacity: 1; } }
</style>
