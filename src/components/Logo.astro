---
// Logo als SVG nachgebaut (Federkiel + „TANRIKULU / TRANSLATIONS“).
// NACHBAU nach dem Screenshot der Jimdo-Seite – Original-Logo beim Kunden anfordern (OFFENE-INFOS.md).
interface Props { klein?: boolean }
const { klein = false } = Astro.props;
---
<svg class:list={["logo", { klein }]} viewBox="0 0 256 64" role="img" aria-label="Tanrikulu Translations" focusable="false">
  <g class="feder">
    <path d="M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z" />
    <path class="schaft" d="M5 62 L 46 11" />
    <path class="kerbe" d="M37 38 L 30 37 M 44 26 L 38 26 M 49 15 L 44 16" />
  </g>
  <text x="62" y="33" textLength="190" lengthAdjust="spacing" class="w1">TANRIKULU</text>
  <text x="63" y="54" textLength="188" lengthAdjust="spacing" class="w2">TRANSLATIONS</text>
</svg>
<style>
  .logo { width: 13.5rem; height: auto; color: var(--tinte); overflow: visible; }
  .logo.klein { width: 11rem; }
  .feder path { fill: currentColor; }
  .feder .schaft, .feder .kerbe { fill: none; stroke: var(--papier); stroke-width: 1.4; stroke-linecap: round; }
  text { fill: currentColor; font-family: var(--serif); font-weight: 600; }
  .w1 { font-size: 31px; }
  .w2 { font-size: 15.5px; }
  :global(.dunkel) .logo { color: #fff; }
  :global(.dunkel) .feder .schaft, :global(.dunkel) .feder .kerbe { stroke: var(--tinte-tief); }
</style>
