---
// Szene „Übersetzung“ (höchstens 1,5 s): Original links, der Goldfaden trägt den Inhalt hinüber,
// die Übersetzung füllt sich Zeile für Zeile. Ablauf: 0–0,3 s Original, 0,2–0,6 s Faden, 0,35–1,14 s Übersetzung.
// Bewusst ohne Siegel, Stempel oder Schnur: nichts darstellen, was die bestehende Website nicht belegt (Jamil Talk 3904).
const zeilenL = [96, 120, 104, 128, 88, 116, 72];
const zeilenR = [100, 124, 108, 126, 92, 112, 64];
---
<figure class="szene-uebersetzung" data-szene>
  <svg viewBox="0 0 480 250" role="img" aria-labelledby="sb-titel" focusable="false">
    <title id="sb-titel">Übersetzung: Aus dem Original entsteht Zeile für Zeile die Übersetzung.</title>
    <g class="original">
      <rect class="blatt-linie" x="40" y="22" width="150" height="196" rx="3" />
      {zeilenL.map((w, i) => <rect class="zeile-hell" x="58" y={48 + i * 20} width={w} height="3" rx="1.5" />)}
      <text class="beschriftung" x="115" y="244" text-anchor="middle">Original</text>
    </g>
    <path class="faden strich" pathLength="1" d="M192 104C222 62 260 62 288 104" />
    <g class="uebersetzung">
      <rect class="blatt" x="290" y="22" width="150" height="196" rx="3" />
      <text class="beschriftung" x="365" y="244" text-anchor="middle">Übersetzung</text>
    </g>
    {zeilenR.map((w, i) => <rect class="zeile" x="308" y={48 + i * 20} width={w} height="3" rx="1.5" />)}
  </svg>
</figure>
<style>
  .szene-uebersetzung { margin: 0; }
  svg { width: 100%; height: auto; overflow: visible; }
  .blatt-linie { fill: none; stroke: var(--hell-leise); stroke-width: 1.4; }
  .zeile-hell { fill: var(--hell-leise); opacity: 0.55; }
  .blatt { fill: var(--weiss); stroke: var(--tinte-3); stroke-width: 1; }
  .zeile { fill: var(--tinte); opacity: 0.8; transform-box: fill-box; transform-origin: left; }
  .beschriftung { font: 500 15px var(--sans); letter-spacing: 0.04em; fill: var(--hell-leise); }
  .faden { fill: none; stroke: var(--gold); stroke-width: 1.8; stroke-linecap: round; }

  .original { animation: auftauchen 0.3s var(--sanft) both; }
  .faden { animation: zeichnen 0.4s ease-in-out 0.2s both; }
  .uebersetzung { animation: einblenden 0.2s ease 0.35s both; }
  .zeile { animation: breiten 0.22s var(--sanft) both; }
  .zeile:nth-of-type(1) { animation-delay: 0.5s; }
  .zeile:nth-of-type(2) { animation-delay: 0.57s; }
  .zeile:nth-of-type(3) { animation-delay: 0.64s; }
  .zeile:nth-of-type(4) { animation-delay: 0.71s; }
  .zeile:nth-of-type(5) { animation-delay: 0.78s; }
  .zeile:nth-of-type(6) { animation-delay: 0.85s; }
  .zeile:nth-of-type(7) { animation-delay: 0.92s; }
</style>
