---
// Einsatzgebiet als Skizzen-Karte im Rough-Stil wie bei Bauwelt (Can 31.10.2026 11:29). SVG kommt fertig aus dem Build
// (src/lib/karte.ts, rough.js nur beim Bauen). Einzige bewusste Ausnahme von Jamils „keine ungeraden Linien“ (Talk 3957).
// Bewegung wie Bauwelt: zeichnet sich EINMAL beim Sichtbarwerden Strich für Strich (≈ 1,6 s; data-szene + sichtbar.js),
// Schraffur und Beschriftung blenden mit ihrem Land ein, Hamburg (Standort) stempelt zuletzt. Reine CSS-Animation
// (iPhone-sicher). „Bewegung reduzieren“: sofort das fertige Bild.
// Ladezeit wie Bauwelt: Die Karte steht NICHT im HTML, sondern als eigene Datei (src/pages/karte/[datei].svg.ts);
// public/sichtbar.js setzt sie ca. 300 px vor dem Sichtbarwerden ein. Platzhalter hält die Höhe (kein Springen),
// ohne JS zeigt <noscript> die fertige Karte als Bild.
import { KARTE_MASSE } from "../lib/karte";
import { u } from "../daten";
import type { Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang; dunkel?: boolean }
const { lang, dunkel = false } = Astro.props;
const datei = u(`/karte/karte-${lang}-${dunkel ? "dunkel" : "hell"}.svg`);
---
<figure class:list={["rkarte", { "rkarte-dunkel": dunkel }]} role="img" aria-label={t(lang).gebiet.karte} data-szene>
  <div class="rkarte-platz" data-karte={datei}>
    <noscript><img class="rkarte-bild" src={datei} alt="" width={KARTE_MASSE.breite} height={KARTE_MASSE.hoehe} loading="lazy" /></noscript>
  </div>
</figure>
<style is:global>
  .rkarte {
    --k-linie: var(--primaer-leise); --k-schraffur: rgba(29, 49, 90, 0.2); --k-gold: var(--primaer); --k-punkt-rand: var(--weiss);
    --k-fluss: rgba(29, 49, 90, 0.13); --k-text: var(--tinte); --k-leise: var(--text-leise); --k-meer: var(--text-leise); --k-hof: var(--abschnitt-grund, var(--sand));
    margin: 0; width: 100%;
  }
  .rkarte-dunkel {
    --k-linie: #c3cbda; --k-schraffur: rgba(195, 203, 218, 0.26); --k-gold: #efe6d6; --k-punkt-rand: #fbf7f0;
    --k-fluss: rgba(243, 237, 228, 0.24); --k-text: #fbf7f0; --k-leise: #dde2ea; --k-meer: #c3cbda; --k-hof: var(--tinte);
  }
  .rk-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .rkarte-platz { aspect-ratio: 800 / 640; } /* = KARTE_MASSE (CSP: keine style-Attribute) */
  .rkarte-bild { display: block; width: 100%; height: auto; }
  .rk-s { stroke-dasharray: 1 1; }
  .rk-p { fill: var(--k-text); }
  /* Beschriftung mit Hof in Hintergrundfarbe, damit sie über Schraffur und Linien lesbar bleibt */
  .rk-x { stroke: var(--k-hof); stroke-width: 6px; paint-order: stroke; stroke-linejoin: round; }
  .rk-land { font: 600 28px var(--serif); fill: var(--k-text); letter-spacing: 0.01em; }
  .rk-stadt { font: 700 26px var(--sans); fill: var(--k-text); }
  .rk-gross { font-size: 28px; }
  .rk-klein { font: 600 20px var(--sans); fill: var(--k-leise); }
  .rk-meer { font: italic 500 21px var(--serif); fill: var(--k-meer); letter-spacing: 0.04em; }
  .rk-sitz { transform-box: fill-box; transform-origin: center; }
  /* einmal zeichnen, sobald im Bild (pausiert über data-szene bis „an“); Grundzustand = fertige Karte */
  .rk-s { animation: rk-zeichnen 0.6s ease-out both; }
  .rk-f, .rk-x, .rk-p { animation: einblenden 0.35s ease-out both; }
  .rk-sitz { animation: rk-stempel 0.4s ease-out both; }
  /* Startzeit (tN = N · 0,05 s) und Zeichendauer (dN) als Klassen – CSP ohne style-Attribute */
  .rkarte .t0 { animation-delay: 0.0s; } .rkarte .t1 { animation-delay: 0.05s; } .rkarte .t2 { animation-delay: 0.1s; } .rkarte .t3 { animation-delay: 0.15s; } .rkarte .t4 { animation-delay: 0.2s; } .rkarte .t5 { animation-delay: 0.25s; } .rkarte .t6 { animation-delay: 0.3s; } .rkarte .t7 { animation-delay: 0.35s; } .rkarte .t8 { animation-delay: 0.4s; } .rkarte .t9 { animation-delay: 0.45s; } .rkarte .t10 { animation-delay: 0.5s; } .rkarte .t11 { animation-delay: 0.55s; } .rkarte .t12 { animation-delay: 0.6s; } .rkarte .t13 { animation-delay: 0.65s; } .rkarte .t14 { animation-delay: 0.7s; } .rkarte .t15 { animation-delay: 0.75s; } .rkarte .t16 { animation-delay: 0.8s; } .rkarte .t17 { animation-delay: 0.85s; } .rkarte .t18 { animation-delay: 0.9s; } .rkarte .t19 { animation-delay: 0.95s; } .rkarte .t20 { animation-delay: 1.0s; } .rkarte .t21 { animation-delay: 1.05s; } .rkarte .t22 { animation-delay: 1.1s; } .rkarte .t23 { animation-delay: 1.15s; } .rkarte .t24 { animation-delay: 1.2s; } .rkarte .t25 { animation-delay: 1.25s; } .rkarte .t26 { animation-delay: 1.3s; } .rkarte .t27 { animation-delay: 1.35s; } .rkarte .t28 { animation-delay: 1.4s; } .rkarte .t29 { animation-delay: 1.45s; } .rkarte .t30 { animation-delay: 1.5s; } .rkarte .t31 { animation-delay: 1.55s; } .rkarte .t32 { animation-delay: 1.6s; } .rkarte .t33 { animation-delay: 1.65s; } .rkarte .t34 { animation-delay: 1.7s; } .rkarte .t35 { animation-delay: 1.75s; } .rkarte .t36 { animation-delay: 1.8s; } .rkarte .t37 { animation-delay: 1.85s; } .rkarte .t38 { animation-delay: 1.9s; } .rkarte .t39 { animation-delay: 1.95s; } .rkarte .t40 { animation-delay: 2.0s; }
  .rkarte .d1 { animation-duration: 0.05s; } .rkarte .d2 { animation-duration: 0.1s; } .rkarte .d3 { animation-duration: 0.15s; } .rkarte .d4 { animation-duration: 0.2s; } .rkarte .d5 { animation-duration: 0.25s; } .rkarte .d6 { animation-duration: 0.3s; } .rkarte .d7 { animation-duration: 0.35s; } .rkarte .d8 { animation-duration: 0.4s; } .rkarte .d9 { animation-duration: 0.45s; } .rkarte .d10 { animation-duration: 0.5s; } .rkarte .d11 { animation-duration: 0.55s; } .rkarte .d12 { animation-duration: 0.6s; } .rkarte .d13 { animation-duration: 0.65s; } .rkarte .d14 { animation-duration: 0.7s; } .rkarte .d15 { animation-duration: 0.75s; } .rkarte .d16 { animation-duration: 0.8s; } .rkarte .d17 { animation-duration: 0.85s; } .rkarte .d18 { animation-duration: 0.9s; } .rkarte .d19 { animation-duration: 0.95s; } .rkarte .d20 { animation-duration: 1.0s; }
  @keyframes rk-zeichnen { 0% { stroke-dashoffset: 1; opacity: 0; } 1% { opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 1; } }
  @keyframes rk-stempel { 0% { opacity: 0; transform: scale(0.5); } 60% { opacity: 1; transform: scale(1.12); } 100% { opacity: 1; transform: scale(1); } }
</style>
