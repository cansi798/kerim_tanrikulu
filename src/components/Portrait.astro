---
// Portrait von Kerim (Foto: Talk 3991, Wunsch Sprachnachricht 3992: „Helligkeit ein bisschen anpassen und dann rund ausschneiden,
// sodass man das Gesicht zentral sieht“). Bild ist quadratisch aufs Gesicht zugeschnitten und dezent aufgehellt (ffmpeg),
// rund per CSS (border-radius), feiner goldener Ring. AVIF + WebP in drei Größen, ohne EXIF/Metadaten.
// groesse = angezeigte Breite in CSS-Pixeln (für sizes und width/height → kein Layout-Springen).
// Ohne Foto (PORTRAIT null): in der Vorschau ein markierter Platzhalter, live nichts.
import { PORTRAIT, PORTRAIT_GROESSEN, VORSCHAU, NAME, u } from "../daten";
import type { Lang } from "../i18n";
import { t } from "../texte";
interface Props { lang: Lang; groesse?: number; laden?: "lazy" | "eager"; name?: boolean; klasse?: string }
const { lang, groesse = 272, laden = "lazy", name = true, klasse } = Astro.props;
const T = t(lang);
const zeigen = PORTRAIT || VORSCHAU;
const set = (typ: string) => PORTRAIT_GROESSEN.map((g) => `${u(`${PORTRAIT}-${g}.${typ}`)} ${g}w`).join(", ");
const sizes = `${groesse}px`;
const max = PORTRAIT_GROESSEN[PORTRAIT_GROESSEN.length - 1];
---
{zeigen && (
  <figure class:list={["portrait", klasse]}>
    {PORTRAIT ? (
      <picture>
        <source type="image/avif" srcset={set("avif")} sizes={sizes} />
        <source type="image/webp" srcset={set("webp")} sizes={sizes} />
        <img src={u(`${PORTRAIT}-${max}.webp`)} alt={T.ui.portraitAlt} width={groesse} height={groesse} loading={laden} decoding="async" />
      </picture>
    ) : (
      <div class="platz" role="img" aria-label={`${T.ui.platzhalter} ${T.ui.portraitFolgt}`}>
        <span class="hinweis">{T.ui.portraitFolgt}</span>
      </div>
    )}
    {name && <figcaption>{NAME}</figcaption>}
  </figure>
)}
<style>
  .portrait { margin: 0; display: flex; flex-direction: column; align-items: center; }
  picture, .platz { display: block; width: 100%; max-width: var(--portrait, 17rem); aspect-ratio: 1; border-radius: 50%; padding: 5px; border: 1.5px solid var(--deko); background: var(--weiss); }
  img { display: block; width: 100%; height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover; }
  .platz { display: grid; place-content: center; text-align: center; border: 2px dashed #9b2335; background: #fbf0f0; color: #5b1520; }
  .hinweis { font-weight: 600; font-size: 1rem; padding: 1rem; }
  figcaption { margin-top: 0.9rem; font: 500 1.15rem/1.3 var(--serif); color: var(--hell); text-align: center; }
</style>
