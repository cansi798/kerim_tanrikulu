---
// Kopf der Unterseiten: Titel, Einleitung und eine feine Messinglinie, die die Feder einmal zieht.
interface Props { titel: string }
const { titel } = Astro.props;
---
<header class="seitenkopf">
  <div class="huelle">
    <h1>{titel}</h1>
    <slot />
    <div class="strich" aria-hidden="true">
      <svg class="feder" viewBox="0 0 56 64" focusable="false"><path d="M5 62 C 9 45, 21 23, 53 2 C 51 17, 46 28, 37 38 C 30 46, 18 54, 5 62 Z" /><path class="schaft" d="M5 62 L 46 11" /></svg>
      <span class="linie"></span>
    </div>
  </div>
</header>
<style>
  .seitenkopf { padding-block: clamp(3rem, 8vw, 6rem) 0; }
  .seitenkopf h1 { max-width: 14em; }
  .seitenkopf :global(.lead) { max-width: 52ch; margin-bottom: 0; }
  .strich { display: flex; align-items: flex-end; gap: 0.25rem; margin-top: clamp(2rem, 5vw, 3.5rem); }
  .feder { width: 1.35rem; height: auto; flex: none; }
  .feder path { fill: var(--tinte); }
  .feder .schaft { fill: none; stroke: var(--elfenbein); stroke-width: 1.6; }
  .linie { flex: 1; height: 1px; background: var(--messing); transform-origin: left; margin-bottom: 1px; }
  @media (prefers-reduced-motion: no-preference) {
    .linie { animation: ziehen 1.4s var(--sanft) 0.2s both; }
    .feder { animation: auf 0.5s ease both; }
  }
  @keyframes ziehen { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes auf { from { opacity: 0; } to { opacity: 1; } }
</style>
