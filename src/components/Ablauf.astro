---
// Ablauf einer Anfrage (Jamils Konzept). Echte Reihenfolge, daher nummeriert.
// Die Schritte hängen an einer feinen Linie; jeder Schritt erscheint beim Scrollen (wo der Browser das ohne JS kann).
interface Props { schritte: { titel: string; text: string }[] }
const { schritte } = Astro.props;
---
<ol class="ablauf">
  {schritte.map((s) => <li class="einblenden"><h3>{s.titel}</h3><p>{s.text}</p></li>)}
</ol>
<style>
  .ablauf { list-style: none; padding: 0; margin: 0 0 2rem; counter-reset: schritt; display: grid; gap: 2rem; position: relative; }
  .ablauf::before { content: ""; position: absolute; left: 1.5rem; top: 1.5rem; bottom: 1.5rem; width: 1px; background: var(--messing); }
  .ablauf li { counter-increment: schritt; position: relative; padding-left: 4.5rem; }
  .ablauf li::before {
    content: counter(schritt); position: absolute; left: 0; top: 0;
    width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--elfenbein); border: 1px solid var(--messing); color: var(--tinte);
    font: 400 1.4rem/1 var(--caslon);
  }
  .ablauf h3 { margin: 0.45rem 0 0.35rem; }
  .ablauf p { margin: 0; }
  @media (min-width: 56rem) {
    .ablauf { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
    .ablauf::before { left: 1.5rem; right: calc((100% - 5rem) / 3 - 1.5rem); top: 1.5rem; bottom: auto; width: auto; height: 1px; }
    .ablauf li { padding-left: 0; padding-top: 4.5rem; }
  }
</style>
