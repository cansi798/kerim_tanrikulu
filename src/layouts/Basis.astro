---
// Schriften selbst gehostet (fontsource, variabel): Source Serif 4 (Überschriften) und Open Sans (Text), Jamil Talk 3910.
// v4: zweisprachig (Deutsch/Türkisch). lang-Attribut, hreflang-Links, og:locale, Entwurfs-Hinweis auf türkischen Seiten.
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/open-sans/wght.css";
import serifUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansUrl from "@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url";
import serifExtUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-ext-wght-normal.woff2?url";
import sansExtUrl from "@fontsource-variable/open-sans/files/open-sans-latin-ext-wght-normal.woff2?url";
import "../styles/global.css";
import Kopf from "../components/Kopf.astro";
import Fuss from "../components/Fuss.astro";
import Aufruf from "../components/Aufruf.astro";
import { VORSCHAU, NAME, MARKE, MAIL, TELEFON, TELEFON_BESTAETIGT, ORT, GERICHT, u } from "../daten";
import { SEITEN, TR_GEPRUEFT, type Lang, type Seite } from "../i18n";
import { t } from "../texte";

interface Props {
  lang: Lang;
  /** Seite für hreflang und Sprachwechsel; null = nur eine Fassung (404) */
  seite: Seite | null;
  titel?: string;
  beschreibung?: string;
  schema?: Record<string, unknown>[];
  /** Abschluss-Aufruf (aus auf Kontakt, Impressum, Datenschutz) */
  aufruf?: boolean;
}
const { lang, seite, titel, beschreibung, schema = [], aufruf = true } = Astro.props;
const T = t(lang);
const voll = titel ? `${titel} | ${NAME}` : T.meta.titelStart;
const text = beschreibung ?? T.meta.beschreibung;
const kanon = new URL(Astro.url.pathname, Astro.site);
const start = new URL(u("/"), Astro.site).href;
const abs = (pfad: string) => new URL(u(pfad), Astro.site).href;
const alternativen = seite ? (["de", "tr"] as Lang[]).map((l) => ({ l, href: abs(SEITEN[seite][l]) })) : [];
const zeigeTrHinweis = lang === "tr" && !TR_GEPRUEFT;

// Strukturierte Daten: nur belegte Angaben. Telefon erst nach Bestätigung.
const person: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${start}#person`,
  name: NAME,
  url: start,
  jobTitle: lang === "tr" ? ["Genel yeminli tercüman", "Yetkili mütercim"] : ["Allgemein beeidigter Dolmetscher", "Ermächtigter Übersetzer"],
  knowsLanguage: ["de", "tr"],
  email: `mailto:${MAIL}`,
  address: { "@type": "PostalAddress", addressLocality: ORT, addressCountry: "DE" },
  hasCredential: [
    { "@type": "EducationalOccupationalCredential", name: "Allgemeine Beeidigung als Dolmetscher (Türkisch)", recognizedBy: { "@type": "GovernmentOrganization", name: GERICHT }, dateCreated: "2021-05" },
    { "@type": "EducationalOccupationalCredential", name: "Ermächtigung als Übersetzer (Türkisch)", recognizedBy: { "@type": "GovernmentOrganization", name: GERICHT }, dateCreated: "2021-05" },
  ],
  contactPoint: { "@type": "ContactPoint", contactType: "customer service", email: MAIL, availableLanguage: ["de", "tr"] },
};
if (TELEFON_BESTAETIGT) person.telephone = TELEFON;
const jsonLd = [
  person,
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${start}#website`, url: start, name: MARKE, inLanguage: ["de", "tr"], publisher: { "@id": `${start}#person` } },
  { "@context": "https://schema.org", "@type": "WebPage", url: kanon.href, name: voll, inLanguage: lang, isPartOf: { "@id": `${start}#website` } },
  ...schema,
];
// „<“ maskieren, damit kein Text das Skript-Element beenden kann
const ld = (o: unknown) => JSON.stringify(o).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'; object-src 'none'" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <!-- latin-ext (ş, ğ, ı …) auch auf deutschen Seiten vorladen: türkische Begriffe stehen überall, ein spätes Nachladen setzte die ganze Seite zweimal neu (Messung v4) -->
    <link rel="preload" href={sansExtUrl} as="font" type="font/woff2" crossorigin />
    {lang === "tr" && <link rel="preload" href={serifExtUrl} as="font" type="font/woff2" crossorigin />}
    <script is:inline src={u("/sichtbar.js")}></script>
    <!-- Licht-Szenen (Sprachbrücke, Dolmetschen; Can 31.10.2026) nur, wo sie vorkommen; defer = blockiert das Laden nicht -->
    {(seite === "start" || seite === "dolmetschen") && <script is:inline defer src={u("/licht.js")}></script>}
    <title>{voll}</title>
    <meta name="description" content={text} />
    {VORSCHAU && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={kanon} />
    {alternativen.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    {seite && <link rel="alternate" hreflang="x-default" href={abs(SEITEN[seite].de)} />}
    <meta name="theme-color" content="#ebe0cf" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={u("/favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={u("/apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={T.ogLocale} />
    <meta property="og:locale:alternate" content={lang === "de" ? "tr_TR" : "de_DE"} />
    <meta property="og:site_name" content={MARKE} />
    <meta property="og:title" content={voll} />
    <meta property="og:description" content={text} />
    <meta property="og:url" content={kanon} />
    <meta property="og:image" content={new URL(u("/og.png"), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <link rel="sitemap" href={u("/sitemap.xml")} />
    {jsonLd.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
  </head>
  <body>
    <a class="skip" href="#inhalt">{T.ui.skip}</a>
    {VORSCHAU && (
      <div class="vorschau" role="note">
        <div class="huelle">
          <strong>{T.ui.vorschauKurz}</strong> {T.ui.vorschau.replace(T.ui.vorschauKurz, "").trim()}
        </div>
      </div>
    )}
    {zeigeTrHinweis && (
      <div class="vorschau tr-hinweis" role="note">
        <div class="huelle"><strong lang="de">{T.ui.trEntwurf.split(" (")[0]}</strong> ({T.ui.trEntwurf.split(" (")[1]}</div>
      </div>
    )}
    <Kopf lang={lang} seite={seite} />
    <main id="inhalt">
      <slot />
      {aufruf && <Aufruf lang={lang} />}
    </main>
    <Fuss lang={lang} />
  </body>
</html>
<style>
  .vorschau { background: #fbf0f0; color: #5b1520; border-bottom: 2px dashed #9b2335; font-size: 0.9rem; line-height: 1.5; padding-block: 0.5rem; }
  .vorschau strong { color: #9b2335; font-weight: 600; }
  .tr-hinweis { background: #fff6e6; border-bottom-color: #8a5a00; }
  .tr-hinweis strong { color: #6b4500; }
</style>
